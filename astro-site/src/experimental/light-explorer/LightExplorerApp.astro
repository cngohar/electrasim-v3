---
import { LIGHT_ERAS } from './data/eras';
import { EDISON_1879_COMPONENTS } from './data/lampComponents';
import { MANUFACTURING_STEPS } from './data/manufacturingSteps';
import { HISTORICAL_DOCUMENTS } from './data/historicalNotes';
import { LIGHT_EXPLORER_SOURCES } from './data/sources';

interface Props {
  initialView?: 'gateway' | 'laboratory';
  initialEraId?: string;
}

const { initialView = 'gateway', initialEraId = 'edison-1879' } = Astro.props;
---

<div class="light-explorer-root light-theme" id="light-explorer-root" data-initial-view={initialView} data-initial-era={initialEraId}>
  <!-- Top Minimal Floating Header -->
  <header class="lex-top-bar" role="banner">
    <div class="lex-bar-left">
      <a href="/" class="lex-brand" title="ElectraSim Home">
        <span class="brand-bolt">⚡</span>
        <span class="brand-text">Electra<span class="brand-accent">Sim</span></span>
      </a>
      <span class="lex-badge">EXPERIMENTAL #001</span>
      <div class="lex-divider"></div>
      <div class="lex-title-group">
        <span class="lex-title">LIGHT EXPLORER</span>
        <span class="lex-subtitle">1879 · Menlo Park Historical Laboratory</span>
      </div>
    </div>

    <div class="lex-bar-center" id="lex-bar-center">
      <!-- Mode pill bar (Visible in Laboratory view) -->
      <nav class="lex-mode-nav" id="lex-mode-nav" aria-label="3D Exploration Modes" hidden>
        <button type="button" class="lex-mode-btn active" data-mode="assembly" title="Complete 3D Assembly (Key: 1)">
          <span>1. Assembly</span>
        </button>
        <button type="button" class="lex-mode-btn" data-mode="cutaway" title="Glass Envelope Section (Key: 2)">
          <span>2. Cutaway</span>
        </button>
        <button type="button" class="lex-mode-btn" data-mode="exploded" title="Disassemble Assembly (Key: 3)">
          <span>3. Disassemble</span>
        </button>
        <button type="button" class="lex-mode-btn" data-mode="xray" title="Internal Electrical Continuity (Key: 4)">
          <span>4. X-Ray View</span>
        </button>
        <button type="button" class="lex-mode-btn" data-mode="manufacturing" title="Historical 8-Step Construction (Key: 5)">
          <span>5. How Built</span>
        </button>
        <button type="button" class="lex-mode-btn" data-mode="vacuum" title="Sprengel Vacuum Tip Evacuation (Key: 6)">
          <span>6. Vacuum</span>
        </button>
        <button type="button" class="lex-mode-btn" data-mode="experiment" title="110V Physics Laboratory (Key: 7)">
          <span>7. Experiment</span>
        </button>
      </nav>
    </div>

    <div class="lex-bar-right">
      <button type="button" id="btn-toggle-ui" class="lex-icon-btn" title="Clean View / Screenshot Mode (Hotkey: H)" aria-label="Toggle UI Overlay">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <span class="btn-label hide-sm">Clean View</span>
      </button>

      <button type="button" id="btn-open-documents" class="lex-icon-btn" title="Archival Notebooks & Records" aria-label="Open Historical Documents">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
          <path d="M6 6h10M6 10h10M6 14h6"/>
        </svg>
        <span class="btn-label hide-sm">Notebook</span>
      </button>

      <button type="button" id="btn-open-sources" class="lex-icon-btn" title="Authoritative Historical Sources" aria-label="Open Sources Registry">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 16v-4M12 8h.01"/>
        </svg>
        <span class="btn-label hide-sm">Sources</span>
      </button>

      <a href="/" class="lex-back-home hide-xs" title="Return to ElectraSim">
        <span>Exit Lab</span>
        <span>✕</span>
      </a>
    </div>
  </header>

  <!-- =========================================================================
       LAYER 1: FULLSCREEN HISTORICAL TIMELINE GATEWAY
       ========================================================================= -->
  <section class="lex-timeline-gateway" id="lex-timeline-gateway" role="region" aria-label="Historical Lighting Timeline">
    <div class="gateway-background-pulse"></div>

    <div class="gateway-header-wrap">
      <div class="gateway-tag">ELECTRASIM HISTORICAL EXPERIMENTS</div>
      <h2 class="gateway-headline">The Evolution of Electric Light in 3D</h2>
      <p class="gateway-subline">Select an era to explore its groundbreaking lighting breakthrough. Edison’s 1879 demonstration lamp is the first fully unlocked 3D laboratory.</p>
    </div>

    <!-- Interactive Visual Timeline Carousel / Rail -->
    <div class="timeline-visual-stage">
      <div class="timeline-nav-arrow left" id="timeline-prev-btn" title="Previous Era (Left Arrow)">‹</div>

      <div class="timeline-cards-track" id="timeline-cards-track">
        {LIGHT_ERAS.map((era, index) => (
          <div
            class={`era-card ${index === 0 ? 'active' : ''} ${era.status}`}
            data-era-id={era.id}
            data-era-index={index}
            tabindex="0"
            role="button"
            aria-label={`${era.title} (${era.period}) — ${era.statusLabel}`}
          >
            <div class="era-card-image-wrap">
              <img
                src={era.visualAsset}
                alt={`${era.title} historical preview`}
                class="era-card-img"
                loading={index < 2 ? 'eager' : 'lazy'}
                width="340"
                height="340"
              />
              <div class={`era-status-badge ${era.status}`}>
                {era.statusLabel}
              </div>
            </div>

            <div class="era-card-content">
              <div class="era-period">{era.period}</div>
              <h3 class="era-title">{era.title}</h3>
              <div class="era-bulb-type">{era.bulbType}</div>
              <p class="era-summary">{era.historicalSummary}</p>

              {era.status === 'available' ? (
                <button type="button" class="btn-enter-laboratory" data-launch-era={era.id}>
                  <span>Enter 1879 3D Laboratory</span>
                  <span class="arrow">→</span>
                </button>
              ) : (
                <div class="era-locked-hint">
                  <span>🔒 {era.statusLabel === 'COMING SOON' ? 'In Active Development' : 'Scheduled on Master Roadmap'}</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="timeline-nav-arrow right" id="timeline-next-btn" title="Next Era (Right Arrow)">›</div>
    </div>

    <!-- Timeline Chronological Electrical Rail -->
    <div class="timeline-rail-wrap">
      <div class="timeline-rail-bar">
        <div class="timeline-rail-pulse" id="timeline-rail-pulse"></div>
        {LIGHT_ERAS.map((era, index) => (
          <button
            type="button"
            class={`timeline-node ${index === 0 ? 'active' : ''}`}
            data-era-id={era.id}
            data-era-index={index}
            title={`${era.period}: ${era.title}`}
          >
            <span class="node-dot"></span>
            <span class="node-year">{era.period}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       LAYER 2: FULLSCREEN 1879 EDISON 3D LABORATORY
       ========================================================================= -->
  <section class="lex-laboratory-stage" id="lex-laboratory-stage" role="region" aria-label="1879 Edison 3D Laboratory" hidden>
    <!-- Three.js Canvas Container -->
    <div class="lex-canvas-viewport" id="lex-canvas-viewport">
      <canvas id="lex-3d-canvas" class="lex-3d-canvas"></canvas>

      <!-- Return to Timeline Gateway Button -->
      <button type="button" id="btn-return-timeline" class="lex-return-gateway-btn" title="Return to Historical Timeline Gateway">
        <span>← Timeline Gateway</span>
      </button>

      <!-- Power & Camera Quick Bar -->
      <div class="lex-canvas-actions-bar">
        <button type="button" id="btn-toggle-power" class="lex-power-toggle-btn active" title="Toggle Circuit Power (Spacebar)">
          <span class="power-dot"></span>
          <span class="power-label">Power: <strong id="lex-power-status-text">110V ON</strong></span>
        </button>

        <button type="button" id="btn-reset-camera" class="lex-cam-btn" title="Reset 3D Camera (Hotkey: R)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          <span>Reset View</span>
        </button>
      </div>

      <!-- Canvas Gesture Hint -->
      <div class="lex-canvas-hint" id="lex-canvas-hint">
        <span>🖱 Left-drag: Rotate · Scroll: Zoom · Click part: Inspect · Space: Power</span>
      </div>

      <!-- Floating Component Inspector HUD -->
      <aside class="lex-component-hud" id="lex-component-hud" hidden>
        <div class="hud-header">
          <div class="hud-tag">COMPONENT INSPECTOR</div>
          <button type="button" id="hud-close-btn" class="hud-close" aria-label="Close component inspector">✕</button>
        </div>
        <h4 class="hud-title" id="hud-part-name">Glass Envelope</h4>
        <div class="hud-meta">
          <span class="hud-material" id="hud-part-mat">Blown Soda-Lime Glass</span>
          <span class="hud-specs" id="hud-part-specs">~6.3 cm diameter</span>
        </div>
        <p class="hud-desc" id="hud-part-desc">Pear-shaped vacuum envelope preventing carbon combustion.</p>
        <div class="hud-historical-note" id="hud-part-note">
          <strong>Historical Note:</strong> Evacuated on Sprengel mercury pump to less than 10⁻⁶ atm.
        </div>
        <div class="hud-actions">
          <button type="button" id="btn-isolate-part" class="btn-hud-action">Isolate Component</button>
          <button type="button" id="btn-show-all-parts" class="btn-hud-action secondary" hidden>Show All</button>
        </div>
      </aside>

      <!-- Manufacturing Step Controller (Mode 5) -->
      <div class="lex-manufacturing-panel" id="lex-manufacturing-panel" hidden>
        <div class="mfg-head">
          <span class="mfg-step-num" id="mfg-step-label">STEP 01 OF 08</span>
          <span class="mfg-action-tag" id="mfg-action-tag">JOIN CONDUCTORS</span>
        </div>
        <h4 class="mfg-title" id="mfg-title">Platinum-Copper Lead Assembly</h4>
        <p class="mfg-desc" id="mfg-desc">Platinum wire welded to copper leads to match glass thermal expansion.</p>
        <div class="mfg-controls">
          <button type="button" id="btn-mfg-prev" class="btn-mfg-nav">‹ Previous Step</button>
          <button type="button" id="btn-mfg-next" class="btn-mfg-nav primary">Next Step ›</button>
        </div>
      </div>

      <!-- Physics Experiment Controls & Readouts (Mode 7) -->
      <div class="lex-experiment-panel" id="lex-experiment-panel" hidden>
        <div class="exp-header">
          <span class="exp-badge">110V DC PHYSICS LAB</span>
          <span class="exp-model-note">Deterministic Model: 113 Ω Cold → 140 Ω Hot</span>
        </div>

        <div class="exp-slider-block">
          <div class="slider-meta">
            <label for="lex-volts-range">Applied Voltage:</label>
            <span class="slider-value" id="exp-volts-display">110 V</span>
          </div>
          <input type="range" id="lex-volts-range" min="0" max="130" step="1" value="110" class="lex-slider" />
          <div class="slider-marks">
            <span>0V (OFF)</span>
            <span>110V (Nominal)</span>
            <span>125V+ (Burnout Limit)</span>
          </div>
        </div>

        <div class="exp-readouts-grid">
          <div class="readout-box">
            <span class="ro-label">Resistance (Ω)</span>
            <span class="ro-val" id="ro-resistance">140.0 Ω</span>
          </div>
          <div class="readout-box">
            <span class="ro-label">Current (A)</span>
            <span class="ro-val" id="ro-current">0.786 A</span>
          </div>
          <div class="readout-box">
            <span class="ro-label">Power (W)</span>
            <span class="ro-val" id="ro-power">86.4 W</span>
          </div>
          <div class="readout-box">
            <span class="ro-label">Filament Temp</span>
            <span class="ro-val" id="ro-temp">2100 K</span>
          </div>
          <div class="readout-box">
            <span class="ro-label">Luminous Output</span>
            <span class="ro-val" id="ro-lumens">16 cd (~180 lm)</span>
          </div>
          <div class="readout-box full">
            <span class="ro-label">System State</span>
            <span class="ro-val status" id="ro-status">Optimal Incandescence</span>
          </div>
        </div>

        <div class="exp-actions-row" id="exp-failure-row" hidden>
          <button type="button" id="btn-reset-exp" class="btn-exp-reset">Reset Experiment & Replace Filament</button>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       MODALS: ARCHIVAL NOTEBOOK & HISTORICAL SOURCES
       ========================================================================= -->
  <div class="lex-modal-backdrop" id="lex-documents-modal" hidden>
    <div class="lex-modal-dialog" role="dialog" aria-labelledby="modal-docs-title">
      <div class="modal-header">
        <h3 id="modal-docs-title">Menlo Park Archival Notebooks & Records</h3>
        <button type="button" class="modal-close-btn" data-close-modal="lex-documents-modal" aria-label="Close modal">✕</button>
      </div>
      <div class="modal-body">
        <div class="doc-tabs">
          <button type="button" class="doc-tab-btn active" data-doc="oct-22-1879-notebook">October 22, 1879 Experiment</button>
          <button type="button" class="doc-tab-btn" data-doc="dec-31-1879-demonstration">December 31, 1879 Demonstration</button>
        </div>

        <div class="doc-content" id="doc-active-content">
          <div class="doc-date-badge">{HISTORICAL_DOCUMENTS['oct-22-1879-notebook'].date}</div>
          <h4>{HISTORICAL_DOCUMENTS['oct-22-1879-notebook'].title}</h4>
          <p class="doc-transcription">{HISTORICAL_DOCUMENTS['oct-22-1879-notebook'].transcription}</p>
          <div class="doc-context">
            <strong>Historical Analysis:</strong> {HISTORICAL_DOCUMENTS['oct-22-1879-notebook'].historicalContext}
          </div>
          <div class="doc-data-table">
            {Object.entries(HISTORICAL_DOCUMENTS['oct-22-1879-notebook'].documentedData).map(([key, val]) => (
              <div class="data-row">
                <span class="data-k">{key}:</span>
                <span class="data-v">{val}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="lex-modal-backdrop" id="lex-sources-modal" hidden>
    <div class="lex-modal-dialog" role="dialog" aria-labelledby="modal-sources-title">
      <div class="modal-header">
        <h3 id="modal-sources-title">Authoritative Historical Source Registry</h3>
        <button type="button" class="modal-close-btn" data-close-modal="lex-sources-modal" aria-label="Close modal">✕</button>
      </div>
      <div class="modal-body">
        <p class="sources-intro">Every 3D component, manufacturing step, date, and electrical calculation in Light Explorer is traceable to primary archival records and authoritative institutional collections:</p>
        <div class="sources-list">
          {Object.values(LIGHT_EXPLORER_SOURCES).map((src) => (
            <div class="source-card">
              <div class="source-org">{src.organization}</div>
              <h4 class="source-title">
                <a href={src.url} target="_blank" rel="noopener noreferrer" class="source-link">
                  {src.title} ↗
                </a>
              </h4>
              {src.objectNumber && <div class="source-obj-num">Object ID: {src.objectNumber}</div>}
              <p class="source-notes">{src.notes}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       SEMANTIC CRAWLABLE HTML LAYER (Accessible & Search Engine Discoverable)
       ========================================================================= -->
  <div class="lex-semantic-seo-layer" aria-label="Complete Historical Document Content">
    <header>
      <h1>Edison Light Explorer — The 1879 Incandescent Lamp 3D Experience</h1>
      <p>
        Explore an authentic 3D historical reconstruction of Thomas Edison’s 1879 carbon-filament demonstration lamp based on primary Smithsonian Institution collections and Menlo Park laboratory notebooks.
      </p>
    </header>

    <section aria-labelledby="seo-history-head">
      <h2 id="seo-history-head">Historical Foundation: Menlo Park Breakthrough (1879)</h2>
      <p>
        On October 22, 1879, Thomas Edison and his laboratory assistants Charles Batchelor and Francis Upton tested a carbonized cotton thread filament in a high vacuum bulb evacuated by a Sprengel mercury fall pump. The filament operated with a cold resistance of 113 ohms and rose to approximately 140 ohms hot resistance, producing continuous incandescence without burning out.
      </p>
      <p>
        On December 31, 1879, Edison held the first public demonstration at Menlo Park, New Jersey, illuminating seventy demonstration lamps across the laboratory grounds. The Smithsonian Institution preserves one of these documented demonstration lamps (Object NMAH_704361).
      </p>
    </section>

    <section aria-labelledby="seo-components-head">
      <h2 id="seo-components-head">Anatomy of the 1879 Edison Demonstration Lamp</h2>
      <ul>
        {Object.values(EDISON_1879_COMPONENTS).map((comp) => (
          <li>
            <strong>{comp.name}:</strong> {comp.description} <em>({comp.physicalSpecs})</em>. Role: {comp.historicalRole}.
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="seo-mfg-head">
      <h2 id="seo-mfg-head">8-Step Historical Manufacturing Sequence</h2>
      <ol>
        {MANUFACTURING_STEPS.map((step) => (
          <li>
            <strong>{step.title}:</strong> {step.historicalProcess}
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="seo-eras-head">
      <h2 id="seo-eras-head">The Historical Timeline of Electric Lighting</h2>
      <ul>
        {LIGHT_ERAS.map((era) => (
          <li>
            <strong>{era.period} — {era.title} ({era.statusLabel}):</strong> {era.historicalSummary}
          </li>
        ))}
      </ul>
    </section>
  </div>
</div>

<script>
  import { Edison1879LampScene, type LampViewMode, type ElectricalState } from './scene/Edison1879Lamp3D';
  import { TimelineGatewayManager } from './scene/TimelineGateway3D';
  import { EDISON_1879_COMPONENTS } from './data/lampComponents';
  import { MANUFACTURING_STEPS } from './data/manufacturingSteps';
  import { HISTORICAL_DOCUMENTS } from './data/historicalNotes';
  import { LIGHT_ERAS } from './data/eras';

  function initLightExplorerApp() {
    const root = document.getElementById('light-explorer-root');
    if (!root) return;

    const gatewayStage = document.getElementById('lex-timeline-gateway');
    const labStage = document.getElementById('lex-laboratory-stage');
    const canvas = document.getElementById('lex-3d-canvas') as HTMLCanvasElement | null;
    const canvasViewport = document.getElementById('lex-canvas-viewport');
    const modeNav = document.getElementById('lex-mode-nav');

    // Modals
    const docsModal = document.getElementById('lex-documents-modal');
    const sourcesModal = document.getElementById('lex-sources-modal');

    // UI Buttons
    const toggleUiBtn = document.getElementById('btn-toggle-ui');
    const openDocsBtn = document.getElementById('btn-open-documents');
    const openSourcesBtn = document.getElementById('btn-open-sources');
    const returnTimelineBtn = document.getElementById('btn-return-timeline');
    const togglePowerBtn = document.getElementById('btn-toggle-power');
    const resetCamBtn = document.getElementById('btn-reset-camera');

    // HUD / Panels
    const componentHud = document.getElementById('lex-component-hud');
    const hudCloseBtn = document.getElementById('hud-close-btn');
    const isolateBtn = document.getElementById('btn-isolate-part');
    const showAllBtn = document.getElementById('btn-show-all-parts');
    const mfgPanel = document.getElementById('lex-manufacturing-panel');
    const expPanel = document.getElementById('lex-experiment-panel');
    const voltsSlider = document.getElementById('lex-volts-range') as HTMLInputElement | null;
    const resetExpBtn = document.getElementById('btn-reset-exp');

    let lampScene: Edison1879LampScene | null = null;
    let gatewayMgr: TimelineGatewayManager | null = null;
    let isUiHidden = false;
    let selectedPartId: string | null = null;

    // Initialize Timeline Gateway
    if (gatewayStage) {
      gatewayMgr = new TimelineGatewayManager(gatewayStage, {
        onSelectEra: (era) => {
          updateTimelineActiveEra(era.id);
        },
        onEnterLaboratory: (eraId) => {
          transitionToLaboratory(eraId);
        },
      });

      // Era card clicks
      const eraCards = document.querySelectorAll('.era-card');
      eraCards.forEach((card) => {
        card.addEventListener('click', () => {
          const eraId = card.getAttribute('data-era-id');
          if (eraId && gatewayMgr) {
            gatewayMgr.selectEraById(eraId);
          }
        });
      });

      // Launch buttons
      const launchBtns = document.querySelectorAll('[data-launch-era]');
      launchBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const eraId = btn.getAttribute('data-launch-era');
          if (eraId) {
            transitionToLaboratory(eraId);
          }
        });
      });

      // Rail nodes
      const railNodes = document.querySelectorAll('.timeline-node');
      railNodes.forEach((node) => {
        node.addEventListener('click', () => {
          const eraId = node.getAttribute('data-era-id');
          if (eraId && gatewayMgr) {
            gatewayMgr.selectEraById(eraId);
          }
        });
      });

      // Arrows
      document.getElementById('timeline-prev-btn')?.addEventListener('click', () => gatewayMgr?.prevEra());
      document.getElementById('timeline-next-btn')?.addEventListener('click', () => gatewayMgr?.nextEra());
    }

    function updateTimelineActiveEra(eraId: string) {
      document.querySelectorAll('.era-card').forEach((card) => {
        card.classList.toggle('active', card.getAttribute('data-era-id') === eraId);
      });
      document.querySelectorAll('.timeline-node').forEach((node) => {
        node.classList.toggle('active', node.getAttribute('data-era-id') === eraId);
      });
    }

    function transitionToLaboratory(eraId: string) {
      if (gatewayStage) gatewayStage.hidden = true;
      if (labStage) labStage.hidden = false;
      if (modeNav) modeNav.hidden = false;

      if (!lampScene && canvas && canvasViewport) {
        init3DScene();
      } else if (lampScene) {
        lampScene.handleResize();
      }
    }

    function transitionToGateway() {
      if (labStage) labStage.hidden = true;
      if (gatewayStage) gatewayStage.hidden = false;
      if (modeNav) modeNav.hidden = true;
      if (componentHud) componentHud.hidden = true;
    }

    function init3DScene() {
      if (!canvas || !canvasViewport) return;

      lampScene = new Edison1879LampScene(canvasViewport, canvas, {
        onSelectComponent: (compKey) => {
          selectedPartId = compKey;
          if (compKey && EDISON_1879_COMPONENTS[compKey]) {
            const data = EDISON_1879_COMPONENTS[compKey];
            const nameEl = document.getElementById('hud-part-name');
            const matEl = document.getElementById('hud-part-mat');
            const specsEl = document.getElementById('hud-part-specs');
            const descEl = document.getElementById('hud-part-desc');
            const noteEl = document.getElementById('hud-part-note');

            if (nameEl) nameEl.textContent = data.name;
            if (matEl) matEl.textContent = data.material;
            if (specsEl) specsEl.textContent = data.physicalSpecs;
            if (descEl) descEl.textContent = data.description;
            if (noteEl) noteEl.innerHTML = `<strong>Historical Note:</strong> ${data.historicalNote}`;

            if (componentHud) componentHud.hidden = isUiHidden;
            if (isolateBtn) isolateBtn.hidden = false;
            if (showAllBtn) showAllBtn.hidden = true;
          } else {
            if (componentHud) componentHud.hidden = true;
          }
        },
        onElectricalUpdate: (state) => {
          updateElectricalReadouts(state);
        },
        onManufacturingStepChange: (step) => {
          updateManufacturingUI(step);
        },
      });

      setupLaboratoryControls();
    }

    function setupLaboratoryControls() {
      if (!lampScene) return;

      // Mode navigation
      const modeButtons = document.querySelectorAll('.lex-mode-btn');
      modeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-mode') as LampViewMode;
          if (!mode || !lampScene) return;

          modeButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          lampScene.setMode(mode);

          // Update panel visibility
          if (mfgPanel) mfgPanel.hidden = mode !== 'manufacturing' || isUiHidden;
          if (expPanel) expPanel.hidden = mode !== 'experiment' || isUiHidden;
        });
      });

      // Power toggle
      togglePowerBtn?.addEventListener('click', () => {
        lampScene?.togglePower();
      });

      // Reset camera
      resetCamBtn?.addEventListener('click', () => {
        lampScene?.resetCamera();
      });

      // Return to Gateway
      returnTimelineBtn?.addEventListener('click', () => {
        transitionToGateway();
      });

      // Isolate button
      isolateBtn?.addEventListener('click', () => {
        if (selectedPartId && lampScene) {
          lampScene.isolateComponent(selectedPartId);
          if (isolateBtn) isolateBtn.hidden = true;
          if (showAllBtn) showAllBtn.hidden = false;
        }
      });

      showAllBtn?.addEventListener('click', () => {
        if (lampScene) {
          lampScene.isolateComponent(null);
          if (isolateBtn) isolateBtn.hidden = false;
          if (showAllBtn) showAllBtn.hidden = true;
        }
      });

      hudCloseBtn?.addEventListener('click', () => {
        if (componentHud) componentHud.hidden = true;
        lampScene?.selectComponent(null);
      });

      // Voltage Slider
      voltsSlider?.addEventListener('input', (e) => {
        const val = Number((e.target as HTMLInputElement).value);
        const display = document.getElementById('exp-volts-display');
        if (display) display.textContent = `${val} V`;
        lampScene?.setVoltage(val);
      });

      // Failure Reset
      resetExpBtn?.addEventListener('click', () => {
        lampScene?.resetExperiment();
        if (voltsSlider) voltsSlider.value = '110';
        const display = document.getElementById('exp-volts-display');
        if (display) display.textContent = '110 V';
      });

      // Manufacturing Stepper
      let currentMfgStep = 1;
      document.getElementById('btn-mfg-prev')?.addEventListener('click', () => {
        currentMfgStep = Math.max(1, currentMfgStep - 1);
        lampScene?.setManufacturingStep(currentMfgStep);
      });
      document.getElementById('btn-mfg-next')?.addEventListener('click', () => {
        currentMfgStep = Math.min(8, currentMfgStep + 1);
        lampScene?.setManufacturingStep(currentMfgStep);
      });
    }

    function updateElectricalReadouts(state: ElectricalState) {
      const statusLabel = document.getElementById('lex-power-status-text');
      const roResistance = document.getElementById('ro-resistance');
      const roCurrent = document.getElementById('ro-current');
      const roPower = document.getElementById('ro-power');
      const roTemp = document.getElementById('ro-temp');
      const roLumens = document.getElementById('ro-lumens');
      const roStatus = document.getElementById('ro-status');
      const failRow = document.getElementById('exp-failure-row');

      if (statusLabel) {
        statusLabel.textContent = state.isFailed ? 'BURNED OUT' : state.isPowered ? `${state.voltage}V ON` : 'OFF';
        statusLabel.style.color = state.isFailed ? '#ef4444' : state.isPowered ? '#f59e0b' : '#64748b';
      }

      if (roResistance) roResistance.textContent = `${state.resistance} Ω`;
      if (roCurrent) roCurrent.textContent = `${state.current} A`;
      if (roPower) roPower.textContent = `${state.power} W`;
      if (roTemp) roTemp.textContent = `${state.temperature} K`;
      if (roLumens) roLumens.textContent = `${state.candlepower} cd (~${state.lumens} lm)`;
      if (roStatus) {
        roStatus.textContent = state.statusText;
        roStatus.className = `ro-val status ${state.isFailed ? 'failed' : 'ok'}`;
      }

      if (failRow) failRow.hidden = !state.isFailed;
    }

    function updateManufacturingUI(step: number) {
      const stepData = MANUFACTURING_STEPS[step - 1];
      if (!stepData) return;

      const stepLabel = document.getElementById('mfg-step-label');
      const actionTag = document.getElementById('mfg-action-tag');
      const title = document.getElementById('mfg-title');
      const desc = document.getElementById('mfg-desc');

      if (stepLabel) stepLabel.textContent = `STEP 0${step} OF 08`;
      if (actionTag) actionTag.textContent = stepData.shortAction;
      if (title) title.textContent = stepData.title;
      if (desc) desc.textContent = stepData.historicalProcess;
    }

    // Modal Triggers
    openDocsBtn?.addEventListener('click', () => {
      if (docsModal) docsModal.hidden = false;
    });

    openSourcesBtn?.addEventListener('click', () => {
      if (sourcesModal) sourcesModal.hidden = false;
    });

    document.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-close-modal');
        if (targetId) {
          const modal = document.getElementById(targetId);
          if (modal) modal.hidden = true;
        }
      });
    });

    // Document Modal Tab Switching
    document.querySelectorAll('.doc-tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.doc-tab-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const docKey = btn.getAttribute('data-doc');
        if (docKey && HISTORICAL_DOCUMENTS[docKey]) {
          const doc = HISTORICAL_DOCUMENTS[docKey];
          const container = document.getElementById('doc-active-content');
          if (container) {
            container.innerHTML = `
              <div class="doc-date-badge">${doc.date}</div>
              <h4>${doc.title}</h4>
              <p class="doc-transcription">${doc.transcription}</p>
              <div class="doc-context"><strong>Historical Analysis:</strong> ${doc.historicalContext}</div>
              <div class="doc-data-table">
                ${Object.entries(doc.documentedData)
                  .map(([k, v]) => `<div class="data-row"><span class="data-k">${k}:</span><span class="data-v">${v}</span></div>`)
                  .join('')}
              </div>
            `;
          }
        }
      });
    });

    // Clean View / Screenshot Mode Toggle (Hotkey: H)
    function toggleCleanView() {
      isUiHidden = !isUiHidden;
      document.body.classList.toggle('lex-clean-view', isUiHidden);
      if (componentHud && isUiHidden) componentHud.hidden = true;
      if (mfgPanel && isUiHidden) mfgPanel.hidden = true;
      if (expPanel && isUiHidden) expPanel.hidden = true;
    }

    toggleUiBtn?.addEventListener('click', toggleCleanView);

    // Global Keybindings
    window.addEventListener('keydown', (e) => {
      if (
        document.activeElement instanceof HTMLInputElement ||
        document.activeElement instanceof HTMLTextAreaElement
      ) {
        return;
      }

      if (e.key === 'h' || e.key === 'H') {
        toggleCleanView();
      } else if (e.key === 'r' || e.key === 'R') {
        lampScene?.resetCamera();
      } else if (e.key === ' ' || e.code === 'Space') {
        if (!labStage?.hidden) {
          e.preventDefault();
          lampScene?.togglePower();
        }
      } else if (e.key === 'Escape') {
        if (docsModal) docsModal.hidden = true;
        if (sourcesModal) sourcesModal.hidden = true;
        if (componentHud) componentHud.hidden = true;
      } else if (['1', '2', '3', '4', '5', '6', '7'].includes(e.key) && !labStage?.hidden) {
        const modes: LampViewMode[] = ['assembly', 'cutaway', 'exploded', 'xray', 'manufacturing', 'vacuum', 'experiment'];
        const targetMode = modes[Number(e.key) - 1];
        if (targetMode && lampScene) {
          document.querySelectorAll('.lex-mode-btn').forEach((b) => {
            b.classList.toggle('active', b.getAttribute('data-mode') === targetMode);
          });
          lampScene.setMode(targetMode);
          if (mfgPanel) mfgPanel.hidden = targetMode !== 'manufacturing' || isUiHidden;
          if (expPanel) expPanel.hidden = targetMode !== 'experiment' || isUiHidden;
        }
      }
    });

    // Auto-launch if initial view is laboratory
    const initialView = root.getAttribute('data-initial-view');
    const initialEra = root.getAttribute('data-initial-era') || 'edison-1879';
    if (initialView === 'laboratory') {
      transitionToLaboratory(initialEra);
    }
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightExplorerApp);
  } else {
    initLightExplorerApp();
  }
</script>
