---
import EmojiIcon from '../components/EmojiIcon.astro';
import data from '../content/pages/about.json';
import Base from '../layouts/Base.astro';
import '../styles/about.css';

const richText = (value: string) =>
  value
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .split('\n\n')
    .map((paragraph) => `<p>${paragraph}</p>`)
    .join('');
---

<Base
  title={data.seo_title}
  description={data.seo_description}
  canonical="https://electrasim.com/about/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About ElectraSim",
      "url": "https://electrasim.com/about/",
      "description": "Learn about ElectraSim — who built it, why it exists, and what makes it different.",
      "publisher": { "@type": "Organization", "name": "ElectraSim", "url": "https://electrasim.com/" }
    })} />
  </Fragment>

  <header class="about-page-hero" data-live>
    <div class="wrap">
      <span class="about-eyebrow">
        <span aria-hidden="true"></span>
        About ElectraSim
      </span>
      <h1 set:html={data.hero_heading.replace('\n', '<br>')}></h1>
      <p>{data.hero_sub}</p>
      <div class="about-hero-actions">
        <a href="/app/" class="btn-primary">Open the Simulator</a>
        <a href="/guide/" class="btn-outline">Read the Guide</a>
      </div>
    </div>
  </header>

  <main id="main-content" class="about-main" data-live>
    <div class="wrap">

      <section class="about-intro" aria-labelledby="mission-h">
        <div class="about-prose about-prose-feature">
          <span class="section-kicker">Mission</span>
          <h2 id="mission-h">{data.mission_heading}</h2>
          <Fragment set:html={richText(data.mission_body)} />
        </div>
        <div class="about-snapshot" aria-label="ElectraSim highlights">
          <div>
            <strong>100%</strong>
            <span>free to use</span>
          </div>
          <div>
            <strong>0</strong>
            <span>accounts required</span>
          </div>
          <div>
            <strong>60fps</strong>
            <span>responsive simulation</span>
          </div>
        </div>
      </section>

      <section class="about-sec" aria-labelledby="values-h">
        <div class="about-section-head">
          <span class="section-kicker">Principles</span>
          <h2 id="values-h">What We Stand For</h2>
          <p>ElectraSim is shaped around practical learning, privacy, and fast access for anyone who needs to understand circuits.</p>
        </div>
        <div class="value-grid">
          {data.values.map((v: { icon: string; title: string; body: string }) => (
            <div class="value-card">
              <span class="value-icon"><EmojiIcon name={v.icon} /></span>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="about-contact about-sec" aria-labelledby="contact-h">
        <div class="about-prose">
          <span class="section-kicker">Connect</span>
          <h2 id="contact-h">Get in Touch</h2>
          <Fragment set:html={richText(data.contact_body)} />
        </div>
        <a href="/contact/" class="about-contact-card">
          <span aria-hidden="true"><EmojiIcon name="envelope" /></span>
          <strong>Questions, bugs, or feature ideas</strong>
          <small>Send a message through the contact page</small>
        </a>
      </section>

      <div class="about-cta-strip">
        <h2>{data.cta_heading}</h2>
        <p>{data.cta_body}</p>
        <a href="/app/" class="btn-primary"><EmojiIcon name="bolt" /> Launch the Simulator</a>
      </div>

    </div><!-- /.wrap -->
  </main>
</Base>
