---
import ExploreComingSoon from '../../components/coming-soon/ExploreComingSoon.astro';
import Base from '../../layouts/Base.astro';

const title = 'ElectraSim Explore — Coming Soon in v2.1';
const description =
  'ElectraSim Explore is an immersive 3D historical electrical laboratory. It is in active development and will ship with ElectraSim v2.1.';
const canonical = 'https://electrasim.com/explore/';
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  robots="index, follow"
  ogImage="https://electrasim.com/og-image.png"
  ogImageWidth={1736}
  ogImageHeight={906}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'ElectraSim Explore',
      description,
      url: canonical,
      inLanguage: 'en-US',
      isPartOf: {
        '@type': 'WebSite',
        name: 'ElectraSim',
        url: 'https://electrasim.com/',
      },
    })} />
  </Fragment>

  <main id="main-content" data-live>
    <ExploreComingSoon />
  </main>
</Base>
