---
import LightExplorerExperience from '../../components/explore/LightExplorerExperience.astro';
import LightExplorerLayout from '../../layouts/LightExplorerLayout.astro';
const title = 'Edison Light Explorer — The 1879 Incandescent Lamp | ElectraSim';
const description = "Explore a historically grounded 3D reconstruction of Edison’s 1879 carbon-filament lamp in an interactive historical laboratory.";
const canonical = 'https://electrasim.com/experimental/light-explorer/';
const schema = { '@context':'https://schema.org', '@type':'WebApplication', name:'Edison Light Explorer', url:canonical, description, applicationCategory:'EducationalApplication', operatingSystem:'Web browser', isAccessibleForFree:true, publisher:{'@type':'Organization',name:'ElectraSim',url:'https://electrasim.com/'} };
---
<LightExplorerLayout title={title} description={description} canonical={canonical} structuredData={schema}>
  <LightExplorerExperience />
</LightExplorerLayout>
