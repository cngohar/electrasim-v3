---
import LightExplorerLayout from '../../../../layouts/LightExplorerLayout.astro';
import LightExplorerApp from '../../../../experimental/light-explorer/LightExplorerApp.astro';
import { getEdison1879SEO } from '../../../../experimental/light-explorer/data/seo';

const seo = getEdison1879SEO();
---

<LightExplorerLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  ogImage={seo.ogImage}
  ogImageAlt={seo.ogImageAlt}
  structuredData={seo.structuredData}
>
  <LightExplorerApp initialView="laboratory" initialEraId="edison-1879" />
</LightExplorerLayout>
