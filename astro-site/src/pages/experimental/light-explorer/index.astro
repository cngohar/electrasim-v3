---
import LightExplorerLayout from '../../../layouts/LightExplorerLayout.astro';
import LightExplorerApp from '../../../experimental/light-explorer/LightExplorerApp.astro';
import { LIGHT_EXPLORER_SEO } from '../../../experimental/light-explorer/data/seo';

const { title, description, canonical, ogImage, ogImageAlt, structuredData } = LIGHT_EXPLORER_SEO;
---

<LightExplorerLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  structuredData={structuredData}
>
  <LightExplorerApp initialView="gateway" initialEraId="edison-1879" />
</LightExplorerLayout>
