---
import { getCollection, render } from 'astro:content';
import packageMetadata from '../../../../package.json';
import Base from '../../layouts/Base.astro';
import { readingTime, wordCount } from '../../lib/blog';
import { sortUpdates, updateNeighbours } from '../../lib/updates';
import { ogCardUrl } from '../../og-manifest';
import '../../styles/blog/blog-article.css';

export async function getStaticPaths() {
  const allUpdates = sortUpdates(await getCollection('updates', ({ data }) => !data.draft));
  return allUpdates.map((post) => {
    const { newer, older } = updateNeighbours(allUpdates, post.id);
    return { params: { slug: post.id }, props: { post, newerPost: newer, olderPost: older } };
  });
}

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await render(post);

// ── Table of Contents (same long-read behaviour as blog articles) ───────────
interface TocItem {
  slug: string;
  text: string;
  children: TocItem[];
}
const tocItems: TocItem[] = [];
const sourceHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const useH3 = sourceHeadings.length <= 24;
for (const h of sourceHeadings) {
  if (h.depth === 2 || !useH3) {
    if (h.depth === 2) tocItems.push({ slug: h.slug, text: h.text, children: [] });
    continue;
  }
  const parent = tocItems[tocItems.length - 1];
  if (parent) parent.children.push({ slug: h.slug, text: h.text, children: [] });
  else tocItems.push({ slug: h.slug, text: h.text, children: [] });
}
const showToc = tocItems.length >= 3 && readingTime(post.body ?? '') >= 4;
const tocCount = sourceHeadings.length > 0 ? (useH3 ? sourceHeadings.length : tocItems.length) : 0;

const pubDateISO = post.data.pubDate.toISOString().split('T')[0];
const pubDateDisplay = post.data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updDateISO = post.data.updatedDate ? post.data.updatedDate.toISOString().split('T')[0] : null;
const updDateDisplay = post.data.updatedDate
  ? post.data.updatedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const canonical = `https://electrasim.com/updates/${post.id}/`;
// Unique generated card (1200×630) per release note; bespoke frontmatter
// `image:` still wins when present.
const cardImageRel = ogCardUrl(post.id, 'updates');
const ogImage = post.data.image
  ? post.data.image.startsWith('http')
    ? post.data.image
    : `https://electrasim.com${post.data.image}`
  : `https://electrasim.com${cardImageRel}`;
const ogImageType = post.data.image
  ? post.data.image.endsWith('.webp')
    ? 'image/webp'
    : post.data.image.endsWith('.avif')
      ? 'image/avif'
      : 'image/png'
  : 'image/png';
const heroImageRel = post.data.image ?? cardImageRel;

const readMins = readingTime(post.body ?? '');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: ogImage,
  datePublished: pubDateISO,
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString().split('T')[0],
  author: { '@type': 'Organization', name: 'ElectraSim', url: 'https://electrasim.com/' },
  publisher: {
    '@type': 'Organization',
    name: 'ElectraSim',
    url: 'https://electrasim.com/',
    logo: { '@type': 'ImageObject', url: 'https://electrasim.com/pwa-192.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  articleSection: 'Product News',
  keywords: post.data.tags.join(', '),
  wordCount: wordCount(post.body ?? ''),
  timeRequired: `PT${readMins}M`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://electrasim.com/' },
    { '@type': 'ListItem', position: 2, name: 'Product Updates', item: 'https://electrasim.com/updates/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};
---

<Base
  title={`${post.data.title} | ElectraSim Updates`}
  description={post.data.description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType={ogImageType}
  ogType="article"
  articleMeta={{
    publishedTime: pubDateISO,
    modifiedTime: (post.data.updatedDate ?? post.data.pubDate).toISOString().split('T')[0],
    section: 'Product News',
  }}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroImageRel} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {post.data.tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <main id="main-content">
    <div class="bc-wrap">
      <div class="wrap">
        <nav class="bc" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <a href="/updates/">Updates</a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span aria-current="page">{post.data.title}</span>
        </nav>
      </div>
    </div>

    <div class="art-wrap" data-live>
    <article class="art-inner">
      <div class="upd-article-chips">
        <span class="art-tag">{post.data.category}</span>
        {post.data.version && <span class="art-version-pill">{post.data.version}</span>}
      </div>
      <h1>{post.data.title}</h1>
      <div class="art-meta">
        <span>📅 <time datetime={pubDateISO}>{pubDateDisplay}</time>
          {updDateDisplay && <span class="updated-badge">Updated <time datetime={updDateISO}>{updDateDisplay}</time></span>}
        </span>
        <span>✍️ {post.data.author}</span>
        <span>⏱ {readMins} min read</span>
      </div>

      <figure class="art-hero">
        <img
          src={heroImageRel}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      {showToc && (
        <nav class="art-toc" aria-label="Table of contents — on this page">
          <div class="art-toc-box">
            <details class="art-toc-details" open>
              <summary class="art-toc-summary">
                <span class="art-toc-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                    <line x1="3" y1="18" x2="3.01" y2="18" />
                  </svg>
                  In this release
                </span>
                <span class="art-toc-count">{tocCount} section{tocCount === 1 ? '' : 's'}</span>
              </summary>
              <ol class="art-toc-list">
                {tocItems.map((item) => (
                  <li class="art-toc-item">
                    <a href={`#${item.slug}`} data-toc-link={item.slug}>{item.text}</a>
                    {item.children.length > 0 && (
                      <ol class="art-toc-sublist">
                        {item.children.map((child) => (
                          <li class="art-toc-item art-toc-subitem">
                            <a href={`#${child.slug}`} data-toc-link={child.slug}>{child.text}</a>
                          </li>
                        ))}
                      </ol>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          </div>
        </nav>
      )}

      <Content />

      {post.data.tags.length > 0 && (
        <div class="art-tags" aria-label="Release topics">
          {post.data.tags.map((tag: string) => (
            <span class="art-tag-item art-tag-plain">#{tag}</span>
          ))}
        </div>
      )}

      <div class="art-cta">
        <h2>Try It in ElectraSim</h2>
        <p>Load the app and use the newest components and modes right away — free, in your browser, no sign-up.</p>
        <a href="/app/" class="btn-primary">⚡ Open ElectraSim Free</a>
      </div>

      {(olderPost || newerPost) && (
        <nav class="post-nav" aria-label="Changelog navigation">
          {olderPost && (
            <a href={`/updates/${olderPost.id}/`} class="pn-prev">
              <span class="nav-dir">← Older release</span>
              <span class="nav-title">{olderPost.data.title}</span>
            </a>
          )}
          {newerPost && (
            <a href={`/updates/${newerPost.id}/`} class="pn-next">
              <span class="nav-dir">Newer release →</span>
              <span class="nav-title">{newerPost.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
    </div>
  </main>

  {showToc && (
    <script is:inline defer src={`/js/blog-article.js?v=${packageMetadata.version}`}></script>
  )}
</Base>

<style>
  .upd-article-chips {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }
  .upd-article-chips .art-tag {
    margin-bottom: 0;
  }
  .art-version-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    color: #7c3aed;
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.35);
  }
  :root[data-theme='dark'] .art-version-pill {
    color: #c4b5fd;
  }
  .art-tag-plain {
    cursor: default;
  }
  .art-tag-plain:hover {
    color: inherit;
    border-color: var(--border);
  }
</style>
