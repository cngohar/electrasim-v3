---
import { getCollection, getEntry } from 'astro:content';
import BlogIndexSections from '../../components/blog/BlogIndexSections.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import BlogTopicNav from '../../components/blog/BlogTopicNav.astro';
import Base from '../../layouts/Base.astro';
import { getTagArchives, paginatePosts, sortBlogPosts, totalPages } from '../../lib/blog';
import '../../styles/blog/blog-index.css';

type BlogIndexPage = {
  seo_title: string;
  seo_description: string;
  page_label: string;
  page_heading: string;
  page_description: string;
};

const allPosts = sortBlogPosts(await getCollection('blog', ({ data }) => !data.draft));
const pageCount = totalPages(allPosts.length);
const posts = paginatePosts(allPosts, 1);
const topics = getTagArchives(allPosts);

const pageEntry = await getEntry('pages', 'blog-index');
const p = pageEntry!.data as BlogIndexPage;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://electrasim.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://electrasim.com/blog/' },
  ],
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'ElectraSim Blog',
  url: 'https://electrasim.com/blog/',
  description: p.seo_description,
  publisher: { '@type': 'Organization', name: 'ElectraSim', url: 'https://electrasim.com/' },
  blogPost: allPosts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `https://electrasim.com/blog/${post.id}/`,
    datePublished: post.data.pubDate.toISOString().split('T')[0],
    description: post.data.description,
  })),
};
---

<Base
  title={p.seo_title}
  description={p.seo_description}
  canonical="https://electrasim.com/blog/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
    {pageCount > 1 && <link rel="next" href="https://electrasim.com/blog/2/" />}
  </Fragment>

  <!-- `<main>` wraps the hero so the skip link lands before the <h1>. -->
  <main id="main-content">
    <div class="page-hero blog-index-hero" data-live>
      <div class="wrap">
        <span class="label">{p.page_label}</span>
        <h1>{p.page_heading}</h1>
        <p>{p.page_description}</p>
      </div>
    </div>

    <div class="blog-sec">
      <div class="wrap">
        {allPosts.length === 0 ? (
          <div class="empty">
            <p>No posts published yet. Check back soon!</p>
            <a href="/" class="btn-outline">← Back to Home</a>
          </div>
        ) : (
          <>
            <BlogTopicNav topics={topics} />
            <BlogIndexSections posts={posts} />
            <BlogPagination currentPage={1} totalPages={pageCount} />
          </>
        )}
      </div>
    </div>
  </main>

</Base>
