---
import { getCollection } from 'astro:content';
import BlogPostGrid from '../../../components/blog/BlogPostGrid.astro';
import BlogTopicNav from '../../../components/blog/BlogTopicNav.astro';
import Base from '../../../layouts/Base.astro';
import { getTagArchives, sortBlogPosts } from '../../../lib/blog';
import '../../../styles/blog/blog-index.css';
import '../../../styles/blog/blog-tags.css';

export async function getStaticPaths() {
  const allPosts = sortBlogPosts(await getCollection('blog', ({ data }) => !data.draft), false);
  const topics = getTagArchives(allPosts);

  return topics.map((topic) => ({
    params: { tag: topic.slug },
    props: {
      topic,
      topics,
    },
  }));
}

const { tag } = Astro.params;
const { topic, topics } = Astro.props;
const { label: tagLabel, posts } = topic;
const canonical = `https://electrasim.com/blog/tags/${tag}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://electrasim.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://electrasim.com/blog/' },
    { '@type': 'ListItem', position: 3, name: `#${tagLabel}`, item: canonical },
  ],
};
---

<Base
  title={`#${tagLabel} — ElectraSim Blog`}
  description={`All ElectraSim blog posts tagged with "${tagLabel}". Electrical wiring guides, circuit tutorials and more.`}
  canonical={canonical}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- `<main>` wraps the hero so the breadcrumb and <h1> sit inside the main
       landmark and the skip link does not jump past the page title. -->
  <main id="main-content">
    <div class="tag-hero page-hero" data-live>
      <div class="wrap">
        <div class="bc-wrap tag-breadcrumb">
          <nav class="bc" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="bc-sep" aria-hidden="true">›</span>
            <a href="/blog/">Blog</a>
            <span class="bc-sep" aria-hidden="true">›</span>
            <span aria-current="page">#{tagLabel}</span>
          </nav>
        </div>
        <span class="tag-pill">#{tagLabel}</span>
        <h1>{posts.length} post{posts.length !== 1 ? 's' : ''} tagged "{tagLabel}"</h1>
        <p>Browse all ElectraSim articles about {tagLabel.toLowerCase()}.</p>
      </div>
    </div>

    <div class="tags-sec">
      <div class="wrap">

        <BlogTopicNav topics={topics} activeSlug={tag} />
        <BlogPostGrid posts={posts} />

        <div class="tag-all-articles">
          <a href="/blog/" class="btn-outline">← All Articles</a>
        </div>
      </div>
    </div>
  </main>
</Base>
