---
import { getCollection, render } from 'astro:content';
import packageMetadata from '../../../../package.json';
import EmojiIcon from '../../components/EmojiIcon.astro';
import Base from '../../layouts/Base.astro';
import { getTagArchives, readingTime, slugifyTag, sortBlogPosts, wordCount } from '../../lib/blog';
import { ogCardUrl } from '../../og-manifest';
import '../../styles/blog/blog-article.css';

export async function getStaticPaths() {
  const allPosts = sortBlogPosts(await getCollection('blog', ({ data }) => !data.draft), false);
  const generatedTagSlugs = new Set(getTagArchives(allPosts).map(({ slug }) => slug));
  return allPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: allPosts[index + 1] ?? null,
      nextPost: allPosts[index - 1] ?? null,
      generatedTags: post.data.tags.filter((tag) => generatedTagSlugs.has(slugifyTag(tag))),
    },
  }));
}

const { post, prevPost, nextPost, generatedTags } = Astro.props;
const { Content, headings } = await render(post);

// ── Table of Contents (server-rendered jump links for long articles) ────────
// Build an H2-led tree (H3 nested one level). Very long outlines fall back to
// H2-only so the TOC stays scannable.
interface TocItem {
  slug: string;
  text: string;
  children: TocItem[];
}
const tocItems: TocItem[] = [];
const sourceHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const useH3 = sourceHeadings.length <= 24;
for (const h of sourceHeadings) {
  if (h.depth === 2 || !useH3) {
    if (h.depth === 2) tocItems.push({ slug: h.slug, text: h.text, children: [] });
    continue;
  }
  const parent = tocItems[tocItems.length - 1];
  if (parent) parent.children.push({ slug: h.slug, text: h.text, children: [] });
  else tocItems.push({ slug: h.slug, text: h.text, children: [] });
}
// Only long-read articles get the TOC (≥4 min, ≥3 H2 sections).
const showToc = tocItems.length >= 3 && readingTime(post.body ?? '') >= 4;
const tocCount = sourceHeadings.length > 0 ? (useH3 ? sourceHeadings.length : tocItems.length) : 0;

const pubDateISO = post.data.pubDate.toISOString().split('T')[0];
const pubDateDisplay = post.data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updDateISO = post.data.updatedDate ? post.data.updatedDate.toISOString().split('T')[0] : null;
const updDateDisplay = post.data.updatedDate
  ? post.data.updatedDate.toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
const canonical = `https://electrasim.com/blog/${post.id}/`;
// Per-post generated social card (1200×630, unique per article). An explicit
// frontmatter `image:` still wins — those are bespoke article-only assets.
// ogCardUrl() appends a content hash (?v=…) so the CDN can cache immutable.
const cardImageRel = ogCardUrl(post.id);
const ogImage = post.data.image
  ? post.data.image.startsWith('http')
    ? post.data.image
    : `https://electrasim.com${post.data.image}`
  : `https://electrasim.com${cardImageRel}`;
const ogImageType = post.data.image
  ? post.data.image.endsWith('.webp')
    ? 'image/webp'
    : post.data.image.endsWith('.avif')
      ? 'image/avif'
      : 'image/png'
  : 'image/png';
// Visible in-article hero: bespoke frontmatter asset when present, otherwise
// the article's unique generated social card (1200×630).
const heroImageRel = post.data.image ?? cardImageRel;

const readMins = readingTime(post.body ?? '');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: ogImage,
  datePublished: pubDateISO,
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString().split('T')[0],
  author: { '@type': 'Organization', name: 'ElectraSim', url: 'https://electrasim.com/' },
  publisher: {
    '@type': 'Organization',
    name: 'ElectraSim',
    url: 'https://electrasim.com/',
    logo: { '@type': 'ImageObject', url: 'https://electrasim.com/pwa-192.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  wordCount: wordCount(post.body ?? ''),
  timeRequired: `PT${readMins}M`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://electrasim.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://electrasim.com/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};
---

<Base
  title={`${post.data.title} | ElectraSim Blog`}
  description={post.data.description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType={ogImageType}
  ogType="article"
  articleMeta={{
    publishedTime: pubDateISO,
    modifiedTime: (post.data.updatedDate ?? post.data.pubDate).toISOString().split('T')[0],
    section: post.data.category,
  }}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroImageRel} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {post.data.tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <main id="main-content">
    <div class="bc-wrap">
      <div class="wrap">
        <nav class="bc" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <a href="/blog/">Blog</a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span aria-current="page">{post.data.title}</span>
        </nav>
      </div>
    </div>

    <div class="art-wrap" data-live>
    <article class="art-inner">
      <span class="art-tag">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <div class="art-meta">
        <span><EmojiIcon name="calendar" /> <time datetime={pubDateISO}>{pubDateDisplay}</time>
          {updDateDisplay && <span class="updated-badge">Updated <time datetime={updDateISO}>{updDateDisplay}</time></span>}
        </span>
        <span><EmojiIcon name="writing" /> {post.data.author}</span>
        <span>⏱ {readMins} min read</span>
      </div>

      <figure class="art-hero">
        <img
          src={heroImageRel}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      {showToc && (
        <nav class="art-toc" aria-label="Table of contents — on this page">
          <div class="art-toc-box">
            <details class="art-toc-details" open>
              <summary class="art-toc-summary">
                <span class="art-toc-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                    <line x1="3" y1="18" x2="3.01" y2="18" />
                  </svg>
                  On this page
                </span>
                <span class="art-toc-count">{tocCount} section{tocCount === 1 ? '' : 's'}</span>
              </summary>
              <ol class="art-toc-list">
                {tocItems.map((item) => (
                  <li class="art-toc-item">
                    <a href={`#${item.slug}`} data-toc-link={item.slug}>{item.text}</a>
                    {item.children.length > 0 && (
                      <ol class="art-toc-sublist">
                        {item.children.map((child) => (
                          <li class="art-toc-item art-toc-subitem">
                            <a href={`#${child.slug}`} data-toc-link={child.slug}>{child.text}</a>
                          </li>
                        ))}
                      </ol>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          </div>
        </nav>
      )}

      <Content />

      {generatedTags.length > 0 && (
        <div class="art-tags" aria-label="Tags">
          {generatedTags.map((tag: string) => (
            <a href={`/blog/tags/${slugifyTag(tag)}/`} class="art-tag-item">#{tag}</a>
          ))}
        </div>
      )}

      <div class="art-cta">
        <h2>See It All in Action</h2>
        <p>Build and simulate the circuits from this article for free in your browser. No installation, no sign-up.</p>
        <a href="/app/" class="btn-primary"><EmojiIcon name="bolt" /> Open ElectraSim Free</a>
      </div>

      {(prevPost || nextPost) && (
        <nav class="post-nav" aria-label="Post navigation">
          {prevPost && (
            <a href={`/blog/${prevPost.id}/`} class="pn-prev">
              <span class="nav-dir">← Previous</span>
              <span class="nav-title">{prevPost.data.title}</span>
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.id}/`} class="pn-next">
              <span class="nav-dir">Next →</span>
              <span class="nav-title">{nextPost.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
    </div>
  </main>

  {showToc && (
    <script is:inline defer src={`/js/blog-article.js?v=${packageMetadata.version}`}></script>
  )}
</Base>
