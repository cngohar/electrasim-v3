---
import ToolWorkspace from '../../components/tools/ToolWorkspace.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolById } from '../../lib/tools/registry';
import { generateToolStructuredData } from '../../lib/tools/seo';

const tool = getToolById('cable-size')!;
const structuredData = generateToolStructuredData(tool);
---

<ToolLayout
  title={tool.metaTitle}
  description={tool.metaDescription}
  canonical={`https://electrasim.com${tool.route}`}
  keywords={tool.keywords}
  ogImage={tool.ogImage}
  structuredData={structuredData}
>
  <!--
    The scene is the calculator: SOURCE → CABLE → LOAD. The workspace supplies
    the stage shell; the artwork (CableSizeScene) and the instruments
    (CableSizePanels) are this tool's, and the engine
    (public/js/cable-size-tool.js, bundled from src/tools/cable-size/engine.ts)
    repaints both from one evaluation.
  -->
  <ToolWorkspace currentTool={tool} variant="cable-size" toolScript="/js/cable-size-tool.js" />
</ToolLayout>
