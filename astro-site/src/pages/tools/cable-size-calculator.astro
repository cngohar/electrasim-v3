---
import ToolWorkspace from '../../components/tools/ToolWorkspace.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolById } from '../../lib/tools/registry';
import { generateToolStructuredData } from '../../lib/tools/seo';

const tool = getToolById('cable-size')!;
const structuredData = generateToolStructuredData(tool);
---

<ToolLayout
  title={tool.metaTitle}
  description={tool.metaDescription}
  canonical={`https://electrasim.com${tool.route}`}
  keywords={tool.keywords}
  ogImage={tool.ogImage}
  structuredData={structuredData}
>
  <!--
    Same stage shell as the voltage-drop tool, different picture: the cutaway is
    supplied by the workspace's `variant`, and the engine that paints it is the
    cable sizer. See src/components/tools/ToolWorkspace.astro.
  -->
  <ToolWorkspace currentTool={tool} variant="cable-sizing" toolScript="/js/cable-size-tool.js" />
</ToolLayout>
