---
import { marked } from 'marked';
import data from '../content/pages/privacy.json';
import Base from '../layouts/Base.astro';
import '../styles/legal.css';

const lastUpdated = data.last_updated;
const bodyHtml = marked.parse(data.content);
---

<Base
  title={data.seo_title}
  description={data.seo_description}
  canonical="https://electrasim.com/privacy/"
>
  <!-- `<main>` wraps the hero so the skip link lands before the <h1>, not
       past it. `<main>` itself is unstyled; `.legal-wrap` moved to a <div>. -->
  <main id="main-content">
    <div class="legal-hero" data-live>
      <div class="wrap">
        <span class="label">Legal</span>
        <h1>Privacy Policy</h1>
        <p>Last updated: {lastUpdated}</p>
      </div>
    </div>

    <div class="legal-wrap">
      <Fragment set:html={bodyHtml} />
    </div>
  </main>
</Base>
