---
import { getCollection } from 'astro:content';
import CatalogCard from '../../../components/guide/CatalogCard.astro';
import GuideCta from '../../../components/guide/GuideCta.astro';
import Base from '../../../layouts/Base.astro';
import '../../../styles/guide.css';
import '../../../styles/guide-lab.css';
import { termsIn } from '../../../lib/glossary';
import { GUIDE_LAB_VERSION } from '../../../lib/asset-version';


export async function getStaticPaths() {
  const tools = await getCollection('guideTools');
  return tools.map((tool) => ({
    params: { slug: tool.data.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { data } = tool;
const canonical = `https://electrasim.com/guide/tools/${data.slug}/`;

/* Terms this page uses, read off its own copy. */
const usedTerms = termsIn(
  [data.name, data.tagline, data.safety ?? '', ...(data.parts ?? [])].join(' '),
);

/* Next/prev for the "more hand tools" row. */
const all = (await getCollection('guideTools')).map((t) => t.data).sort((a, b) => a.name.localeCompare(b.name));
const index = all.findIndex((t) => t.slug === data.slug);
const next = all[(index + 1) % all.length];
const prev = all[(index - 1 + all.length) % all.length];
---

<Base
  title={`${data.name} Anatomy — ElectraSim Hand Tools Guide`}
  description={`${data.tagline} Inside ${data.name}.`}
  canonical={canonical}
>
  <main id="main-content">
    <div class="bc-wrap">
      <div class="wrap">
        <nav class="bc" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/guide/">Circuit Guide</a><span aria-hidden="true">›</span>
          <a href="/guide/tools/">Hand Tools</a><span aria-hidden="true">›</span>
          <span aria-current="page">{data.name}</span>
        </nav>
      </div>
    </div>

    <div class="guide-hero guide-hero--small">
      <div class="wrap">
        <span class="label">{data.category}</span>
        <h1>{data.name}</h1>
        <p>{data.tagline}</p>
      </div>
    </div>

    <div class="guide-main" data-live>
      <div class="wrap">
        <nav class="guide-lab-nav" aria-label="Guide sections">
          <a href="/guide/tools/" aria-current="page"><span class="lab-icon" aria-hidden="true">🛠️</span> Hand Tools</a>
          <a href="/guide/components/"><span class="lab-icon" aria-hidden="true">🔌</span> Components</a>
          <a href="/guide/circuits/"><span class="lab-icon" aria-hidden="true">⚡</span> Circuits</a>
          <a href="/guide/templates/"><span class="lab-icon" aria-hidden="true">🧭</span> In the App</a>
        </nav>

        <div class="guide-detail-grid">
          <CatalogCard item={data} wide hotspots detailTargetId="anatomy-detail" />

          <aside class="dl-spec" aria-label={`${data.name} specification`}>
            <div class="dl-spec__row">
              <dt>Category</dt>
              <dd>{data.category}</dd>
            </div>
            <div class="dl-spec__row">
              <dt>Parts</dt>
              <dd>
                <ul>
                  {data.parts.map((p) => <li>{p}</li>)}
                </ul>
              </dd>
            </div>
            <!-- Point detail beside the figure, not below it. -->
            <div class="dl-anatomy-detail" id="anatomy-detail" data-anatomy-detail>
              <h4 data-anatomy-title>{data.name}</h4>
              <p data-anatomy-text>Select a numbered marker on the figure to read about that part.</p>
            </div>
          </aside>
        </div>

        <section class="used-in" aria-labelledby="used-in-h">
          <div class="used-in-head" id="used-in-h">🔧 Use it while you build</div>
          <ul>
            <li>
              <a href="/guide/circuits/single-lamp-switch/">
                <span class="ui-step">01</span>
                <span class="ui-title">Single-Lamp Switched Circuit</span>
              </a>
            </li>
            <li>
              <a href="/guide/circuits/rcd-socket-circuit/">
                <span class="ui-step">04</span>
                <span class="ui-title">RCD-Protected Socket Circuit</span>
              </a>
            </li>
          </ul>
        </section>

        {usedTerms.length > 0 && (
          <section class="cd-terms" aria-labelledby="cd-terms-h">
            <h2 id="cd-terms-h">Terms used here</h2>
            <p class="cd-terms-note">
              Defined in the <a href="/glossary/">glossary</a> — each one opens at its own entry.
            </p>
            <ul class="cd-terms-list">
              {usedTerms.map((term) => (
                <li>
                  <a href={`/glossary/#${term.slug}`}>
                    <span class="cd-terms-term">{term.term}</span>
                    <span class="cd-terms-cat">{term.category}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Full-width safety band: below the anatomy, above the bottom row. -->
        {data.safety && (
          <div class="safety-band">
            <span class="sn-label">⚠ Safety note</span>
            <p>{data.safety}</p>
          </div>
        )}

        <div class="dl-browse">
          <span class="dl-browse-head">More tools</span>
          <div class="dl-lab-grid">
            <a class="dl-browse-link" href={`/guide/tools/${prev.slug}/`}>← {prev.name}</a>
            <a class="dl-browse-link" href={`/guide/tools/${next.slug}/`}>{next.name} →</a>
          </div>
        </div>

        <GuideCta
          heading="Tool understood. Time to wire."
          description="Run the real thing — a guided circuit, live current, and fault simulation in your browser."
          primary="Open ElectraSim Free"
          secondary="Browse all tools →"
        />
      </div>
    </div>
  </main>

  <script is:inline defer src={`/js/guide-lab.js?v=${GUIDE_LAB_VERSION}`}></script>
</Base>