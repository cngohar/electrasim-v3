---
import { getCollection } from 'astro:content';
import packageMetadata from '../../../../package.json';
import CatalogCard from '../../../components/guide/CatalogCard.astro';
import GuideCta from '../../../components/guide/GuideCta.astro';
import Base from '../../../layouts/Base.astro';
import '../../../styles/guide.css';
import '../../../styles/guide-lab.css';

const tools = await getCollection('guideTools');
const sorted = [...tools].sort((a, b) => a.data.name.localeCompare(b.data.name));
const featured = 4;
const canonical = 'https://electrasim.com/guide/tools/';
---

<Base
  title="ElectraSim — Electrical Hand Tools &amp; Accessories Anatomy Guide"
  description="Learn the anatomy of electrician's hand tools — needle-nose pliers, side cutters, wire strippers and VDE screwdrivers — with labeled hotspots and safety notes for wiring projects."
  canonical={canonical}
>
  <main id="main-content">
    <div class="bc-wrap">
      <div class="wrap">
        <nav class="bc" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/guide/">Circuit Guide</a><span aria-hidden="true">›</span>
          <span aria-current="page">Hand Tools</span>
        </nav>
      </div>
    </div>

    <div class="guide-hero guide-hero--small">
      <div class="wrap">
        <span class="label">Hand Tools &amp; Accessories</span>
        <h1>Know the tool before you touch the wire.</h1>
        <p>Anatomy guides for electrician's hand tools — click the hotspots on each drawing to learn what each part does, how to use it safely, and which job it's built for.</p>
      </div>
    </div>

    <div class="progress-strip">
      <div class="wrap">
        <div class="progress-inner">
          {tools.map((tool) => (
            <a class="prog-item" href={`#${tool.data.slug}`} title={tool.data.name}>
              <div class="prog-num">✦</div>
              <span class="prog-label">{tool.data.name.split(' ').slice(0, 2).join(' ')}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="guide-main" data-live>
      <div class="wrap">
        <section class="guide-section" id="tools" aria-labelledby="tools-h">
          <div class="guide-section-head">
            <span class="guide-kicker">The toolbox</span>
            <h2 id="tools-h">Start here: work through {featured} core hand tools</h2>
            <p>Every drawing is interactive — hover or tap a numbered marker to reveal what that part is for.</p>
          </div>
          <div class="dl-lab-grid">
            {sorted.map((tool) => (
              <CatalogCard item={tool.data} href={`/guide/tools/${tool.data.slug}/`} />
            ))}
          </div>
        </section>

        <GuideCta
          heading="Got the tools? Now wire it for real."
          description="Open ElectraSim, pick a guided circuit template, and follow the exact path a live conductor takes — fault-tested and exportable."
          primary="Open ElectraSim Free"
          secondary="Read the Blog →"
        />
      </div>
    </div>
  </main>

  <script is:inline defer src={`/js/guide-lab.js?v=${packageMetadata.version}`}></script>
</Base>