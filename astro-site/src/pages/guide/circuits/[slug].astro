---
import { getCollection } from 'astro:content';
import packageMetadata from '../../../../../package.json';
import EmojiIcon from '../../../components/EmojiIcon.astro';
import GuideCta from '../../../components/guide/GuideCta.astro';
import Base from '../../../layouts/Base.astro';
import data from '../../../content/pages/guide.json';
import {
  CIRCUIT_SCHEMATICS,
  anatomiesForCircuit,
  circuitSafety,
  circuitSlug,
  diagramLabel,
  levelClass,
} from '../../../lib/guide';
import '../../../styles/guide.css';
import '../../../styles/guide-lab.css';
import type { GuideCircuit, GuidedTemplate } from '../../../types/pages';

const circuits = data.circuits as GuideCircuit[];
const guidedTemplates = data.guided_templates as GuidedTemplate[];
const anatomyEntries = await getCollection('guideComponents');

export function getStaticPaths() {
  return (data.circuits as GuideCircuit[]).map((circuit, index) => ({
    params: { slug: circuitSlug(circuit) },
    props: { circuit, index },
  }));
}

const { circuit, index } = Astro.props;
const prev = circuits[index - 1];
const next = circuits[index + 1];
const slug = circuitSlug(circuit);

const spokenPath = diagramLabel(circuit.diagram);
const schematic = CIRCUIT_SCHEMATICS[circuit.id];

/* Component chips link to the anatomy page that explains them — the
   circuit → anatomy half of the cross-link mesh. */
const linked = anatomiesForCircuit(circuit);
const chipHref = (component: string) => {
  const rule = linked.find((r) => r.match.test(component));
  return rule ? `/guide/components/${rule.slug}/` : null;
};

/* Reverse direction: anatomy pages that explain something in this circuit. */
type RelatedAnatomy = { slug: string; name: string; tagline: string };
const relatedAnatomies: RelatedAnatomy[] = linked
  .map((rule) => {
    const entry = anatomyEntries.find((e) => e.data.slug === rule.slug);
    return entry ? { slug: rule.slug, name: entry.data.name, tagline: entry.data.tagline } : null;
  })
  .filter((a): a is RelatedAnatomy => a !== null);

const matchedTemplate = circuit.app_template
  ? guidedTemplates.find((t) => t.id === circuit.app_template)
  : null;

const canonical = `https://electrasim.com/guide/circuits/${slug}/`;
---

<Base
  title={`${circuit.title} — Circuit Walkthrough | ElectraSim Guide`}
  description={`${circuit.description} Components, wiring path and step-by-step build for the ${circuit.title}, with the key insight and safety rule.`}
  canonical={canonical}
>
  <main id="main-content">
    <div class="bc-wrap">
      <div class="wrap">
        <nav class="bc" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/guide/">Circuit Guide</a><span aria-hidden="true">›</span>
          <a href="/guide/circuits/">Circuits</a><span aria-hidden="true">›</span>
          <span aria-current="page">{circuit.title}</span>
        </nav>
      </div>
    </div>

    <article class="circuit-detail">
      <div class="wrap">
        <nav class="guide-lab-nav" aria-label="Guide sections">
          <a href="/guide/tools/"><span class="lab-icon" aria-hidden="true">🛠️</span> Hand Tools</a>
          <a href="/guide/components/"><span class="lab-icon" aria-hidden="true">🔌</span> Components</a>
          <a href="/guide/circuits/" aria-current="page"><span class="lab-icon" aria-hidden="true">⚡</span> Circuits</a>
          <a href="/guide/templates/"><span class="lab-icon" aria-hidden="true">🧭</span> In the App</a>
        </nav>

                <header class="cd-head">
          <div class="step-badge">{circuit.step}</div>
          <div>
            <div class="circuit-meta-row">
              <span class:list={['level-pill', levelClass(circuit.level)]}>
                <span class="level-dot" aria-hidden="true"></span>
                {circuit.level}
              </span>
              {matchedTemplate && <span class="cd-template-badge">🧭 Matches an in-app guided circuit</span>}
            </div>
            <h1>{circuit.title}</h1>
            <p class="cd-desc">{circuit.description}</p>
          </div>
        </header>

        <div class="card-body">
          <div class="card-col">
            <h3>Components Needed</h3>
            <div class="comp-list">
              {circuit.components.map((component) => {
                const href = chipHref(component);
                return href ? (
                  <a class="comp-chip comp-chip--link" href={href}>{component} <span aria-hidden="true">↗</span></a>
                ) : (
                  <span class="comp-chip">{component}</span>
                );
              })}
            </div>

            <h3 class="circuit-diagram-heading">Text Wiring Path</h3>
            <div class="diagram-box">
              <pre role="img" aria-label={`Circuit path: ${spokenPath}`}>{circuit.diagram}</pre>
            </div>

            {schematic && (
              <>
                <h3 class="circuit-diagram-heading">Schematic</h3>
                <figure class="schem-box">
                  <Fragment set:html={schematic} />
                  <figcaption class="schem-legend">
                    <span><i class="lg lg-live"></i> Live (line)</span>
                    <span><i class="lg lg-neutral"></i> Neutral</span>
                    <span><i class="lg lg-sw"></i> Strapper / switch wire</span>
                    <span><i class="lg lg-flow"></i> Current flow (simulated)</span>
                  </figcaption>
                </figure>
              </>
            )}
          </div>

          <div class="card-col">
            <h3>Steps</h3>
            <ol class="step-list">
              {circuit.steps.map((step, i) => (
                <li class="step-item">
                  <span class="step-n">{i + 1}</span>
                  <span class="step-text">{step}</span>
                </li>
              ))}
            </ol>

            <div class="insight">
              <span class="insight-label"><EmojiIcon name="bulb" /> Key insight</span>
              <p>{circuit.insight}</p>
            </div>
          </div>
        </div>

        <!-- Full-width safety band: below the walkthrough, above the bottom row. -->
        <div class="safety-band">
          <span class="sn-label">⚠ Safety practice</span>
          <p>{circuitSafety(circuit)}</p>
        </div>

        {relatedAnatomies.length > 0 && (
          <section class="cd-related" aria-labelledby="cd-related-h">
            <h2 id="cd-related-h">Parts used here</h2>
            <div class="cd-related-grid">
              {relatedAnatomies.map((a) => (
                <a class="cd-related-card" href={`/guide/components/${a.slug}/`}>
                  <span class="cd-related-name">{a.name}</span>
                  <span class="cd-related-tag">{a.tagline}</span>
                  <span class="cs-go">Open anatomy →</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="try-row">
          <span>
            {matchedTemplate
              ? 'Ready to try it? This walkthrough matches a built-in guide — open it pre-built in the editor.'
              : 'Ready to try it? Open ElectraSim and follow the steps above.'}
          </span>
          <a href={circuit.app_template ? `/app/?template=${circuit.app_template}` : '/app/'} class="btn-try">Build this circuit →</a>
        </div>

        <nav class="cd-prev-next" aria-label="Circuit walkthroughs">
          {prev ? (
            <a class="pn-prev" href={`/guide/circuits/${circuitSlug(prev)}/`}>
              <span class="pn-dir">← Lesson {prev.step}</span>
              <span class="pn-title">{prev.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a class="pn-next" href={`/guide/circuits/${circuitSlug(next)}/`}>
              <span class="pn-dir">Lesson {next.step} →</span>
              <span class="pn-title">{next.title}</span>
            </a>
          ) : <span />}
        </nav>
      </div>

      <GuideCta
        heading="Now wire it for real."
        description="Build this circuit in the browser, inject a fault, and watch the protection respond."
        primary="Open ElectraSim Free"
        secondary="All walkthroughs →"
      />
    </article>
  </main>

  <script is:inline defer src={`/js/guide-lab.js?v=${packageMetadata.version}`}></script>
</Base>

<style>
  .circuit-detail {
    padding: 2rem 0 0;
  }
  .cd-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.75rem;
  }
  .cd-head h1 {
    margin: 0.15rem 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
  }
  .cd-desc {
    margin: 0;
    color: var(--text-mid);
    max-width: 62ch;
  }
  .cd-template-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--blue-ink);
    background: var(--blue-l);
    border: 1px solid var(--border-bright);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  /* Schematic frame — light, so the black neutral conductor is legible. */
  .schem-box {
    margin: 0 0 1rem;
    background: #fff;
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    padding: 0.6rem 0.9rem 0.35rem;
    overflow-x: auto;
    position: relative;
  }
  .schem-box::before,
  .schem-box::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid rgba(51, 65, 85, 0.35);
    pointer-events: none;
  }
  .schem-box::before { left: 6px; top: 6px; border-right: 0; border-bottom: 0; }
  .schem-box::after { right: 6px; bottom: 6px; border-left: 0; border-top: 0; }
  .schem-box :global(.schem) {
    display: block;
    min-width: 480px;
    width: 100%;
    height: auto;
  }
  .schem-legend {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.4rem 0.15rem;
    margin-top: 0.4rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-mid);
  }
  .schem-legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .schem-legend i { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
  .lg-live { background: #dc2626; }
  .lg-neutral { background: #0f172a; }
  .lg-sw { background: #b45309; }
  .lg-flow { background: repeating-linear-gradient(90deg, #f59e0b 0 5px, transparent 5px 9px); }

  /* Safety band — full width, below the walkthrough, above the bottom row. */
  .safety-band {
    margin: 2rem 0 1.5rem;
    border: 1px solid var(--warning-border);
    border-left: 4px solid var(--amber);
    border-radius: 12px;
    background: var(--warning-bg);
    padding: 1.1rem 1.4rem;
  }
  .sn-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warning-text);
    margin-bottom: 0.35rem;
  }
  .safety-band p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 78ch;
  }

  .cd-related { margin: 2.5rem 0 1.5rem; }
  .cd-related h2 { font-size: 1.1rem; margin-bottom: 0.9rem; }
  .cd-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .cd-related-card {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .cd-related-card:hover { border-color: var(--border-bright); transform: translateY(-2px); }
  .cd-related-name { font-weight: 700; }
  .cd-related-tag { font-size: 0.82rem; color: var(--text-mid); }

  .cd-prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }
  .cd-prev-next a {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    text-decoration: none;
    color: inherit;
  }
  .cd-prev-next a:hover { border-color: var(--border-bright); }
  .cd-prev-next .pn-next { text-align: right; }
  .pn-dir {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .pn-title { font-weight: 700; font-size: 0.95rem; }
  @media (max-width: 640px) {
    .cd-head { grid-template-columns: 1fr; }
    .cd-prev-next { grid-template-columns: 1fr; }
  }
</style>
