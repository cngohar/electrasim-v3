---
import { ClientRouter } from 'astro:transitions';
import EmojiIcon from '../components/EmojiIcon.astro';
import '../styles/global.css';
/* Shared full-bleed stage + instrument-panel shell for the Electrical Toolbox.
   Previously imported from global.css, which pushed 35.8 KB of `.ts-*` geometry
   onto all 134 routes when only the two tool pages use it. */
import '../styles/tool-stage.css';
import packageMetadata from '../../../package.json';
import { metaDescription, metaTitle } from '../lib/seo';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string[];
  robots?: string;
  contentSecurityPolicy?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title: rawTitle,
  description: rawDescription,
  canonical,
  keywords = [],
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
  contentSecurityPolicy,
  ogImage = 'https://electrasim.com/og-image.png',
  ogType = 'website',
  structuredData,
} = Astro.props;

/* Same clamp Base.astro applies: the toolbox pages do not route through Base,
   and the registry descriptions run well past a search snippet. */
const description = metaDescription(rawDescription);
const title = metaTitle(rawTitle);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  {contentSecurityPolicy && <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />}
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#2563eb" />
  <script is:inline src={`/js/theme.js?v=${packageMetadata.version}`}></script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  <meta name="author" content="ElectraSim" />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="google-site-verification" content="OjfkIUfSKhmhu6iuwXIaBisuhtpoTxAZgx35acQko2I" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="ElectraSim Electrical Toolbox" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {ogImage.startsWith('https://') && <meta property="og:image:secure_url" content={ogImage} />}
  <meta property="og:image:width" content="1736" />
  <meta property="og:image:height" content="906" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@electrasim" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/pwa-192.svg" />

  <!-- Display & Body Fonts Preloads -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />

  <!-- Structured Data JSON-LD Graph -->
  {structuredData && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
  <ClientRouter />
</head>
<body class="tool-app-body">
  <slot />

  <!-- Slim footer for toolbox pages (the app shell has no global footer) -->
  <footer class="tool-app-footer" role="contentinfo">
    <div class="tool-app-footer-in">
      <span class="tool-app-footer-brand"><EmojiIcon name="bolt" /> ElectraSim — free, in your browser</span>
      <nav class="tool-app-footer-links" aria-label="Site links">
        <a href="/">Home</a>
        <a href="/updates/">Product updates</a>
        <a href="/blog/">Blog</a>
        <a href="/guide/">Guide</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style is:global>
  .tool-app-body {
    overflow-x: hidden;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background: var(--bg);
  }
  .tool-app-footer {
    border-top: 1px solid var(--border, #e2e8f0);
    background: var(--bg, #ffffff);
    padding: 0.9rem 1.25rem;
  }
  .tool-app-footer-in {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .tool-app-footer-brand {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-dim, #64748b);
  }
  .tool-app-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .tool-app-footer-links a {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-mid, #475569);
    text-decoration: none;
  }
  .tool-app-footer-links a:hover {
    color: var(--blue, #2563eb);
    text-decoration: underline;
  }
  :root[data-theme='dark'] .tool-app-footer {
    background: #050811;
    border-color: #1e293b;
  }
</style>
