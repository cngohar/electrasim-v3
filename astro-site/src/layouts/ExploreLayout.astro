---
import LightExplorerLayout from './LightExplorerLayout.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  currentModel?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  ogImage,
  structuredData,
} = Astro.props;

const schemaArray = structuredData ? [structuredData] : undefined;
---

<LightExplorerLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  structuredData={schemaArray}
>
  <slot />
</LightExplorerLayout>
