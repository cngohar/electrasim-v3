---
import { ClientRouter } from 'astro:transitions';
import FloatingContact from '../components/layout/FloatingContact.astro';
import ScrollTop from '../components/layout/ScrollTop.astro';
import SiteBackdrop from '../components/layout/SiteBackdrop.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteSearchModal from '../components/layout/SiteSearchModal.astro';
import '../styles/global.css';
import packageMetadata from '../../../package.json';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  contentSecurityPolicy?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** MIME type of the OG image, e.g. "image/png" (generated cards) */
  ogImageType?: string;
  ogType?: string;
  articleMeta?: {
    publishedTime: string;
    modifiedTime?: string;
    section?: string;
  };
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  contentSecurityPolicy,
  ogImage = 'https://electrasim.com/og-image.png',
  ogImageWidth = 1736,
  ogImageHeight = 906,
  ogType = 'website',
  articleMeta,
  ogImageType = ogImage.endsWith('.webp')
    ? 'image/webp'
    : ogImage.endsWith('.avif')
      ? 'image/avif'
      : 'image/png',
} = Astro.props;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://electrasim.com/#website',
  name: 'ElectraSim',
  url: 'https://electrasim.com/',
  description:
    'Build house-wiring circuits with MCBs, RCDs, RCBOs, switches, sockets and faults. Free in your browser—no download or sign-up.',
  publisher: {
    '@type': 'Organization',
    name: 'ElectraSim',
    url: 'https://electrasim.com/',
    logo: { '@type': 'ImageObject', url: 'https://electrasim.com/pwa-192.svg' },
  },
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  {contentSecurityPolicy && <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />}
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#3b82f6" />
  <script is:inline src={`/js/theme.js?v=${packageMetadata.version}`}></script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="ElectraSim" />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="google-site-verification" content="OjfkIUfSKhmhu6iuwXIaBisuhtpoTxAZgx35acQko2I" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="ElectraSim" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {ogImage.startsWith('https://') && <meta property="og:image:secure_url" content={ogImage} />}
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:locale" content="en_US" />
  {articleMeta && <meta property="article:published_time" content={articleMeta.publishedTime} />}
  {articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
  {articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@electrasim" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/pwa-192.svg" />

  <!-- Self-hosted display + body fonts (CSP: font-src 'self') -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />

  <!-- WebSite structured data (sitelinks searchbox + brand entity) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <ClientRouter />
  <slot name="head" />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <SiteBackdrop />
  <SiteHeader assetVersion={packageMetadata.version} />

  <slot />

  <FloatingContact />
  <SiteFooter />
  <ScrollTop assetVersion={packageMetadata.version} />
  <SiteSearchModal />
  <script is:inline defer src={`/js/schematic.js?v=${packageMetadata.version}`}></script>
  <script is:inline defer src={`/js/site-search.js?v=${packageMetadata.version}`}></script>
</body>
</html>
