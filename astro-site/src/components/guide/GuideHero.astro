---
import type { Crumb } from '../../lib/structured-data';
import EmojiIcon from '../EmojiIcon.astro';
import GuideBreadcrumbs from './GuideBreadcrumbs.astro';

interface Props {
  heading: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
  crumbs: Crumb[];
}

const { heading, description, primaryCta, secondaryCta, crumbs } = Astro.props;
const headingLines = heading.split('\n');
---

<GuideBreadcrumbs crumbs={crumbs} />

<div class="guide-hero" data-live>
  <div class="wrap">
    <span class="label">Step-by-Step Guide</span>
    <h1>{headingLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
    <p>{description}</p>
    <div class="cta-row">
      <a href="/app/" class="btn-primary"><EmojiIcon name="bolt" /> {primaryCta}</a>
      <a href="/guide/templates/#latest-features" class="btn-outline">{secondaryCta}</a>
    </div>
  </div>
</div>
