---
import EmojiIcon from '../EmojiIcon.astro';

interface Props {
  heading: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
}

const { heading, description, primaryCta, secondaryCta } = Astro.props;
const headingLines = heading.split('\n');
---

<div class="bc-wrap">
  <div class="wrap">
    <nav class="bc" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Circuit Guide</span>
    </nav>
  </div>
</div>

<div class="guide-hero" data-live>
  <div class="wrap">
    <span class="label">Step-by-Step Guide</span>
    <h1>{headingLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
    <p>{description}</p>
    <div class="cta-row">
      <a href="/app/" class="btn-primary"><EmojiIcon name="bolt" /> {primaryCta}</a>
      <a href="/guide/templates/#latest-features" class="btn-outline">{secondaryCta}</a>
    </div>
  </div>
</div>
