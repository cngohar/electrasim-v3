---
import { levelClass } from '../../lib/guide';
import type { GuideFeature, GuidedTemplate } from '../../types/pages';
import EmojiIcon from '../EmojiIcon.astro';

interface Props {
  features: GuideFeature[];
  templates: GuidedTemplate[];
}

const { features, templates } = Astro.props;
---

<section class="guide-section" id="latest-features" aria-labelledby="latest-features-h">
  <div class="guide-section-head">
    <span class="guide-kicker">Latest app workflow</span>
    <h2 id="latest-features-h">What the current ElectraSim app can do</h2>
    <p>These are the features to use before you start the older circuit walkthroughs: templates for fast starts, better wiring control, fault testing, and tools for larger diagrams.</p>
  </div>
  <div class="latest-grid">
    {features.map((feature) => (
      <article class="latest-card">
        <span class="latest-icon" aria-hidden="true"><EmojiIcon name={feature.icon} /></span>
        <h3>{feature.title}</h3>
        <p>{feature.body}</p>
      </article>
    ))}
  </div>
</section>

<section class="guide-section" aria-labelledby="workflow-h">
  <div class="guide-section-head">
    <span class="guide-kicker">Recommended workflow</span>
    <h2 id="workflow-h">Use the guide like the app is built today</h2>
    <p>Start with a template when you want a working example, then inspect, modify, fault-test, and export it as a teaching or planning artefact.</p>
  </div>
  <div class="workflow-band">
    <div class="workflow-step">
      <strong>01</strong>
      <h3>Load a template</h3>
      <p>Open Templates in the app and choose a guided circuit that matches the concept you want to learn.</p>
    </div>
    <div class="workflow-step">
      <strong>02</strong>
      <h3>Trace the paths</h3>
      <p>Run the simulation and follow live, neutral, and earth through the highlighted wire paths.</p>
    </div>
    <div class="workflow-step">
      <strong>03</strong>
      <h3>Change and test</h3>
      <p>Toggle switches, move components, reroute wires, or inject faults to see how the circuit responds.</p>
    </div>
    <div class="workflow-step">
      <strong>04</strong>
      <h3>Save or share</h3>
      <p>Export JSON, SVG, PNG, PDF/print, or a shareable URL when the diagram is ready.</p>
    </div>
  </div>
</section>

<section class="guide-section" aria-labelledby="templates-h">
  <div class="guide-section-head">
    <span class="guide-kicker">In-app guided templates</span>
    <h2 id="templates-h">Start from these built-in circuits</h2>
    <p>The app includes 18 built-in guided circuits with loaded components, wires, steps, and expected simulation outcomes. Every card below opens its guide straight inside the editor.</p>
  </div>
  <div class="template-grid">
    {templates.map((template) => (
      <a class="template-card template-card-link" href={`/app/?template=${template.id}`}>
        <div class="template-top">
          <h3>{template.title}</h3>
          <span class:list={['template-level', levelClass(template.level)]}>{template.level}</span>
        </div>
        <p>{template.body}</p>
        <span class="template-cta">Open in ElectraSim →</span>
      </a>
    ))}
  </div>
</section>

<section class="guide-section" id="circuit-walkthroughs" aria-labelledby="walkthroughs-h">
  <div class="guide-section-head">
    <span class="guide-kicker">Circuit walkthroughs</span>
    <h2 id="walkthroughs-h">Eight step-by-step practice circuits</h2>
    <p>Use these as manual exercises when you want to place each component yourself and learn the wiring path one connection at a time.</p>
  </div>
</section>
