---
/**
 * The guide breadcrumb trail, marked up as well as rendered.
 *
 * The trail was visible on eight templates and marked up on none of them, so
 * the two could drift independently. This takes the crumbs once and produces
 * both the <nav> a reader sees and the BreadcrumbList a crawler reads.
 *
 * The JSON-LD sits inside .bc-wrap rather than in <head>: schema.org data
 * blocks are valid anywhere in the document, and keeping it here means the
 * page cannot end up describing a trail it does not show. CSP is not a
 * concern — `type="application/ld+json"` is a data block, not executable
 * script, so `script-src 'self'` does not apply to it.
 *
 * Inside, and not after: guide.css strips the blog's terminal-card styling
 * with `.bc-wrap:has(+ .guide-hero)`, so anything between the two divs — even
 * a bare script tag — hands the border and shadow straight back.
 */
import { breadcrumbList, type Crumb } from '../../lib/structured-data';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<div class="bc-wrap">
  <div class="wrap">
    <nav class="bc" aria-label="Breadcrumb">
      {
        crumbs.map((crumb, index) => (
          <>
            {index === last ? (
              <span aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.path}>{crumb.name}</a>
            )}
            {index < last && <span aria-hidden="true">›</span>}
          </>
        ))
      }
    </nav>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbList(crumbs))} />
</div>
