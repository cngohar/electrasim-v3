---
/**
 * LandingReleasePopup — ElectraSim Important Announcement popup.
 *
 * Behaviour:
 *  - Appears two seconds after the website is loaded (once per user, stored in localStorage).
 *  - Persistent small trigger button on the bottom-left ("Important Announcement")
 *    that re-opens the popup whenever clicked.
 *  - Clean dismissal via "Continue" button, × button, Escape key, or backdrop click.
 *  - Confetti and fireworks removed for a professional, focused announcement.
 */
import packageMetadata from '../../../../package.json';

interface Props {
  assetVersion?: string;
}

const { assetVersion = packageMetadata.version } = Astro.props;
const storageKey = 'electrasim:announcement-paused';
---

<button
  type="button"
  id="announcement-trigger"
  class="announcement-trigger"
  aria-label="Important announcement: Development is temporarily paused"
  aria-haspopup="dialog"
  aria-controls="release-popup"
>
  <span class="announcement-trigger-bolt" aria-hidden="true">⚡</span>
  <span class="announcement-trigger-text">Important Announcement</span>
</button>

<div
  class="rp-root"
  id="release-popup"
  data-release-key={storageKey}
  hidden
>
  <div class="rp-backdrop" data-rp-close></div>

  <div
    class="rp-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rp-title"
    aria-describedby="rp-desc"
  >
    <button class="rp-x" type="button" data-rp-close aria-label="Close announcement">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
        stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div class="rp-header">
      <h2 class="rp-title" id="rp-title">⚡ Important ElectraSim Announcement</h2>
      <p class="rp-subtitle">Development is temporarily paused</p>
    </div>

    <div class="rp-body" id="rp-desc">
      <div class="rp-status-notice">
        <span class="rp-status-dot" aria-hidden="true"></span>
        <span class="rp-status-text">ElectraSim is still online and available to everyone.</span>
      </div>

      <p class="rp-p">
        As a solo developer, continuing to build and maintain ElectraSim requires more time and resources than I currently have available. Rather than rushing development or relying on short-term solutions, I’ve decided to temporarily pause active development.
      </p>

      <p class="rp-p">
        The existing ElectraSim experience will remain online, and development may resume when the necessary resources are available.
      </p>

      <p class="rp-p rp-lead-bold">
        There is also another possibility.
      </p>

      <p class="rp-p">
        If you are interested in helping continue ElectraSim, partnering on the project, using it for education or training, or potentially taking the project forward yourself, I’d be happy to hear from you.
      </p>

      <p class="rp-p">
        I’ve created a short form where you can tell me what you’re interested in.
      </p>
    </div>

    <div class="rp-actions">
      <a
        class="rp-btn-primary"
        href="https://forms.gle/fsGH4espdnssDNLJ6"
        target="_blank"
        rel="noopener noreferrer"
      >
        I’m Interested <span aria-hidden="true">→</span>
      </a>
      <button class="rp-btn-secondary" type="button" data-rp-close>
        Continue
      </button>
    </div>

    <div class="rp-footer">
      <p class="rp-footer-text">
        Thank you for supporting ElectraSim and everyone who has used, shared, and contributed feedback to the project so far. ⚡
      </p>
    </div>
  </div>
</div>

<script is:inline defer src={`/js/announcement.js?v=${assetVersion}`}></script>

<style>
  /* ── Bottom-left persistent trigger button ── */
  .announcement-trigger {
    position: fixed;
    left: 1.75rem;
    bottom: 1.75rem;
    z-index: 990;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.85rem;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-glass);
    color: var(--text);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.16);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 750;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .announcement-trigger:hover {
    border-color: var(--border-bright);
    color: var(--blue);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(37, 99, 235, 0.22);
  }

  .announcement-trigger-bolt {
    display: inline-flex;
    font-size: 0.95rem;
    color: #f59e0b;
    filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.55));
  }

  /* Hide trigger when dialog is open */
  :global(body:has(#release-popup:not([hidden]))) .announcement-trigger {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Modal Dialog ── */
  .rp-root[hidden] {
    display: none !important;
  }

  .rp-root {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }

  .rp-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(9, 14, 24, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .rp-dialog {
    position: relative;
    z-index: 2;
    width: min(92vw, 35rem);
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px rgba(4, 10, 22, 0.45);
    padding: 2.3rem 2.2rem 2rem;
    text-align: left;
    animation: rp-rise 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }

  @keyframes rp-rise {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .rp-x {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--text-mid);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .rp-x:hover {
    border-color: var(--border-bright);
    color: var(--text);
    background: var(--bg-3);
  }

  .rp-x svg {
    width: 16px;
    height: 16px;
  }

  .rp-header {
    margin-bottom: 1.15rem;
    padding-right: 1.8rem;
  }

  .rp-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 3.8vw, 1.7rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 0.45rem;
  }

  .rp-subtitle {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    color: #f59e0b;
    letter-spacing: -0.01em;
  }

  :global(:root[data-theme="dark"]) .rp-subtitle {
    color: var(--amber);
  }

  .rp-body {
    color: var(--body-copy);
  }

  .rp-status-notice {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.28);
    margin-bottom: 1.1rem;
  }

  :global(:root[data-theme="dark"]) .rp-status-notice {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.38);
  }

  .rp-status-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.65);
    flex-shrink: 0;
  }

  .rp-status-text {
    font-size: 0.91rem;
    font-weight: 650;
    color: var(--text);
    line-height: 1.4;
  }

  .rp-p {
    font-family: var(--font-sans);
    color: var(--body-copy);
    font-size: 0.93rem;
    line-height: 1.68;
    margin-bottom: 0.85rem;
  }

  .rp-lead-bold {
    font-weight: 750;
    color: var(--text);
    font-size: 0.97rem;
    margin-top: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .rp-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.6rem 0 1.25rem;
    flex-wrap: wrap;
  }

  .rp-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.8rem 1.65rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.96rem;
    color: #ffffff;
    background: linear-gradient(120deg, #1d4ed8, #2563eb 55%, #3b82f6);
    box-shadow: 0 10px 26px rgba(37, 99, 235, 0.35);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
  }

  .rp-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(37, 99, 235, 0.45);
    filter: brightness(1.06);
    color: #ffffff;
  }

  .rp-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.65rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 0.96rem;
    color: var(--text);
    background: var(--bg-2);
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .rp-btn-secondary:hover {
    background: var(--bg-3);
    border-color: var(--border-bright);
    transform: translateY(-1px);
  }

  .rp-footer {
    border-top: 1px solid var(--border);
    padding-top: 0.95rem;
    margin-top: 0.5rem;
  }

  .rp-footer-text {
    font-family: var(--font-sans);
    font-size: 0.83rem;
    color: var(--text-mid);
    line-height: 1.6;
    margin: 0;
  }

  .announcement-trigger:focus-visible,
  .rp-x:focus-visible,
  .rp-btn-primary:focus-visible,
  .rp-btn-secondary:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .announcement-trigger {
      left: 1rem;
      bottom: 1rem;
      min-height: 2.7rem;
      padding: 0.6rem 0.95rem;
      font-size: 0.8rem;
    }

    .rp-dialog {
      padding: 1.8rem 1.3rem 1.5rem;
      width: min(94vw, 35rem);
    }

    .rp-actions {
      flex-direction: column;
      width: 100%;
    }

    .rp-btn-primary,
    .rp-btn-secondary {
      width: 100%;
    }
  }

  @media print {
    .announcement-trigger,
    .rp-root {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-dialog {
      animation: none !important;
    }
    .announcement-trigger,
    .rp-btn-primary,
    .rp-btn-secondary {
      transition: none !important;
    }
  }
</style>
