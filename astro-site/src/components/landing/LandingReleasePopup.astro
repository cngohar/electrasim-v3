---
/**
 * LandingReleasePopup — the "ElectraSim 2.0 is here" announcement card.
 *
 * Behaviour:
 *  - Appears on the homepage two seconds after the page loads.
 *  - Shown once per user (localStorage, keyed by release version — bump the
 *    version and the next release gets its own moment).
 *  - On screens ≥ 768 px, and only when the user hasn't asked for reduced
 *    motion, a canvas behind the card runs confetti falling from the top and
 *    continuous fireworks launched from random bottom positions. The show
 *    stops the moment the popup closes. Smaller screens get the card only —
 *    no canvas is ever created there.
 *  - Close: "Continue exploring" button, × button, Escape, or backdrop click.
 */
import packageMetadata from '../../../package.json';
import Icon from '../Icon.astro';

const raw = packageMetadata.version; // e.g. "2.0.1"
const [major, minor, patch] = raw.split('.');
const displayVersion = patch && patch !== '0' ? `${major}.${minor}.${patch}` : `${major}.${minor}`;
const storageKey = `electrasim:release-popup:${raw}`;
---

<div
  class="rp-root"
  id="release-popup"
  data-release-key={storageKey}
  data-release-version={displayVersion}
  hidden
>
  <div class="rp-backdrop" data-rp-close></div>
  <canvas class="rp-canvas" id="rp-canvas" aria-hidden="true"></canvas>

  <div
    class="rp-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rp-title"
    aria-describedby="rp-desc"
  >
    <button class="rp-x" type="button" data-rp-close aria-label="Close release announcement">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
        stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <p class="rp-kicker">Now shipping</p>

    <div class="rp-version" id="rp-title" aria-label={`ElectraSim version ${displayVersion}`}>
      <span class="rp-spark rp-spark-left" aria-hidden="true">
        <Icon name="bolt" size={30} stroke={2.2} />
      </span>
      <span class="rp-vtext">v{displayVersion}</span>
      <span class="rp-spark rp-spark-right" aria-hidden="true">
        <Icon name="bolt" size={30} stroke={2.2} />
      </span>
    </div>

    <p class="rp-desc" id="rp-desc">
      The learning release is live: Challenge Mode, the Diagnosis Lab and Ohmageddon join
      Guided Circuits, a live Fault Lab and the Electrical Toolbox — free, offline, no sign-up.
    </p>

    <div class="rp-actions">
      <button class="rp-continue" type="button" data-rp-close>
        Continue exploring
        <span aria-hidden="true">&#8594;</span>
      </button>
      <a class="rp-notes" href="/updates/electrasim-2-0-release/">Read the full release notes</a>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('release-popup') as HTMLElement | null;

  if (root) {
    const canvas = document.getElementById('rp-canvas') as HTMLCanvasElement | null;
    const bigScreen = window.matchMedia('(min-width: 768px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Astro front-matter does not cross into <script>; the storage key rides
    // in on the root element instead.
    const releaseStorageKey = root.dataset.releaseKey ?? 'electrasim:release-popup';

    let frameId: number | null = null;
    let stopped = true;

    // ── Particle engine (confetti from the top, fireworks from the bottom) ──
    // All coordinates are CSS pixels; the canvas scale transform handles DPR.
    let vw = 0;
    let vh = 0;

    type Particle = {
      kind: 'confetti' | 'rocket' | 'spark';
      x: number; y: number; vx: number; vy: number;
      life: number; maxLife: number;
      w: number; h: number; rot: number; vr: number;
      hue: number; sat: number; light: number;
      sway: number; swayPhase: number;
      color?: string;
    };

    const CONFETTI_COLORS = ['#2563eb', '#f59e0b', '#fbbf24', '#93c5fd', '#ffffff', '#38bdf8'];
    const FIREWORK_HUES = [28, 42, 212, 224, 262, 0]; // amber, gold, ElectraSim blue, sky, violet, red-white

    let particles: Particle[] = [];
    let confettiQueue = 0;
    let nextRocketAt = 0;

    function spawnConfetti() {
      particles.push({
        kind: 'confetti',
        x: Math.random() * vw,
        y: -20 - Math.random() * 40,
        vx: (Math.random() - 0.5) * 0.6,
        vy: 1.6 + Math.random() * 2.2,
        life: 0, maxLife: 480,
        w: 6 + Math.random() * 5, h: 9 + Math.random() * 7,
        rot: Math.random() * Math.PI * 2, vr: (Math.random() - 0.5) * 0.22,
        hue: 0, sat: 0, light: 0,
        sway: 0.6 + Math.random() * 1.1, swayPhase: Math.random() * Math.PI * 2,
        color: CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)],
      });
    }

    function spawnRocket() {
      particles.push({
        kind: 'rocket',
        x: vw * (0.08 + Math.random() * 0.84), // random bottom position
        y: vh + 10,
        vx: (Math.random() - 0.5) * 0.9,
        vy: -(5.2 + Math.random() * 3.4),
        life: 0, maxLife: 46 + Math.random() * 34,
        w: 2.4, h: 2.4, rot: 0, vr: 0,
        hue: FIREWORK_HUES[Math.floor(Math.random() * FIREWORK_HUES.length)],
        sat: 90, light: 62,
        sway: 0, swayPhase: 0,
      });
    }

    function explode(p: Particle) {
      const count = 42 + Math.floor(Math.random() * 30);
      const power = 1.6 + Math.random() * 2.6;
      for (let i = 0; i < count; i++) {
        const angle = (i / count) * Math.PI * 2 + Math.random() * 0.2;
        const speed = power * (0.35 + Math.random() * 0.75);
        particles.push({
          kind: 'spark',
          x: p.x, y: p.y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 0, maxLife: 52 + Math.random() * 38,
          w: 1.6 + Math.random() * 1.6, h: 0, rot: 0, vr: 0,
          hue: p.hue + (Math.random() - 0.5) * 18,
          sat: p.sat, light: p.light,
          sway: 0, swayPhase: 0,
        });
      }
    }

    function tick(now: number) {
      if (stopped || !canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.clearRect(0, 0, vw, vh);

      // Staggered confetti shower for the first ~2.4 s after opening.
      if (confettiQueue > 0 && particles.filter((p) => p.kind === 'confetti').length < 170) {
        const burst = Math.min(confettiQueue, 2 + Math.floor(Math.random() * 2));
        for (let i = 0; i < burst; i++) spawnConfetti();
        confettiQueue -= burst;
      }

      // Fireworks: keep launching from random bottom spots until closed.
      if (now >= nextRocketAt) {
        spawnRocket();
        nextRocketAt = now + 480 + Math.random() * 620;
      }

      const survivors: Particle[] = [];
      for (const p of particles) {
        p.life += 1;
        if (p.kind === 'confetti') {
          p.swayPhase += 0.045;
          p.x += p.vx + Math.sin(p.swayPhase) * p.sway;
          p.y += p.vy;
          p.rot += p.vr;
          if (p.y < vh + 30) survivors.push(p);
        } else if (p.kind === 'rocket') {
          p.x += p.vx;
          p.y += p.vy;
          p.vy *= 0.985;
          if (p.life >= p.maxLife || p.vy > -1.4) {
            explode(p); // fuse spent — becomes a burst, the rocket itself is gone
          } else {
            survivors.push(p);
          }
        } else {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.045; // gravity pulls the burst back down
          p.vx *= 0.985;
          p.vy *= 0.985;
          if (p.life < p.maxLife) survivors.push(p);
        }
      }
      particles = survivors;

      // ── draw ──
      ctx.globalCompositeOperation = 'source-over';
      for (const p of particles) {
        if (p.kind !== 'confetti') continue;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color ?? '#2563eb';
        ctx.globalAlpha = 0.92;
        ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h * (0.35 + Math.abs(Math.sin(p.swayPhase)) * 0.65));
        ctx.restore();
      }

      ctx.globalCompositeOperation = 'lighter';
      for (const p of particles) {
        if (p.kind === 'confetti') continue;
        const fade = p.kind === 'rocket' ? 1 : Math.max(0, 1 - p.life / p.maxLife);
        if (fade <= 0) continue;
        ctx.globalAlpha = fade;
        ctx.fillStyle = `hsl(${p.hue} ${p.sat}% ${p.light}%)`;
        if (p.kind === 'rocket') {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.w, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = fade * 0.35;
          ctx.fillRect(p.x - 0.8, p.y, 1.6, 12); // rising trail
        } else {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.w, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';

      frameId = requestAnimationFrame(tick);
    }

    function resizeCanvas() {
      if (!canvas) return;
      vw = window.innerWidth;
      vh = window.innerHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(vw * dpr);
      canvas.height = Math.floor(vh * dpr);
      const ctx = canvas.getContext('2d');
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function startFx() {
      if (!canvas || !stopped) return;
      resizeCanvas();
      confettiQueue = 150;
      particles = [];
      nextRocketAt = performance.now() + 250;
      stopped = false;
      frameId = requestAnimationFrame(tick);
    }

    function stopFx() {
      stopped = true;
      if (frameId !== null) cancelAnimationFrame(frameId);
      frameId = null;
      particles = [];
      if (canvas) {
        const ctx = canvas.getContext('2d');
        ctx?.clearRect(0, 0, canvas.width, canvas.height);
      }
    }

    // ── Dialog lifecycle ──
    let previouslyFocused: HTMLElement | null = null;

    function close() {
      stopFx();
      window.removeEventListener('resize', resizeCanvas);
      root?.setAttribute('hidden', '');
      try {
        window.localStorage.setItem(releaseStorageKey, 'shown');
      } catch {
        /* private mode — the popup may show again; harmless */
      }
      previouslyFocused?.focus?.();
    }

    function open() {
      if (!root) return;
      previouslyFocused = document.activeElement as HTMLElement | null;
      root.removeAttribute('hidden');
      try {
        // Set at open time: a refresh mid-popup must not replay the show.
        window.localStorage.setItem(releaseStorageKey, 'shown');
      } catch {
        /* ignore */
      }
      const animationsAllowed = bigScreen.matches && !reduceMotion.matches;
      if (animationsAllowed) {
        window.addEventListener('resize', resizeCanvas);
        startFx();
      }
      (root.querySelector('.rp-continue') as HTMLButtonElement | null)?.focus?.();
    }

    let alreadyShown = false;
    try {
      alreadyShown = window.localStorage.getItem(releaseStorageKey) === 'shown';
    } catch {
      alreadyShown = false;
    }

    if (!alreadyShown) {
      const launch = () => window.setTimeout(open, 2000);
      if (document.readyState === 'complete') launch();
      else window.addEventListener('load', launch, { once: true });
    }

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-rp-close]')) close();
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
      if (event.key === 'Tab') {
        // Two focusables — wrap focus inside the dialog.
        const focusables = Array.from(
          root.querySelectorAll<HTMLElement>('.rp-continue, .rp-x'),
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>

<style>
  .rp-root[hidden] {
    display: none !important;
  }
  .rp-root {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }
  .rp-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(9, 14, 24, 0.58);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }
  .rp-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .rp-dialog {
    position: relative;
    z-index: 2;
    width: min(92vw, 34rem);
    max-height: calc(100vh - 3rem);
    overflow: auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 30px 80px rgba(4, 10, 22, 0.45);
    padding: 2.4rem 2.2rem 2.1rem;
    text-align: center;
    animation: rp-rise 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }
  @keyframes rp-rise {
    from {
      opacity: 0;
      transform: translateY(26px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .rp-x {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    width: 2.1rem;
    height: 2.1rem;
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--text-mid);
    cursor: pointer;
  }
  .rp-x:hover {
    border-color: var(--border-bright);
    color: var(--text);
  }
  .rp-x svg {
    width: 15px;
    height: 15px;
  }

  .rp-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-mid);
    margin-bottom: 0.4rem;
  }

  /* ── The big version, lit by electrical pulses ── */
  .rp-version {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.2rem, 13vw, 7.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0.2rem 0 1.1rem;
    filter: drop-shadow(0 0 20px rgba(37, 99, 235, 0.4));
  }
  .rp-vtext {
    display: inline-block;
    background: linear-gradient(
      110deg,
      #1d4ed8 0%,
      #2563eb 30%,
      #60a5fa 44%,
      #ffffff 50%,
      #f59e0b 56%,
      #2563eb 70%,
      #1d4ed8 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: rp-sweep 3s linear infinite;
  }
  .rp-spark {
    color: #f59e0b;
    display: inline-flex;
    animation: rp-flicker 1.7s steps(1, end) infinite;
    filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.55));
  }
  .rp-spark-left {
    animation-delay: -0.4s;
  }
  .rp-spark-right {
    animation-delay: -1.1s;
  }
  @keyframes rp-sweep {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }
  @keyframes rp-flicker {
    0%, 100% { opacity: 1; transform: scale(1); }
    8% { opacity: 0.35; transform: scale(0.86); }
    12% { opacity: 1; transform: scale(1.08); }
    46% { opacity: 0.55; }
    52% { opacity: 1; }
    74% { opacity: 0.3; transform: scale(0.9); }
    78% { opacity: 1; transform: scale(1.04); }
  }

  .rp-desc {
    color: var(--text-mid);
    font-size: 0.94rem;
    line-height: 1.65;
    max-width: 26rem;
    margin: 0 auto 1.6rem;
  }

  .rp-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .rp-continue {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.7rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: #fff;
    background: linear-gradient(120deg, #1d4ed8, #2563eb 55%, #3b82f6);
    box-shadow: 0 10px 26px rgba(37, 99, 235, 0.35);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .rp-continue:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(37, 99, 235, 0.45);
  }
  .rp-notes {
    font-size: 0.84rem;
    color: var(--text-mid);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rp-notes:hover {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-dialog,
    .rp-vtext,
    .rp-spark {
      animation: none !important;
    }
    .rp-vtext {
      filter: none;
    }
  }
</style>
