---
interface Props {
  currentModel?: string;
}

const { currentModel = 'Edison Bulb (1879)' } = Astro.props;
---

<header class="explore-nav-bar" role="banner">
  <div class="exp-nav-left">
    <a href="/explore/" class="exp-nav-brand" title="Explore 3D Historical Hub">
      <div class="exp-brand-icon" aria-hidden="true">⚡</div>
      <div class="exp-brand-text">
        <span class="exp-brand-title">Electra<span class="brand-blue">Sim</span></span>
        <span class="exp-brand-sub">EXPLORE 3D <span class="exp-sub-badge">EXPERIMENTAL</span></span>
      </div>
    </a>

    <div class="exp-nav-divider hide-mobile"></div>

    <div class="exp-model-selector hide-mobile">
      <span class="exp-model-icon">💡</span>
      <span class="exp-model-name">{currentModel}</span>
      <span class="exp-model-tag">FOUNDATION</span>
    </div>
  </div>

  <div class="exp-nav-center hide-tablet">
    <nav class="exp-quick-links" aria-label="Explore Navigation">
      <a href="/explore/" class="exp-quick-link">Overview</a>
      <a href="/explore/edison-bulb/" class="exp-quick-link active">3D Edison Explorer</a>
      <a href="/explore/edison-bulb/#tab-timeline-content" class="exp-quick-link">Timeline</a>
      <a href="/explore/edison-bulb/#tab-specs-content" class="exp-quick-link">Tech Specs</a>
    </nav>
  </div>

  <div class="exp-nav-right">
    <button
      type="button"
      class="exp-action-btn"
      data-exp-search
      title="Search Explore 3D (Ctrl + K)"
      aria-label="Open Explore Search"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="hide-sm">Search</span>
      <kbd class="exp-kbd hide-sm">⌘K</kbd>
    </button>

    <button
      type="button"
      class="exp-action-btn hide-xs"
      data-theme-toggle
      title="Toggle Appearance"
      aria-label="Toggle dark/light mode"
    >
      <span class="theme-icon-sun">☀️</span>
      <span class="theme-icon-moon">🌙</span>
    </button>

    <a href="/" class="exp-back-btn hide-xs" title="Return to ElectraSim Homepage">
      <span>Main Site</span>
      <span aria-hidden="true">→</span>
    </a>

    <!-- Mobile Drawer Menu Toggle Button -->
    <button
      type="button"
      id="exp-mobile-nav-toggle"
      class="exp-mobile-toggle show-mobile"
      aria-label="Open Explore Mobile Menu"
      aria-expanded="false"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Overlay Menu -->
  <div id="exp-mobile-menu" class="exp-mobile-menu" hidden>
    <a href="/explore/" class="exp-mobile-link">⚡ Overview</a>
    <a href="/explore/edison-bulb/" class="exp-mobile-link">💡 3D Edison Explorer</a>
    <a href="/explore/edison-bulb/#tab-timeline-content" class="exp-mobile-link">📜 Timeline Guide</a>
    <a href="/explore/edison-bulb/#tab-specs-content" class="exp-mobile-link">📋 Tech Specs</a>
    <a href="/" class="exp-mobile-link highlight">← Back to ElectraSim Main Site</a>
  </div>
</header>

<script>
  function initExploreMobileNav() {
    const toggle = document.getElementById('exp-mobile-nav-toggle');
    const menu = document.getElementById('exp-mobile-menu');

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = !menu.hidden;
        menu.hidden = isOpen;
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initExploreMobileNav();
  } else {
    document.addEventListener('DOMContentLoaded', initExploreMobileNav);
  }
</script>

<style>
  .explore-nav-bar {
    height: 3.8rem;
    background: rgba(11, 17, 32, 0.95);
    border-bottom: 1px solid rgba(56, 189, 248, 0.25);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    position: relative;
    z-index: 50;
    user-select: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }
  .exp-nav-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .exp-nav-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #ffffff;
  }
  .exp-brand-icon {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.4);
  }
  .exp-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .exp-brand-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .brand-blue {
    color: #38bdf8;
  }
  .exp-brand-sub {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    font-weight: 800;
    color: #06b6d4;
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .exp-sub-badge {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #000000;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-size: 0.58rem;
  }
  .exp-nav-divider {
    width: 1px;
    height: 22px;
    background: rgba(56, 189, 248, 0.2);
  }
  .exp-model-selector {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 0.55rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #f8fafc;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .exp-model-icon {
    font-size: 0.95rem;
  }
  .exp-model-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    font-weight: 800;
    color: #10b981;
    background: rgba(16, 185, 129, 0.15);
    padding: 0.12rem 0.4rem;
    border-radius: 999px;
  }

  /* Center Quick Links */
  .exp-quick-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(15, 23, 42, 0.7);
    padding: 0.25rem;
    border-radius: 0.65rem;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }
  .exp-quick-link {
    padding: 0.35rem 0.85rem;
    border-radius: 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }
  .exp-quick-link:hover {
    color: #ffffff;
    background: rgba(30, 41, 59, 0.8);
  }
  .exp-quick-link.active {
    background: #0284c7;
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
  }

  /* Right Actions */
  .exp-nav-right {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .exp-action-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border-radius: 0.55rem;
    border: 1px solid rgba(56, 189, 248, 0.25);
    background: rgba(15, 23, 42, 0.8);
    color: #cbd5e1;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .exp-action-btn:hover {
    background: rgba(30, 41, 59, 0.9);
    border-color: #38bdf8;
    color: #ffffff;
  }
  .exp-kbd {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    padding: 0.12rem 0.35rem;
    border-radius: 0.3rem;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
  }
  .exp-back-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 0.55rem;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .exp-back-btn:hover {
    background: rgba(51, 65, 85, 0.9);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .exp-mobile-toggle {
    display: none;
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: #0f172a;
    color: #ffffff;
    cursor: pointer;
  }

  /* Mobile Menu */
  .exp-mobile-menu {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    background: #0b1120;
    border-bottom: 1px solid rgba(56, 189, 248, 0.3);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
    z-index: 60;
  }
  .exp-mobile-menu[hidden] {
    display: none;
  }
  .exp-mobile-link {
    padding: 0.65rem 1rem;
    border-radius: 0.5rem;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .exp-mobile-link.highlight {
    background: rgba(6, 182, 212, 0.15);
    border-color: rgba(6, 182, 212, 0.4);
    color: #38bdf8;
  }

  @media (max-width: 980px) {
    .hide-tablet {
      display: none !important;
    }
    .hide-mobile {
      display: none !important;
    }
    .show-mobile {
      display: flex !important;
    }
  }
  @media (max-width: 540px) {
    .hide-sm {
      display: none !important;
    }
    .hide-xs {
      display: none !important;
    }
  }
</style>
