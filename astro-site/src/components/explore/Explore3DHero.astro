---
import EmojiIcon from '../EmojiIcon.astro';
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Explore Electrical History in Immersive 3D',
  subtitle = 'Step inside history’s most ground-breaking electrical inventions. Examine verified technical specifications, historical timelines, exploded assemblies, and real physical simulation in 3D.',
} = Astro.props;
---

<section class="explore-hero explore-hero-dark">
  <div class="electric-arc-line"></div>
  <div class="wrap explore-hero-container">
    <div class="explore-hero-content">
      <div class="explore-badge-lab">
        <span class="badge-icon"><EmojiIcon name="bolt" /></span>
        <span class="badge-text">EXPERIMENTAL 3D LABORATORY</span>
      </div>

      <h1 class="explore-title-dark">{title}</h1>
      <p class="explore-subtitle-dark">{subtitle}</p>

      <div class="explore-actions">
        <a href="/explore/edison-bulb/" class="btn-explore-cyan">
          <span class="btn-icon"><EmojiIcon name="bulb" /></span>
          <span>Explore Edison Bulb (1879)</span>
          <span class="arrow">→</span>
        </a>
        <a href="#historical-foundation" class="btn-explore-outline">
          <span>Historical Foundation & Roadmap</span>
          <span class="arrow">↓</span>
        </a>
      </div>

      <div class="explore-stats-strip-dark">
        <div class="stat-item">
          <span class="stat-num-cyan">1879</span>
          <span class="stat-lbl-dark">Edison Patent Foundation</span>
        </div>
        <div class="stat-divider-dark"></div>
        <div class="stat-item">
          <span class="stat-num-amber">5 Modes</span>
          <span class="stat-lbl-dark">Assembly, Cutaway, Exploded, Isolate, Lab</span>
        </div>
        <div class="stat-divider-dark"></div>
        <div class="stat-item">
          <span class="stat-num-cyan">3D WebGL</span>
          <span class="stat-lbl-dark">60 FPS Real-Time Physics</span>
        </div>
      </div>
    </div>

    <!-- 3D Interactive Hero Canvas with Corner Ribbon -->
    <div class="explore-hero-stage ribbon-wrapper">
      <div class="exp-ribbon">EXPERIMENTAL</div>
      <div class="hero-canvas-frame glowing-electric-border" id="hero-3d-frame">
        <canvas id="hero-3d-canvas" class="hero-canvas"></canvas>

        <div class="hero-stage-overlay">
          <div class="stage-tag-neon">FOUNDATION MODEL · EDISON LAMP (1879)</div>
          <div class="stage-controls-hint-dark">
            <span><EmojiIcon name="mouse" /> Click & Drag to Rotate · Scroll to Zoom</span>
          </div>
        </div>

        <div class="hero-light-toggle">
          <button type="button" id="hero-light-switch" class="hero-switch-btn-dark" aria-label="Toggle Bulb Light">
            <span class="switch-dot-neon"></span>
            <span class="switch-lbl">Bulb Power: <strong id="hero-power-status" style="color: #f59e0b;">ON</strong></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';

  function initHero3D() {
    const canvas = document.getElementById('hero-3d-canvas') as HTMLCanvasElement | null;
    const container = document.getElementById('hero-3d-frame');
    const toggleBtn = document.getElementById('hero-light-switch');
    const statusText = document.getElementById('hero-power-status');

    if (!canvas || !container) return;

    let width = container.clientWidth || 500;
    let height = container.clientHeight || 400;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 1000);
    camera.position.set(0, 0, 8.5);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const bulbGroup = new THREE.Group();
    scene.add(bulbGroup);

    let isLit = true;
    let isVisible = true;
    let animationFrameId: number | null = null;

    // Materials
    const glassMat = new THREE.MeshPhysicalMaterial({
      color: 0x38bdf8,
      transparent: true,
      opacity: 0.28,
      roughness: 0.1,
      metalness: 0.1,
      transmission: 0.85,
      ior: 1.5,
      reflectivity: 0.9,
      clearcoat: 1.0,
      side: THREE.DoubleSide,
    });

    const filamentMat = new THREE.MeshStandardMaterial({
      color: isLit ? 0xffaa33 : 0x222222,
      emissive: isLit ? 0xff8800 : 0x000000,
      emissiveIntensity: isLit ? 3.5 : 0,
      roughness: 0.3,
      metalness: 0.8,
    });

    const wireMat = new THREE.MeshStandardMaterial({
      color: 0xe2e8f0,
      metalness: 0.9,
      roughness: 0.2,
    });

    const brassMat = new THREE.MeshStandardMaterial({
      color: 0xd4af37,
      metalness: 0.85,
      roughness: 0.25,
    });

    const copperMat = new THREE.MeshStandardMaterial({
      color: 0xb87333,
      metalness: 0.9,
      roughness: 0.2,
    });

    const insulatorMat = new THREE.MeshStandardMaterial({
      color: 0x111827,
      roughness: 0.85,
    });

    // 1. Glass Envelope
    const glassGeo = new THREE.SphereGeometry(1.6, 32, 32);
    const pos = glassGeo.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      let y = pos.getY(i);
      if (y < 0) {
        let factor = 1 + y * 0.22;
        pos.setX(i, pos.getX(i) * factor);
        pos.setZ(i, pos.getZ(i) * factor);
      }
    }
    glassGeo.computeVertexNormals();
    const glassMesh = new THREE.Mesh(glassGeo, glassMat);
    glassMesh.position.y = 0.6;
    bulbGroup.add(glassMesh);

    // 2. Glass Stem
    const stemGeo = new THREE.CylinderGeometry(0.35, 0.45, 1.4, 24);
    const stemMesh = new THREE.Mesh(stemGeo, glassMat);
    stemMesh.position.y = -0.4;
    bulbGroup.add(stemMesh);

    // 3. Lead Wires
    const leadGeoLeft = new THREE.CylinderGeometry(0.03, 0.03, 1.8, 12);
    const leadLeft = new THREE.Mesh(leadGeoLeft, wireMat);
    leadLeft.position.set(-0.22, 0.1, 0);
    bulbGroup.add(leadLeft);

    const leadRight = new THREE.Mesh(leadGeoLeft, wireMat);
    leadRight.position.set(0.22, 0.1, 0);
    bulbGroup.add(leadRight);

    // 4. Platinum Support Wires
    const supportCurveLeft = new THREE.CatmullRomCurve3([
      new THREE.Vector3(-0.22, 0.9, 0),
      new THREE.Vector3(-0.35, 1.2, 0),
      new THREE.Vector3(-0.15, 1.35, 0),
    ]);
    const supportLeft = new THREE.Mesh(new THREE.TubeGeometry(supportCurveLeft, 20, 0.02, 8, false), wireMat);
    bulbGroup.add(supportLeft);

    const supportCurveRight = new THREE.CatmullRomCurve3([
      new THREE.Vector3(0.22, 0.9, 0),
      new THREE.Vector3(0.35, 1.2, 0),
      new THREE.Vector3(0.15, 1.35, 0),
    ]);
    const supportRight = new THREE.Mesh(new THREE.TubeGeometry(supportCurveRight, 20, 0.02, 8, false), wireMat);
    bulbGroup.add(supportRight);

    // 5. Filament
    const filamentPoints: THREE.Vector3[] = [];
    for (let i = 0; i <= 32; i++) {
      const t = (i / 32) * Math.PI;
      const x = -Math.cos(t) * 0.28;
      const y = 1.35 + Math.sin(t) * 0.55;
      const z = Math.sin(t * 4) * 0.04;
      filamentPoints.push(new THREE.Vector3(x, y, z));
    }
    const filamentMesh = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(filamentPoints), 40, 0.035, 12, false), filamentMat);
    bulbGroup.add(filamentMesh);

    // 6. Base Shell
    const baseMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.72, 0.72, 1.1, 32), brassMat);
    baseMesh.position.y = -1.55;
    bulbGroup.add(baseMesh);

    for (let i = 0; i < 4; i++) {
      const ring = new THREE.Mesh(new THREE.TorusGeometry(0.74, 0.06, 12, 32), brassMat);
      ring.rotation.x = Math.PI / 2;
      ring.position.y = -1.2 - i * 0.22;
      bulbGroup.add(ring);
    }

    // 7. Base Insulator
    const insMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.68, 0.68, 0.15, 32), insulatorMat);
    insMesh.position.y = -2.15;
    bulbGroup.add(insMesh);

    // 8. Copper Contact Foot
    const contactMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.1, 0.25, 24), copperMat);
    contactMesh.position.y = -2.3;
    bulbGroup.add(contactMesh);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0x38bdf8, 1.5);
    dirLight1.position.set(5, 8, 5);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0xa855f7, 0.8);
    dirLight2.position.set(-5, -5, -3);
    scene.add(dirLight2);

    const pointLight = new THREE.PointLight(0xff9900, isLit ? 4.5 : 0, 15);
    pointLight.position.set(0, 1.4, 0);
    scene.add(pointLight);

    // Glow Halo Sprite
    const canvasGlow = document.createElement('canvas');
    canvasGlow.width = 128;
    canvasGlow.height = 128;
    const ctx = canvasGlow.getContext('2d');
    if (ctx) {
      const grad = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
      grad.addColorStop(0, 'rgba(255, 180, 50, 0.95)');
      grad.addColorStop(0.35, 'rgba(255, 120, 0, 0.45)');
      grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 128, 128);
    }
    const glowTex = new THREE.CanvasTexture(canvasGlow);
    const glowMat = new THREE.SpriteMaterial({
      map: glowTex,
      transparent: true,
      blending: THREE.AdditiveBlending,
      opacity: isLit ? 0.85 : 0,
    });
    const glowSprite = new THREE.Sprite(glowMat);
    glowSprite.position.set(0, 1.4, 0);
    glowSprite.scale.set(3.2, 3.2, 1);
    bulbGroup.add(glowSprite);

    // Controls
    let isDragging = false;
    let prevMousePos = { x: 0, y: 0 };

    canvas.addEventListener('pointerdown', (e) => {
      isDragging = true;
      prevMousePos = { x: e.clientX, y: e.clientY };
    });
    window.addEventListener('pointerup', () => (isDragging = false));

    canvas.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - prevMousePos.x;
      const deltaY = e.clientY - prevMousePos.y;

      bulbGroup.rotation.y += deltaX * 0.008;
      bulbGroup.rotation.x += deltaY * 0.008;

      prevMousePos = { x: e.clientX, y: e.clientY };
    });

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      camera.position.z += e.deltaY * 0.005;
      camera.position.z = Math.max(4.5, Math.min(camera.position.z, 14));
    }, { passive: false });

    function setLightState(lit: boolean) {
      isLit = lit;
      filamentMat.color.setHex(isLit ? 0xffaa33 : 0x222222);
      filamentMat.emissive.setHex(isLit ? 0xff8800 : 0x000000);
      filamentMat.emissiveIntensity = isLit ? 3.5 : 0;
      pointLight.intensity = isLit ? 4.5 : 0;
      glowMat.opacity = isLit ? 0.85 : 0;

      if (statusText) {
        statusText.textContent = isLit ? 'ON' : 'OFF';
        statusText.style.color = isLit ? '#f59e0b' : '#64748b';
      }
    }

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => setLightState(!isLit));
    }

    // Animation Loop with Visibility & Intersection Observer Optimization
    function animate() {
      if (!isVisible || document.hidden) return;
      animationFrameId = requestAnimationFrame(animate);

      if (!isDragging) {
        bulbGroup.rotation.y += 0.005;
      }
      bulbGroup.position.y = Math.sin(Date.now() * 0.0015) * 0.12;

      renderer.render(scene, camera);
    }

    function startAnimation() {
      if (animationFrameId === null) {
        animate();
      }
    }

    function stopAnimation() {
      if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    }

    // Pause when off-screen or tab hidden
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isVisible = entry.isIntersecting;
        if (isVisible) {
          startAnimation();
        } else {
          stopAnimation();
        }
      });
    }, { threshold: 0.1 });
    observer.observe(container);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAnimation();
      } else if (isVisible) {
        startAnimation();
      }
    });

    function handleResize() {
      if (!container) return;
      width = container.clientWidth;
      height = container.clientHeight;
      if (width > 0 && height > 0) {
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      }
    }
    window.addEventListener('resize', handleResize);
    startAnimation();
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHero3D();
  } else {
    document.addEventListener('DOMContentLoaded', initHero3D);
  }
</script>

<style>
  .explore-hero-dark {
    position: relative;
    padding: 4rem 0 4.5rem;
    background: radial-gradient(ellipse at 50% 30%, #0d1527 0%, #050811 100%);
    border-bottom: 1px solid rgba(56, 189, 248, 0.2);
    overflow: hidden;
  }
  .explore-hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .explore-hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .explore-badge-lab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.4);
    color: #38bdf8;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    width: fit-content;
    box-shadow: 0 0 16px rgba(6, 182, 212, 0.2);
  }
  .explore-title-dark {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    text-shadow: 0 0 30px rgba(56, 189, 248, 0.2);
  }
  .explore-subtitle-dark {
    font-size: 1.08rem;
    line-height: 1.6;
    color: #94a3b8;
    max-width: 580px;
  }
  .explore-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .btn-explore-cyan {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.6rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(6, 182, 212, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-explore-cyan:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(6, 182, 212, 0.55);
  }
  .btn-explore-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #f8fafc;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn-explore-outline:hover {
    background: rgba(30, 41, 59, 0.9);
    border-color: #38bdf8;
  }
  .explore-stats-strip-dark {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(56, 189, 248, 0.15);
    margin-top: 0.75rem;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
  }
  .stat-num-cyan {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: #38bdf8;
  }
  .stat-num-amber {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: #f59e0b;
  }
  .stat-lbl-dark {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 600;
  }
  .stat-divider-dark {
    width: 1px;
    height: 28px;
    background: rgba(56, 189, 248, 0.2);
  }

  /* 3D Stage Frame */
  .explore-hero-stage {
    position: relative;
    width: 100%;
    height: 480px;
  }
  .hero-canvas-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 1.25rem;
    background: radial-gradient(circle at 50% 40%, rgba(6, 182, 212, 0.12) 0%, rgba(5, 8, 17, 0.95) 75%);
    border: 1px solid rgba(56, 189, 248, 0.3);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .hero-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  .hero-canvas:active {
    cursor: grabbing;
  }
  .hero-stage-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }
  .stage-tag-neon {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.65rem;
    border-radius: 0.4rem;
    background: rgba(5, 8, 17, 0.85);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.4);
    backdrop-filter: blur(8px);
  }
  .stage-controls-hint-dark {
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
    background: rgba(15, 23, 42, 0.85);
    padding: 0.3rem 0.65rem;
    border-radius: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .hero-light-toggle {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }
  .hero-switch-btn-dark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.25rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(56, 189, 248, 0.4);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .hero-switch-btn-dark:hover {
    transform: translateX(-50%) scale(1.04);
    border-color: #38bdf8;
  }
  .switch-dot-neon {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 12px #f59e0b;
  }

  @media (max-width: 960px) {
    .explore-hero-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .explore-hero-stage {
      height: 380px;
    }
  }
</style>
