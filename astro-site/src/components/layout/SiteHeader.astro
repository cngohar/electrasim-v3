---
interface Props {
  assetVersion: string;
}

const { assetVersion } = Astro.props;

/* Active-section detection: `page` on the section root, `true` anywhere
   inside it (e.g. a blog article lights up “Blog”). Both states share the
   energised-lever styling in global.css via `[aria-current]`. */
const rawPath = Astro.url.pathname;
const pathname = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const current = (prefix: string): 'page' | 'true' | undefined =>
  pathname === prefix ? 'page' : pathname.startsWith(prefix) ? 'true' : undefined;

/* The bar carries only the three content hubs — everything else lives in
   the burger menu and the footer. `/#features` and `/#how-it-works` are
   homepage scroll anchors, not destinations, so they are footer-only. */
const NAV_LINKS = [
  { href: '/tools/', label: 'Tools' },
  { href: '/guide/', label: 'Guide' },
  { href: '/blog/', label: 'Blog' },
];

/* The burger is a deliberate “show me everything” gesture, so it stays
   complete: hubs first, secondary destinations after. */
const MENU_LINKS = [
  ...NAV_LINKS,
  { href: '/compare/', label: 'Compare' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav-in">
    <a href="/" class="logo">
      <span class="logo-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </span>
      <span class="logo-text">Electra<span class="logo-accent">Sim</span></span>
    </a>
    <div class="nav-links">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="hide-m" aria-current={current(link.href)}>{link.label}</a>
      ))}
      <button
        type="button"
        class="search-toggle-btn hide-m"
        data-search-trigger
        aria-label="Search guides, calculators, articles (Ctrl + K)"
        title="Search (Ctrl + K)"
      >
        <svg class="nav-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="nav-search-text">Search</span>
        <kbd class="nav-search-kbd">⌘K</kbd>
      </button>
      <button
        type="button"
        class="theme-toggle hide-m"
        data-theme-toggle
        aria-label="Switch to dark mode"
        aria-pressed="false"
        title="Switch to dark mode"
      >
        <span class="theme-icon theme-icon-moon" aria-hidden="true">&#9790;</span>
        <span class="theme-icon theme-icon-sun" aria-hidden="true">&#9728;</span>
      </button>
      <a href="/app/" class="btn-nav">Launch App <span aria-hidden="true">→</span></a>
    </div>
    <button
      class="nav-mobile-toggle"
      id="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <rect x="2" y="5" width="18" height="2" rx="1" fill="currentColor" />
        <rect x="2" y="10" width="18" height="2" rx="1" fill="currentColor" />
        <rect x="2" y="15" width="18" height="2" rx="1" fill="currentColor" />
      </svg>
    </button>
  </div>
  <span class="nav-rail" data-live aria-hidden="true"><span class="pulse-x"></span></span>
  <div class="nav-mobile-menu" id="nav-mobile-menu">
    <button
      type="button"
      class="search-toggle-mobile"
      data-search-trigger
      aria-label="Search guides, calculators, articles"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span>Search</span>
    </button>
    {MENU_LINKS.map((link) => (
      <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
    ))}
    <button
      type="button"
      class="theme-toggle-mobile"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
    >
      <span class="theme-icon theme-icon-moon" aria-hidden="true">&#9790;</span>
      <span class="theme-icon theme-icon-sun" aria-hidden="true">&#9728;</span>
      <span class="theme-toggle-label">Appearance</span>
    </button>
    <a href="/app/" class="btn-nav">Launch App →</a>
  </div>
</nav>
<script is:inline defer src={`/js/site-nav.js?v=${assetVersion}`}></script>
