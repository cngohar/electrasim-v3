<details class="floating-contact">
  <summary class="floating-contact-toggle" aria-label="Open contact options">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
    </svg>
  </summary>
  <div class="floating-contact-menu">
    <a class="floating-contact-link" href="https://web.facebook.com/electrasimweb" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M14 8.5h2.2V5.1c-.38-.05-1.7-.16-3.23-.16-3.2 0-5.39 1.95-5.39 5.54v3.12H4v3.8h3.58V24h4.4v-6.6h3.44l.55-3.8h-3.99v-2.75c0-1.1.31-2.35 2.02-2.35z"></path>
      </svg>
      Follow us on Facebook
    </a>
    <a class="floating-contact-link" href="/contact/">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
      Contact us
    </a>
  </div>
</details>

<script>
  const details = document.querySelector('details.floating-contact') as HTMLDetailsElement | null;
  if (details) {
    document.addEventListener('click', (e) => {
      if (details.open && !details.contains(e.target as Node)) {
        details.open = false;
      }
    });
    details.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });
  }
</script>
