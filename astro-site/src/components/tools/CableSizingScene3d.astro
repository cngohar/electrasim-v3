---
/** On-demand 3D companion to the cable sizing workbench. The 2D view remains the
 * fast, accessible default; this layer is a deliberately separate, disposable
 * Three.js scene that visualises the same live state as concentric cable layers. */
---
<div id="cs-3d-layer" class="cs-3d" hidden>
  <canvas id="cs-3d-canvas" class="cs-3d-canvas" role="img" aria-label="Interactive three-dimensional cable cutaway"></canvas>
  <div class="cs-3d-overlay"><strong>3D CONSTRUCTION VIEW</strong><span id="cs-3d-status">Drag to orbit · scroll to zoom</span><button type="button" id="cs-3d-back" aria-label="Return to 2D cable sizing view">↩ Return to 2D view</button></div>
  <p id="cs-3d-caption" class="cs-3d-caption" hidden></p>
</div>
<style>
.cs-3d{position:absolute;inset:0;z-index:6;background:radial-gradient(circle at 50% 35%,#173756,#07101e 75%);overflow:hidden}.cs-3d[hidden],.cs-3d-caption[hidden]{display:none}.cs-3d-canvas{width:100%;height:100%;display:block;touch-action:none;cursor:grab}.cs-3d-canvas:active{cursor:grabbing}.cs-3d-overlay{position:absolute;top:1rem;left:50%;transform:translateX(-50%);display:grid;gap:.2rem;text-align:center;padding:.55rem .9rem;border:1px solid #46799d;border-radius:.8rem;background:#0c1b2de8;color:#dff4ff;font:700 .65rem var(--font-mono,monospace);letter-spacing:.1em;pointer-events:none}.cs-3d-overlay span{font-weight:500;color:#8db4d0;letter-spacing:0}.cs-3d-overlay button{justify-self:center;margin-top:.2rem;padding:.25rem .55rem;border:1px solid #5d91b5;border-radius:999px;background:#173756;color:#dff4ff;font:700 .62rem var(--font-mono,monospace);cursor:pointer}.cs-3d-overlay button:hover,.cs-3d-overlay button:focus-visible{background:#245879;outline:2px solid #8bd5ff;outline-offset:2px}.cs-3d-caption{position:absolute;left:50%;bottom:1rem;transform:translateX(-50%);margin:0;padding:.4rem .8rem;border-radius:999px;background:#0c1b2de8;border:1px solid #46799d;color:#dff4ff;font:.7rem var(--font-mono,monospace);white-space:nowrap}@media(max-width:600px){.cs-3d-caption{font-size:.6rem;max-width:90%;overflow:hidden;text-overflow:ellipsis}}
</style>
<script>
  const toggle = document.getElementById('cs-3d-toggle');
  const layer = document.getElementById('cs-3d-layer');
  const canvas = document.getElementById('cs-3d-canvas');
  const root = document.getElementById('cs-scene-root');
  if (toggle && layer && canvas && root) {
    let THREE = null;
    let renderer = null;
    let scene = null;
    let camera = null;
    let raf = 0;
    let open = false;
    let yaw = .55;
    let pitch = .3;
    let distance = 10;
    let drag = null;
    let group = null;
    const status = document.getElementById('cs-3d-status');
    const caption = document.getElementById('cs-3d-caption');
    const back = document.getElementById('cs-3d-back');

    const state = () => ({
      method: root.dataset.method || 'C',
      material: root.dataset.material || 'copper',
      insulation: Number(root.dataset.insulation || 0),
      neighbours: Number(root.dataset.neighbours || 0),
      size: Number(document.getElementById('cs-out-size')?.textContent) || 2.5,
      iz: document.getElementById('cs-out-iz')?.textContent || '—',
      it: document.getElementById('cs-out-it')?.textContent || '—',
      status: root.dataset.status || 'pass',
    });

    function dispose(object) {
      object.traverse((node) => {
        if (!node.isMesh) return;
        node.geometry?.dispose();
        const material = Array.isArray(node.material) ? node.material : [node.material];
        material.forEach((item) => item?.dispose?.());
      });
    }
    function material(color, options = {}) { return new THREE.MeshPhysicalMaterial({ color, roughness: .55, metalness: 0, ...options }); }
    function cylinder(radius, depth, color, y = 0, opacity = 1) {
      const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, depth, 64, 1, false), material(color, { transparent: opacity < 1, opacity }));
      mesh.rotation.z = Math.PI / 2; mesh.position.y = y; return mesh;
    }
    function build() {
      if (!THREE || !scene) return;
      if (group) { scene.remove(group); dispose(group); }
      group = new THREE.Group();
      const s = state();
      const coreRadius = .28 + Math.min(1, Math.sqrt(s.size) / Math.sqrt(95)) * .58;
      const gap = 1 + s.insulation / 240;
      // The cable is a true exploded stack: conductor, insulation, sheath and
      // containment are separate solids, with the CPC tucked alongside it.
      const core = cylinder(coreRadius, 6.4, s.material === 'aluminum' ? 0xb9c7d6 : 0xd97632, -1.4 * gap);
      group.add(core);
      for (let i = 0; i < 7; i += 1) {
        const strand = cylinder(coreRadius * .3, 6.25, s.material === 'aluminum' ? 0xe7edf4 : 0xffbd7b, -1.4 * gap + (i - 3) * .035);
        strand.position.z = (i - 3) * coreRadius * .2; group.add(strand);
      }
      group.add(cylinder(coreRadius + .22, 6.6, 0xf0c86e, 0, .28));
      group.add(cylinder(coreRadius + .38, 6.75, 0x263f5a, 0, .38));
      group.add(cylinder(coreRadius + .58, 6.95, 0x101f35, 0, .72));
      const cpc = cylinder(Math.max(.12, coreRadius * .32), 6.5, 0x8ccf7d, 1.0 * gap, .95); group.add(cpc);
      // translucent context plates make installation method visible in 3D
      const plate = new THREE.Mesh(new THREE.BoxGeometry(7.6, .12, 3.8), material(s.method === 'D' ? 0x8b6e48 : 0x6a9ac0, { transparent: true, opacity: s.method === 'D' ? .42 : .16 }));
      plate.position.y = 1.95 * gap; group.add(plate);
      for (let i = 0; i < s.neighbours; i += 1) {
        const neighbour = cylinder(.12, 6.2, 0x80a6c2, 1.35 * gap + (i % 2) * .26); neighbour.position.z = (i - s.neighbours / 2) * .3; group.add(neighbour);
      }
      // end rings and dimension ticks ground the model as an engineering object
      for (const x of [-3.55, 3.55]) {
        const ring = new THREE.Mesh(new THREE.TorusGeometry(coreRadius + .65, .035, 10, 48), material(0x8bd5ff, { emissive: 0x163b56, emissiveIntensity: 1 })); ring.rotation.y = Math.PI / 2; ring.position.x = x; group.add(ring);
      }
      group.rotation.y = yaw; group.rotation.x = pitch; scene.add(group);
      if (caption) { caption.hidden = false; caption.textContent = `${s.size.toFixed(1)} mm² ${s.material} · ${s.method} · Iz ${s.iz} / It ${s.it}`; }
    }
    function resize() { if (!renderer || !camera) return; const box = canvas.getBoundingClientRect(); renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2)); renderer.setSize(box.width, box.height, false); camera.aspect = box.width / Math.max(1, box.height); camera.updateProjectionMatrix(); }
    function frame() { if (!renderer || !scene || !camera) return; camera.position.set(Math.sin(yaw) * distance, Math.sin(pitch) * distance * .6, Math.cos(yaw) * distance); camera.lookAt(0, 0, 0); renderer.render(scene, camera); if (open) raf = requestAnimationFrame(frame); }
    async function open3d() {
      if (!THREE) { status.textContent = 'Preparing 3D renderer…'; try { THREE = await import('three'); } catch { status.textContent = '3D unavailable — continue with the 2D cutaway.'; return; } }
      if (!renderer) { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true }); renderer.outputColorSpace = THREE.SRGBColorSpace; scene = new THREE.Scene(); camera = new THREE.PerspectiveCamera(34, 1, .1, 100); scene.add(new THREE.HemisphereLight(0xd8f1ff, 0x08111f, 2.3)); const key = new THREE.DirectionalLight(0xffffff, 3); key.position.set(3, 5, 6); scene.add(key); const rim = new THREE.PointLight(0x55bfff, 18, 18); rim.position.set(-4, 2, 3); scene.add(rim); resize(); window.addEventListener('resize', resize); }
      open = true; layer.hidden = false; toggle.setAttribute('aria-pressed', 'true'); toggle.classList.add('active'); build(); cancelAnimationFrame(raf); frame();
    }
    function close3d() { open = false; layer.hidden = true; toggle.setAttribute('aria-pressed', 'false'); toggle.classList.remove('active'); cancelAnimationFrame(raf); }
    toggle.addEventListener('click', () => open ? close3d() : open3d());
    back?.addEventListener('click', close3d);
    canvas.addEventListener('pointerdown', (event) => { drag = { x: event.clientX, y: event.clientY }; canvas.setPointerCapture(event.pointerId); });
    canvas.addEventListener('pointermove', (event) => { if (!drag) return; yaw += (event.clientX - drag.x) * .009; pitch = Math.max(-.8, Math.min(.8, pitch + (event.clientY - drag.y) * .009)); drag = { x: event.clientX, y: event.clientY }; if (group) { group.rotation.y = yaw; group.rotation.x = pitch; } });
    canvas.addEventListener('pointerup', () => { drag = null; });
    canvas.addEventListener('wheel', (event) => { event.preventDefault(); distance = Math.max(6, Math.min(16, distance + event.deltaY * .01)); }, { passive: false });
    document.addEventListener('cs:scene-painted', () => { if (open) build(); });
  } else if (toggle) toggle.hidden = true;
</script>
