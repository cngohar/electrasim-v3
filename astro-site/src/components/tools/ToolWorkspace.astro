---
/**
 * ToolWorkspace.astro — the shared stage shell for the Electrical Toolbox.
 *
 * One composition for every visual tool: header, drawer, command palette and
 * help modal; a full-bleed scene stage (slot `scene`) with its floating
 * instruments (slot `panels`); then the crawlable reference section. Scripts are
 * the shared stage runtime plus whichever tool engine the page asks for.
 *
 * Defaults render the voltage-drop landscape, so that page is untouched; cable
 * sizing passes its own scene, panels and engine. Both get the same
 * aspect-fitted stage (public/js/scene-stage.js), the same reduced-motion and
 * dark-mode behaviour, and the same responsive tiering.
 */
import packageMetadata from '../../../../package.json';
import type { ToolEntry } from '../../lib/tools/registry';
import CableSizingPanels from './CableSizingPanels.astro';
import CableSizingScene from './CableSizingScene.astro';
import CommandPalette from './CommandPalette.astro';
import ToolDrawer from './ToolDrawer.astro';
import ToolHeader from './ToolHeader.astro';
import ToolHelpModal from './ToolHelpModal.astro';
import ToolSeoContent from './ToolSeoContent.astro';
import VoltageDropPanels from './VoltageDropPanels.astro';
import VoltageDropScene from './VoltageDropScene.astro';

interface Props {
  currentTool: ToolEntry;
  /** Tool engine shipped from public/js; the shared stage runtime is always loaded first. */
  toolScript?: string;
  /** Which tool family this stage renders — decides the default slot content. */
  variant?: 'voltage-drop' | 'cable-sizing';
  /** Accessible title for the sr-only h1. */
  heading?: string;
}

const {
  currentTool,
  toolScript = '/js/voltage-drop-tool.js',
  variant = 'voltage-drop',
  heading = currentTool.name,
} = Astro.props;

const hasSceneSlot = Astro.slots.has('scene');
const hasPanelsSlot = Astro.slots.has('panels');
const version = packageMetadata.version;
---

<div class="tool-workspace-shell" id="tool-workspace-shell">
  <h1 class="sr-only">{heading}</h1>

  <!-- Header -->
  <ToolHeader currentTool={currentTool} />

  <!-- Navigation drawer (hamburger) -->
  <ToolDrawer currentTool={currentTool} />

  <!-- Command palette -->
  <CommandPalette currentTool={currentTool} />

  <!-- Educational help modal (content is per-tool) -->
  <ToolHelpModal tool={currentTool} />

  <!--
    Full-bleed stage. The scene gets its own frame (.ts-scene-frame) so the
    viewBox fit always measures the box the artwork actually occupies — the
    whole stage while floating, a banner once the layout stacks — and the panels
    share one wrapper layer (.ts-panel-wrap) that owns their anchoring and the
    stacked-mode grid. See src/styles/tool-stage.css.
  -->
  <div
    class="tool-interactive-stage ts-stage"
    id="interactive-stage"
    data-stage={variant === 'cable-sizing' ? 'stackable' : 'fixed'}
  >
    <div class="ts-scene-frame" id="scene-frame">
      {
        hasSceneSlot ? (
          <slot name="scene" />
        ) : variant === 'cable-sizing' ? (
          <CableSizingScene />
        ) : (
          <VoltageDropScene />
        )
      }
    </div>
    <div class="ts-panel-wrap" id="panel-wrap">
      {
        hasPanelsSlot ? (
          <slot name="panels" />
        ) : variant === 'cable-sizing' ? (
          <CableSizingPanels />
        ) : (
          <VoltageDropPanels />
        )
      }
    </div>
  </div>

  <!-- Crawlable educational reference content -->
  <ToolSeoContent tool={currentTool} />
</div>

<!--
  Script order matters and is guaranteed by `defer`: shared chrome (drawer,
  palette, help, focus trap) → scene runtime → tool engine. The engine registers
  its commands with the chrome layer on init, and chrome prunes any palette entry
  no engine claims.
-->
<script is:inline defer src={`/js/tool-chrome.js?v=${version}`}></script>
<script is:inline defer src={`/js/scene-stage.js?v=${version}`}></script>
<script is:inline defer src={`/js/tool-share.js?v=${version}`}></script>
<script is:inline defer src={`/js/cable-tables.js?v=${version}`}></script>
<script is:inline defer src={`${toolScript}?v=${version}`}></script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .tool-workspace-shell {
    display: flex;
    flex-direction: column;
    /* 100% (not 100vw): 100vw includes the classic scrollbar's width, which
       pushed a few pixels of horizontal overflow beside the scene on desktop. */
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--bg);
    overflow-x: hidden;
    position: relative;
  }
  /* .ts-stage (tool-stage.css) owns the geometry; these rules only tune the
     per-variant heights so each tool's composition keeps its own balance. */
  .tool-interactive-stage {
    min-height: min(540px, calc(100dvh - 3.75rem));
  }

  @media (max-width: 1080px) {
    .tool-interactive-stage {
      height: calc(100vh - 3.75rem);
      height: calc(100dvh - 3.75rem);
      min-height: min(500px, calc(100dvh - 3.75rem));
    }
  }

  @media (max-width: 768px) {
    .tool-interactive-stage {
      min-height: min(440px, calc(100dvh - 3.75rem));
    }
  }

  @media (max-width: 768px) and (orientation: portrait) {
    .tool-interactive-stage {
      height: clamp(280px, 52dvh, 460px);
      min-height: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-interactive-stage *,
    .tool-interactive-stage *::before,
    .tool-interactive-stage *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
