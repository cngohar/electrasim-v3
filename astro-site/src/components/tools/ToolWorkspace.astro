---
import packageMetadata from '../../../../package.json';
import type { ToolEntry } from '../../lib/tools/registry';
import CommandPalette from './CommandPalette.astro';
import ToolDrawer from './ToolDrawer.astro';
import ToolHeader from './ToolHeader.astro';
import ToolHelpModal from './ToolHelpModal.astro';
import ToolSeoContent from './ToolSeoContent.astro';
import VoltageDropPanels from './VoltageDropPanels.astro';
import VoltageDropScene from './VoltageDropScene.astro';

interface Props {
  currentTool: ToolEntry;
}

const { currentTool } = Astro.props;
---

<div class="tool-workspace-shell" id="tool-workspace-shell">
  <h1 class="sr-only">{currentTool.name}</h1>
  <!-- Header -->
  <ToolHeader currentTool={currentTool} />

  <!-- Navigation Drawer (Hamburger) -->
  <ToolDrawer currentTool={currentTool} />

  <!-- Command Palette Modal -->
  <CommandPalette currentTool={currentTool} />

  <!-- Educational Help Modal -->
  <ToolHelpModal />

  <!-- Main Full-Screen Workspace Area -->
  <div class="tool-interactive-stage" id="interactive-stage">
    <VoltageDropScene />
    <VoltageDropPanels />
  </div>

  <!-- Crawlable Educational SEO Content -->
  <ToolSeoContent tool={currentTool} />
</div>

<!-- Load Client Script (Pure vanilla TypeScript compiled / ESM JS, zero React dependencies) -->
<script is:inline defer src={`/js/tool-share.js?v=${packageMetadata.version}`}></script>
<script is:inline defer src={`/js/voltage-drop-tool.js?v=${packageMetadata.version}`}></script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .tool-workspace-shell {
    display: flex;
    flex-direction: column;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--bg);
    overflow-x: hidden;
    position: relative;
  }
  .tool-interactive-stage {
    position: relative;
    width: 100vw;
    height: calc(100vh - 3.75rem);
    height: calc(100dvh - 3.75rem);
    min-height: min(540px, calc(100dvh - 3.75rem));
    overflow: hidden;
  }

  @media (max-width: 1080px) {
    .tool-interactive-stage {
      height: 70vh;
      height: 70dvh;
      min-height: min(480px, calc(100dvh - 3.75rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-interactive-stage *,
    .tool-interactive-stage *::before,
    .tool-interactive-stage *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
