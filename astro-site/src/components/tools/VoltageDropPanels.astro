---
import EmojiIcon from '../EmojiIcon.astro';
// VoltageDropPanels.astro - Floating Inputs, Results, Controls, Error Notices & Legend
import StandardSelector from './StandardSelector.astro';
---

<!-- TOP-CENTER CONTROLS BAR -->
<div class="top-controls-bar" id="top-controls-bar">
  <div class="pill-group">
    <button
      type="button"
      id="btn-toggle-animate"
      class="pill-btn active"
      aria-pressed="true"
      title="Toggle current flow animation"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="5 3 19 12 5 21 5 3" />
      </svg>
      <span>Animate</span>
      <span class="pulse-indicator" id="pulse-dot" aria-hidden="true"></span>
    </button>

    <div class="pill-divider"></div>

    <button
      type="button"
      id="btn-toggle-values"
      class="pill-btn active"
      aria-pressed="true"
      title="Toggle scene numeric labels"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
      <span>Values</span>
    </button>

    <div class="pill-divider"></div>

    <button
      type="button"
      id="btn-toggle-legend"
      class="pill-btn active"
      aria-pressed="true"
      title="Toggle color legend"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6" />
        <line x1="8" y1="12" x2="21" y2="12" />
        <line x1="8" y1="18" x2="21" y2="18" />
        <line x1="3" y1="6" x2="3.01" y2="6" />
        <line x1="3" y1="12" x2="3.01" y2="12" />
        <line x1="3" y1="18" x2="3.01" y2="18" />
      </svg>
      <span>Legend</span>
    </button>
  </div>
</div>

<!-- TOP-RIGHT VIEW CONTROLS -->
<div class="top-view-controls" id="top-view-controls">
  <button
    type="button"
    id="btn-reset-view"
    class="view-action-btn"
    title="Reset View & Inputs"
    aria-label="Reset view and parameters"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
      <path d="M3 3v5h5" />
    </svg>
    <span>Reset</span>
  </button>

  <button
    type="button"
    id="btn-toggle-3d"
    class="view-action-btn"
    title="Toggle 3D View Perspective"
    aria-pressed="false"
    aria-label="Toggle 3D View"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
      <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
      <line x1="12" y1="22.08" x2="12" y2="12" />
    </svg>
    <span>3D View</span>
  </button>
</div>

<!-- FLOATING TOAST NOTIFICATION BANNER -->
<div id="tool-toast-banner" class="tool-toast" role="status" aria-live="polite" hidden>
  <span id="tool-toast-icon" class="tool-toast-icon"><EmojiIcon name="info" /></span>
  <span id="tool-toast-text" class="tool-toast-text"></span>
  <button type="button" id="tool-toast-close" class="tool-toast-close" aria-label="Dismiss notification">✕</button>
</div>

<!-- LEFT FLOATING INPUTS PANEL -->
<div id="inputs-panel-container" class="inputs-panel-container">
  <div id="inputs-panel-scrim" class="panel-scrim" hidden></div>
  <section id="inputs-panel" class="floating-panel inputs-panel" aria-label="Calculation Inputs">
    <div class="panel-header">
      <div class="panel-header-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="21" x2="4" y2="14" />
          <line x1="4" y1="10" x2="4" y2="3" />
          <line x1="12" y1="21" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12" y2="3" />
          <line x1="20" y1="21" x2="20" y2="16" />
          <line x1="20" y1="12" x2="20" y2="3" />
          <line x1="1" y1="14" x2="7" y2="14" />
          <line x1="9" y1="8" x2="15" y2="8" />
          <line x1="17" y1="16" x2="23" y2="16" />
        </svg>
        <h2>INPUTS</h2>
      </div>
      <div class="panel-header-actions">
        <button
          type="button"
          id="btn-collapse-inputs"
          class="btn-panel-collapse"
          aria-expanded="true"
          aria-label="Collapse inputs panel"
        >
          <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15" />
          </svg>
        </button>
      </div>
    </div>

    <div id="inputs-body" class="panel-body nice-scroll">
      <!-- Regional wiring standard (BS 7671 / IEC 60364) -->
      <StandardSelector inputId="input-standard" noteId="vd-standard-note" />

      <!-- System Type -->
      <div class="form-group">
        <label class="form-label">System Type</label>
        <div class="segmented-pill-group" role="radiogroup" aria-label="System Type">
          <button type="button" class="seg-btn" data-system-type="dc" role="radio" aria-checked="false" tabindex="-1">DC</button>
          <button type="button" class="seg-btn active" data-system-type="single" role="radio" aria-checked="true" tabindex="0">1-Φ AC</button>
          <button type="button" class="seg-btn" data-system-type="three" role="radio" aria-checked="false" tabindex="-1">3-Φ AC</button>
        </div>
      </div>

      <!-- System Voltage -->
      <div class="form-group" id="group-voltage">
        <div class="form-label-row">
          <label for="input-voltage" class="form-label">System Voltage</label>
          <span class="form-sublabel" id="voltage-sublabel">Nominal voltage (RMS)</span>
        </div>
        <div class="input-with-addon" id="wrap-voltage">
          <input
            type="number"
            id="input-voltage"
            class="form-input"
            value="230"
            min="1"
            max="1000000"
            step="any"
            aria-label="System voltage"
            aria-describedby="err-voltage"
          />
          <div class="unit-select-wrap">
            <select id="select-voltage-unit" class="unit-select" aria-label="Voltage unit">
              <option value="V" selected>V</option>
              <option value="kV">kV</option>
            </select>
            <span class="select-arrow">▾</span>
          </div>
        </div>
        <span class="field-error-msg" id="err-voltage" role="alert" hidden></span>
      </div>

      <!-- Load Current -->
      <div class="form-group" id="group-current">
        <div class="form-label-row">
          <label for="input-current" class="form-label">Load Current</label>
          <span class="form-sublabel">Current through cable</span>
        </div>
        <div class="input-with-addon" id="wrap-current">
          <input
            type="number"
            id="input-current"
            class="form-input"
            value="40"
            min="0"
            max="50000"
            step="any"
            aria-label="Load current in Amperes"
            aria-describedby="err-current"
          />
          <span class="input-badge">A</span>
        </div>
        <span class="field-error-msg" id="err-current" role="alert" hidden></span>
      </div>

      <!-- Cable Length (one-way) -->
      <div class="form-group" id="group-length">
        <div class="form-label-row">
          <label for="input-length" class="form-label">Cable Length (one-way)</label>
          <span class="form-sublabel">Length from source to load</span>
        </div>
        <div class="input-with-addon" id="wrap-length">
          <input
            type="number"
            id="input-length"
            class="form-input"
            value="50"
            min="0.1"
            max="50000"
            step="any"
            aria-label="One-way cable length in meters"
            aria-describedby="err-length"
          />
          <span class="input-badge">m</span>
        </div>
        <span class="field-error-msg" id="err-length" role="alert" hidden></span>
      </div>

      <!-- Cable Size -->
      <div class="form-group" id="group-size">
        <div class="form-label-row">
          <label for="input-size" class="form-label">Cable Size</label>
          <span class="form-sublabel">Conductor cross-sectional area</span>
        </div>
        <div class="input-with-addon" id="wrap-size">
          <input
            type="number"
            id="input-size"
            class="form-input"
            value="10"
            min="0.5"
            max="2500"
            step="any"
            aria-label="Cable size in mm²"
            aria-describedby="err-size"
          />
          <span class="input-badge">mm²</span>
        </div>
        <span class="field-error-msg" id="err-size" role="alert" hidden></span>
      </div>

      <!-- Conductor Material -->
      <div class="form-group">
        <label for="select-material" class="form-label">Conductor Material</label>
        <div class="select-wrap">
          <select id="select-material" class="form-select" aria-label="Conductor Material">
            <option value="copper" selected>Copper (0.0172 Ω·mm²/m)</option>
            <option value="aluminum">Aluminum (0.0282 Ω·mm²/m)</option>
          </select>
          <span class="select-arrow">▾</span>
        </div>
      </div>

      <!-- Real-world scenario presets -->
      <div class="preset-block" id="preset-block">
        <div class="form-label-row">
          <label class="form-label" id="preset-label">Real-World Presets</label>
          <span class="form-sublabel">Typical installs</span>
        </div>
        <div class="preset-grid" id="preset-grid" role="group" aria-labelledby="preset-label">
          <button type="button" class="preset-chip" data-preset-id="domestic-lighting" aria-pressed="false">
            <span class="preset-chip-name">Lighting radial</span>
            <span class="preset-chip-meta">6 A · 1.5 mm² · 45 m</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="kitchen-radial" aria-pressed="false">
            <span class="preset-chip-name">Kitchen radial</span>
            <span class="preset-chip-meta">32 A · 6 mm² · 20 m</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="ev-7kw" aria-pressed="false">
            <span class="preset-chip-name">EV 7 kW</span>
            <span class="preset-chip-meta">32 A · 10 mm² · 25 m</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="ev-11kw" aria-pressed="false">
            <span class="preset-chip-name">EV 11 kW</span>
            <span class="preset-chip-meta">16 A · 4 mm² · 3-ph</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="shower" aria-pressed="false">
            <span class="preset-chip-name">Shower 9.5 kW</span>
            <span class="preset-chip-meta">41 A · 10 mm² · 12 m</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="shed-submain" aria-pressed="false">
            <span class="preset-chip-name">Garden submain</span>
            <span class="preset-chip-meta">32 A · 10 mm² · 120 m</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="long-shed" aria-pressed="false">
            <span class="preset-chip-name">Long shed run</span>
            <span class="preset-chip-meta">16 A · 2.5 mm² · 85 m</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="motor" aria-pressed="false">
            <span class="preset-chip-name">Motor 5.5 kW</span>
            <span class="preset-chip-meta">11 A · 2.5 mm² · 3-ph</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="aluminium-feed" aria-pressed="false">
            <span class="preset-chip-name">Aluminium feed</span>
            <span class="preset-chip-meta">32 A · 16 mm² · 60 m</span>
          </button>
          <button type="button" class="preset-chip" data-preset-id="battery-dc" aria-pressed="false">
            <span class="preset-chip-name">48 V battery link</span>
            <span class="preset-chip-meta">100 A · 25 mm² · 4 m</span>
          </button>
        </div>
        <p class="preset-caption" id="preset-caption" hidden></p>
      </div>

      <!-- Advanced Options Accordion -->
      <div class="advanced-accordion">
        <button
          type="button"
          id="btn-advanced-toggle"
          class="advanced-toggle-btn"
          aria-expanded="false"
          aria-controls="advanced-body"
        >
          <span>Advanced Options</span>
          <svg class="adv-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <div id="advanced-body" class="advanced-body" hidden>
          <!-- Power Factor -->
          <div class="form-group" id="pf-group">
            <div class="form-label-row">
              <label for="input-pf" class="form-label">Power Factor</label>
              <span class="form-sublabel">cos φ (0.1 to 1.0)</span>
            </div>
            <div class="input-with-addon" id="wrap-pf">
              <input
                type="number"
                id="input-pf"
                class="form-input"
                value="0.92"
                min="0.1"
                max="1.0"
                step="0.01"
                aria-label="Load power factor"
                aria-describedby="err-pf"
              />
              <span class="input-badge">cos φ</span>
            </div>
            <span class="field-error-msg" id="err-pf" role="alert" hidden></span>
          </div>

          <!-- Conductor Temperature -->
          <div class="form-group" id="group-temp">
            <div class="form-label-row">
              <label for="input-temp" class="form-label">Conductor Temperature</label>
              <span class="form-sublabel">Affects resistivity</span>
            </div>
            <div class="input-with-addon" id="wrap-temp">
              <input
                type="number"
                id="input-temp"
                class="form-input"
                value="20"
                min="-50"
                max="250"
                step="1"
                aria-label="Conductor operating temperature in degrees Celsius"
                aria-describedby="err-temp"
              />
              <span class="input-badge">°C</span>
            </div>
            <span class="field-error-msg" id="err-temp" role="alert" hidden></span>
          </div>

          <!-- Include Reactance Switch -->
          <div class="form-switch-row" id="reactance-group">
            <span class="switch-label">Include Cable Reactance (X)</span>
            <button
              type="button"
              id="switch-reactance"
              class="switch-btn"
              role="switch"
              aria-checked="false"
              aria-label="Include cable reactance"
            >
              <span class="switch-knob"></span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!--
      Pinned footer (outside the scroll area) — this is what used to sit on top
      of the last advanced fields: the panel body scrolls, the button does not.
    -->
    <div class="panel-footer" data-panel-footer="inputs">
      <button type="button" id="btn-calculate" class="btn-calculate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="2" width="16" height="20" rx="2" />
          <line x1="8" y1="6" x2="16" y2="6" />
          <line x1="16" y1="14" x2="16" y2="18" />
          <path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01" />
        </svg>
        <span>Calculate</span>
      </button>
    </div>
  </section>
</div>

<!-- RIGHT-BOTTOM FLOATING RESULTS PANEL -->
<div class="results-panel-container">
  <section id="results-panel" class="floating-panel results-panel" aria-label="Calculation Results Summary" tabindex="-1">
    <div class="panel-header">
      <div class="panel-header-title">
        <h2>RESULT SUMMARY</h2>
      </div>
      <div class="panel-header-actions">
        <button
          type="button"
          id="btn-collapse-results"
          class="btn-panel-collapse"
          aria-expanded="true"
          aria-label="Collapse results summary"
        >
          <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15" />
          </svg>
        </button>
      </div>
    </div>

    <div id="results-body" class="panel-body">
      <!-- Friendly Error Notice Card (Visible when input validation fails) -->
      <div id="error-notice-card" class="error-notice-card" hidden role="alert">
        <div class="error-notice-head">
          <span class="error-notice-icon"><EmojiIcon name="warning" /></span>
          <div class="error-notice-title">Please Check Your Inputs</div>
        </div>
        <p class="error-notice-desc">We noticed some values that require your attention before calculations can proceed:</p>
        <ul class="error-notice-list" id="error-notice-list">
          <!-- Populated dynamically with friendly guidance -->
        </ul>
        <button type="button" id="btn-autofix-inputs" class="btn-autofix">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
          </svg>
          <span>Restore Standard Values</span>
        </button>
      </div>

      <!-- Standard Numeric Result Rows -->
      <div class="result-rows" id="result-rows-group">
        <div class="result-row">
          <span class="row-label">Source Voltage</span>
          <span class="row-value val-source" id="res-source-voltage">230 V</span>
        </div>
        <div class="result-row">
          <span class="row-label">Voltage at Load</span>
          <span class="row-value val-load" id="res-load-voltage">223.7 V</span>
        </div>
        <div class="result-row">
          <span class="row-label">Voltage Drop</span>
          <span class="row-value val-drop" id="res-voltage-drop">6.33 V</span>
        </div>
        <div class="result-row">
          <span class="row-label">Voltage Drop (%)</span>
          <span class="row-value val-percent" id="res-drop-percent">2.75%</span>
        </div>
        <div class="result-row">
          <span class="row-label">Power Loss</span>
          <span class="row-value val-power" id="res-power-loss">275.2 W</span>
        </div>
      </div>

      <!-- Severity Status Card -->
      <div id="status-card" class="status-card good">
        <div class="status-icon-wrap" id="status-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
        </div>
        <div class="status-content">
          <div class="status-title" id="status-title">Good</div>
          <p class="status-desc" id="status-desc">
            The voltage drop is within the recommended 3% limit (BS 7671).
          </p>
        </div>
      </div>
      <!-- Real-world cross-checks written by the tool script (design temperature,
           Annex G long-run allowance, next standard size up) -->
      <ul class="vd-eng-notes" id="vd-eng-notes" hidden></ul>
      <!-- Standards-of-verification trust line (updated by tool script) -->
      <p class="vd-standard-echo" id="vd-standard-echo">
        Verified against <strong>BS 7671:2018+A4:2026 (UK)</strong> — Appendix 4 limits: 3% lighting / 5% power circuits.
      </p>
      <!-- Shareable calculation: every input is encoded in the URL -->
      <button type="button" class="vd-share-btn" id="btn-share-calc">
        <EmojiIcon name="link" /> <span data-share-label>Copy calculation link — inputs travel inside the URL</span>
      </button>
    </div>
  </section>
</div>

<!-- BOTTOM-CENTER FLOATING LEGEND -->
<div id="legend-panel" class="floating-legend" role="region" aria-label="Visual color legend">
  <div class="legend-content">
    <span class="legend-heading">LEGEND</span>
    <div class="legend-items">
      <span class="legend-item">
        <span class="legend-dot dot-full"></span>
        <span>Full voltage</span>
      </span>
      <span class="legend-item">
        <span class="legend-dot dot-flow"></span>
        <span>Current flow</span>
      </span>
      <span class="legend-item">
        <span class="legend-dot dot-high"></span>
        <span>High drop</span>
      </span>
      <span class="legend-item">
        <span class="legend-dot dot-excessive"></span>
        <span>Excessive drop</span>
      </span>
    </div>
  </div>
</div>

<!-- BOTTOM-LEFT TIPS CONTROL -->
<div class="tips-control-pill" id="tips-control-pill">
  <button
    type="button"
    id="switch-tips"
    class="tips-toggle-btn"
    role="switch"
    aria-checked="true"
    aria-label="Toggle educational tips"
  >
    <span class="tips-icon"><EmojiIcon name="bulb" /></span>
    <span class="tips-label">Tips</span>
    <span class="switch-pill-knob active" id="tips-pill-knob"></span>
  </button>
</div>

<!-- BOTTOM-CENTER ROTATING INFO / TIPS BAR -->
<div id="tips-bar" class="floating-tips-bar">
  <div class="tips-bar-content">
    <span class="tips-info-icon"><EmojiIcon name="info" /></span>
    <span id="tips-text" class="tips-text">
      Green particles show the flow of electricity. Some voltage is lost along the cable because the conductor has resistance.
    </span>
    <span class="tips-pager" aria-hidden="true">
      <button type="button" id="btn-tip-prev" class="tips-arrow" aria-label="Previous tip" tabindex="0">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <span class="tips-count" id="tips-count">1/18</span>
      <button type="button" id="btn-tip-next" class="tips-arrow" aria-label="Next tip" tabindex="0">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    </span>
