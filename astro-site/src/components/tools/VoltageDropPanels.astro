  }
  .btn-panel-collapse[aria-expanded="false"] .chevron-icon {
    transform: rotate(180deg);
  }
  .panel-body {
    /*
     * Trailing space is a margin on the last child, not padding on the scroller:
     * Chrome leaves a flex container's bottom padding out of its scrollable
     * overflow area, so the final control (Advanced Options, on a short window)
     * sat clipped under the footer at full scroll and could not be reached.
     */
    padding: 0.75rem 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* flex children need this to shrink below their content height and scroll */
    flex: 1 1 auto;
    min-height: 0;
    /* stop scrolled-to controls clear of the pinned Calculate footer */
    scroll-padding-bottom: 4.75rem;
  }
  .panel-body[hidden] {
    display: none !important;
  }
  /* a trailing flex item, not padding: it is counted in the scrollable overflow area,
     so the final control can always be brought clear of the pinned footer */
  /* see tool-stage.css: children of a scrolling flex column must not shrink,
     or the last row is squeezed to nothing instead of scrolling into view */
  .panel-body::after {
    content: "";
    flex: 0 0 auto;
    height: 1.25rem;
    margin-top: -1rem;
  }

  /* Left Inputs Panel */
  .inputs-panel-container {
    position: absolute;
    top: 1.25rem;
