    z-index: 25;
  }
  .inputs-panel {
    width: min(340px, calc(100vw - 2.5rem));
    /*
     * The stage is 100dvh - header, and the panel floats 1.25rem inside it, so
     * the ceiling has to be measured in dvh (the mobile browser chrome changes
     * 100vh constantly). min-height: 0 on the body is what makes the overflow
     * actually scroll inside a flex column instead of pushing content past the
