---
import type { ToolEntry } from '../../lib/tools/registry';
/**
 * ToolHelpModal.astro — the "how this works" dialog shared by the toolbox.
 *
 * Content is keyed by tool so each calculator explains *its own* method: the
 * formula block mirrors the tool's published equations, and the tools that
 * teach something physical (voltage drop, cable sizing) also get limit tables
 * and field notes. Anything else falls back to its own equations and steps,
 * which is still better than showing another tool's prose.
 */
import EmojiIcon from '../EmojiIcon.astro';

interface FormulaRow {
  label: string;
  /** Rendered as HTML so sub/sup and Greek letters stay readable. */
  expression: string;
}
interface GuideItem {
  tone: 'good' | 'warning' | 'excessive';
  badge: string;
  text: string;
}
interface RefCard {
  badge: string;
  value: string;
  unit: string;
  note: string;
  tone: 'copper' | 'aluminum' | 'neutral';
}
interface Note {
  icon: string;
  text: string;
}
interface Copy {
  title: string;
  intro: string;
  formulas: FormulaRow[];
  formulaMeta: string[];
  cards: RefCard[];
  guidelinesTitle: string;
  guidelines: GuideItem[];
  notesTitle: string;
  notes: Note[];
  tip: string;
}

interface Props {
  tool?: ToolEntry;
}
const { tool } = Astro.props;

const GUIDE_TONE: Record<GuideItem['tone'], string> = {
  good: 'tag-good',
  warning: 'tag-warning',
  excessive: 'tag-excessive',
};

const COPY: Record<string, Copy> = {
  'voltage-drop': {
    title: 'How Voltage Drop Works',
    intro:
      'Current pushes through the resistance and reactance of the cable on its way to the load and back, so the load receives less than the supply origin delivers.',
    formulas: [
      { label: 'DC', expression: 'V<sub>drop</sub> = 2 · I · L · r' },
      { label: '1-Φ AC', expression: 'V<sub>drop</sub> = 2 · I · L · (r cos φ + x sin φ)' },
      { label: '3-Φ AC', expression: 'V<sub>drop</sub> = √3 · I · L · (r cos φ + x sin φ)' },
    ],
    formulaMeta: [
      'r = ρ<sub>T</sub> / A (Ω/m one-way conductor resistance)',
      'P<sub>loss</sub> = I² · R<sub>total</sub> (watts wasted as heat)',
    ],
    cards: [
      {
        badge: 'COPPER',
        value: '0.0172',
        unit: 'Ω·mm²/m',
        note: 'at 20 °C (standard electrolytic)',
        tone: 'copper',
      },
      {
        badge: 'ALUMINIUM',
        value: '0.0282',
        unit: 'Ω·mm²/m',
        note: 'at 20 °C (~64% higher resistance)',
        tone: 'aluminum',
      },
    ],
    guidelinesTitle: 'BS 7671 &amp; IEC limits (public LV supply)',
    guidelines: [
      {
        tone: 'good',
        badge: '≤ 3%',
        text: '<strong>Good:</strong> inside the lighting ceiling of 3% (6.9 V at 230 V) that BS 7671 Reg 525.1 / Table 4Ab and IEC 60364-5-52 Table G.52.1 both set for lighting.',
      },
      {
        tone: 'warning',
        badge: '&gt; 3% – 5%',
        text: '<strong>Marginal:</strong> acceptable for sockets, heaters, cookers and other uses (5% = 11.5 V at 230 V, 20 V at 400 V) but over the lighting budget.',
      },
      {
        tone: 'excessive',
        badge: '&gt; 5%',
        text: '<strong>Excessive:</strong> outside both standards for a public supply. Upsize the conductor or shorten the run — motors also lose starting torque with the square of the voltage.',
      },
      {
        tone: 'good',
        badge: '6% / 8%',
        text: '<strong>Private LV supply:</strong> generator, on-site transformer or solar PV may use 6% lighting / 8% other uses. IEC Annex G also allows up to +0.5% on runs over 100 m (0.005% per metre).',
      },
    ],
    notesTitle: 'Field notes from real installations',
    notes: [
      {
        icon: 'ruler',
        text: '<strong>Compare like with like.</strong> BS 7671 mV/A/m figures assume the conductor at its maximum operating temperature (70 °C thermoplastic, 90 °C thermosetting). At 20 °C this calculator reads about 17% lower.',
      },
      {
        icon: 'warning',
        text: '<strong>The limit is measured from the origin,</strong> not from your consumer unit — a submain already spends part of the budget, and the DNO is separately allowed −6%/+10% of 230 V at the meter (EN 50160).',
      },
      {
        icon: 'bolt',
        text: '<strong>Ring finals mislead if you use the whole ring length.</strong> Current reaches the load from both directions, so a 100 m ring at 30 A drops about 6.2 V where a 50 m radial drops 24.7 V.',
      },
      {
        icon: 'gear',
        text: '<strong>Reactance only earns its keep above about 16 mm².</strong> The Appendix 4 tables ignore inductance for smaller cables; for large multi-core or armoured single-core runs, switch it on.',
      },
      {
        icon: 'reset',
        text: '<strong>Motors need a second, starting check.</strong> Direct-on-line starting pulls 6–8× full-load current and torque falls with the square of voltage — keep the running drop tight or it will not start under load.',
      },
      {
        icon: 'flask',
        text: '<strong>Loose terminations beat physics.</strong> A 0.5 mΩ corroded joint costs 0.02 V per amp — more than 12 m of 2.5 mm² cable. Torque and re-check links before you upsize anything.',
      },
    ],
    tip: '<strong>Pro Tip:</strong> conductor resistance rises ~0.39% per °C above 20 °C for copper (~0.40% for aluminium). Under full load a cable really runs at 70 °C (PVC) or 90 °C (XLPE) — enter that temperature and the verdict matches what an inspector can prove from the tabulated data.',
  },

  'cable-size': {
    title: 'How this calculator sizes a cable',
    intro:
      'A source, a cable and a load. The cable has resistance, current through resistance loses voltage, and the smallest candidate that still keeps the loss inside your limit is the answer.',
    formulas: [
      { label: 'Resistance', expression: 'R = 2 · ρ · L / A  (round trip)' },
      { label: 'Voltage drop', expression: 'ΔV = I · R' },
      { label: 'Design current', expression: 'I = P / (U · cos φ) &nbsp;— &nbsp;P / U on DC' },
    ],
    formulaMeta: [
      'ρ = 0.0172 Ω·mm²/m for copper, 0.0282 for aluminium (at 20 °C)',
      'The recommendation is the smallest candidate with ΔV ≤ your limit',
    ],
    cards: [
      {
        badge: '3 kW HEATER',
        value: '2.5 mm²',
        unit: '25 m · copper',
        note: '13.0 A: 1.5 mm² drops 3.25% (fail), 2.5 mm² drops 1.95% (pass)',
        tone: 'copper',
      },
      {
        badge: 'SAME RUN, 40 m',
        value: '4 mm²',
        unit: 'the answer moves',
        note: '2.5 mm² now drops 3.12% — nothing about the cable changed',
        tone: 'neutral',
      },
    ],
    guidelinesTitle: 'Reading the scene',
    guidelines: [
      {
        tone: 'good',
        badge: 'thin cable',
        text: '<strong>Small cross-section.</strong> High resistance for the length, so more of the source voltage is lost on the way and the load runs starved.',
      },
      {
        tone: 'good',
        badge: 'thick cable',
        text: '<strong>Large cross-section.</strong> Less resistance, a smaller drop, more of the source voltage arriving at the load — and more copper to pay for.',
      },
      {
        tone: 'warning',
        badge: 'NEAR LIMIT',
        text: '<strong>Inside the limit, but tight.</strong> A longer run, a heavier load or a warmer cable would push this over — worth one size up if anything about the job is uncertain.',
      },
      {
        tone: 'excessive',
        badge: 'FAIL',
        text: '<strong>Cable too small for this calculated condition.</strong> The drop is over your selected limit. Upsize, shorten the run, raise the voltage, or choose a different limit deliberately.',
      },
      {
        tone: 'good',
        badge: 'recommended vs selected',
        text: '<strong>Two different things.</strong> The recommendation is the smallest size that passes; you can inspect any other size in the strip without changing it.',
      },
    ],
    notesTitle: 'Things worth knowing',
    notes: [
      {
        icon: 'ruler',
        text: '<strong>Length is linear.</strong> Double the run and you double the drop — the length slider is the fastest way to see a comfortable cable become an uncomfortable one.',
      },
      {
        icon: 'bolt',
        text: '<strong>The load sets the current.</strong> A 100 W lamp draws 0.43 A and almost any cable copes; a 3 kW heater draws 13 A and starts making demands.',
      },
      {
        icon: 'warning',
        text: '<strong>Voltage drop is not the only gate.</strong> Current-carrying capacity, derating for grouping and insulation, and the protective device all have to be checked separately for a real installation.',
      },
      {
        icon: 'gear',
        text: '<strong>These are cold-cable figures.</strong> Resistance is taken at 20 °C; a conductor at its 70 °C working temperature carries roughly 20% more resistance and therefore more drop.',
      },
      {
        icon: 'flask',
        text: '<strong>Copper or aluminium.</strong> Aluminium drops about 1.6× more voltage for the same cross-section — on the heater example, 4 mm² aluminium where 2.5 mm² copper would do.',
      },
      {
        icon: 'reset',
        text: '<strong>Share a scenario.</strong> Every input lives in the URL, so "copy link" hands someone else exactly the run you were looking at.',
      },
    ],
    tip: '<strong>Pro Tip:</strong> switch Lighting → Heater and watch the scene — the load, the demand, the cable thickness, the drop and the verdict all move together. That chain of cause and effect is the whole subject.',
  },
};

/** Any other tool: its own published equations and steps, no borrowed prose. */
const fallback: Copy = {
  title: tool ? `How ${tool.shortName} Works` : 'How this calculator works',
  intro: tool?.description ?? '',
  formulas: (tool?.equations ?? []).slice(0, 4).map((eq) => ({
    label: eq.title.replace(/\s*\(.*\)\s*$/, ''),
    expression: eq.formula,
  })),
  formulaMeta: (tool?.equations ?? []).slice(0, 2).map((eq) => eq.description),
  cards: [],
  guidelinesTitle: 'How to work through it',
  guidelines: (tool?.steps ?? []).map((step, i) => ({
    tone: i === 3 ? 'excessive' : 'good',
    badge: `Step ${i + 1}`,
    text: `<strong>${step.step}:</strong> ${step.instruction}`,
  })),
  notesTitle: '',
  notes: [],
  tip: '',
};

const copy = COPY[tool?.id ?? ''] ?? fallback;
---

<div id="tool-help-backdrop" class="tool-help-backdrop" hidden>
  <div
    id="tool-help-dialog"
    class="tool-help-dialog nice-scroll"
    role="dialog"
    aria-modal="true"
    aria-labelledby="help-modal-title"
  >
    <div class="help-modal-header">
      <div class="help-modal-title-wrap">
        <span class="help-icon-bolt"><EmojiIcon name="bolt" /></span>
        <h2 id="help-modal-title" class="help-modal-title">{copy.title}</h2>
      </div>
      <button type="button" id="tool-help-close" class="btn-help-close" aria-label="Close help modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="help-modal-body">
      {copy.intro && <p class="help-intro">{copy.intro}</p>}

      {
        copy.formulas.length > 0 && (
          <div class="help-formulas-box">
            {copy.formulas.map((row) => (
              <div class="formula-row">
                <span class="formula-label">{row.label}:</span>
                <code set:html={row.expression} />
              </div>
            ))}
            {copy.formulaMeta.length > 0 && (
              <div class="help-formulas-extra">
                <div class="formula-divider"></div>
                <div class="formula-meta">
                  {copy.formulaMeta.map((meta) => <span set:html={meta} />)}
                </div>
              </div>
            )}
          </div>
        )
      }

      {
        copy.cards.length > 0 && (
          <div class="help-materials-grid">
            {copy.cards.map((card) => (
              <div class:list={['material-card', card.tone]}>
                <div class="mat-badge">{card.badge}</div>
                <div class="mat-rho">
                  {card.value} <span class="mat-unit">{card.unit}</span>
                </div>
                <div class="mat-temp">{card.note}</div>
              </div>
            ))}
          </div>
        )
      }

      {
        copy.guidelines.length > 0 && (
          <div class="help-guidelines">
            <h3 class="guidelines-title" set:html={copy.guidelinesTitle} />
            <ul class="guidelines-list">
              {copy.guidelines.map((item) => (
                <li>
                  <strong class={GUIDE_TONE[item.tone]}>{item.badge}</strong>
                  <span set:html={item.text} />
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        copy.notes.length > 0 && (
          <div class="help-field-notes">
            <h3 class="guidelines-title">{copy.notesTitle}</h3>
            <ul class="field-notes-list">
              {copy.notes.map((note) => (
                <li>
                  <EmojiIcon name={note.icon} />
                  <span set:html={note.text} />
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        copy.tip && (
          <div class="help-tip-note">
            <span class="tip-icon"><EmojiIcon name="bulb" /></span>
            <span set:html={copy.tip} />
          </div>
        )
      }
    </div>

    <div class="help-modal-footer">
      <button type="button" id="tool-help-confirm" class="btn-help-gotit">Got It</button>
    </div>
  </div>
</div>

<style>
  .help-intro {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-mid);
  }
  .help-formulas-extra {
    margin-top: 0.6rem;
  }
  .material-card.neutral {
    border-color: var(--border-bright, #bfdbfe);
    background: var(--bg-2, #f8fafc);
  }
  .material-card.neutral .mat-badge {
    color: var(--blue, #2563eb);
  }
  .mat-rho {
    line-height: 1.25;
  }
</style>

<style>
  .tool-help-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    z-index: 100;
  }
  .tool-help-backdrop[hidden] {
    display: none;
  }
  .tool-help-dialog {
    width: 620px;
    max-width: 100%;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    border-radius: var(--radius-lg);
    background: var(--surface-glass, #ffffff);
    border: 1px solid var(--border);
    box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    animation: modalPop 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes modalPop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .help-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .help-modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .help-icon-bolt {
    font-size: 1.3rem;
    color: var(--blue);
  }
  .help-modal-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text);
  }
  .btn-help-close {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    border: none;
    background: transparent;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .btn-help-close:hover {
    background: var(--bg-2);
    color: var(--text);
  }
  .help-modal-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .help-formulas-box {
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--bg-2);
    border: 1px solid var(--border);
    font-family: var(--font-mono, monospace);
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .formula-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .formula-label {
    font-weight: 700;
    color: var(--blue);
    width: 55px;
    flex-shrink: 0;
  }
  .formula-divider {
    height: 1px;
    background: var(--border);
    margin: 0.35rem 0;
  }
  .formula-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .help-materials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .material-card {
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .material-card.copper .mat-badge {
    color: var(--blue);
  }
  .material-card.aluminum .mat-badge {
    color: #f59e0b;
  }
  .mat-badge {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }
  .mat-rho {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text);
  }
  .mat-unit {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-mid);
  }
  .mat-temp {
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-top: 0.2rem;
  }
  .help-guidelines {
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .guidelines-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .guidelines-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
  }
  .guidelines-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.86rem;
    color: var(--text-mid);
    line-height: 1.45;
  }
  .tag-good {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    padding: 0.15rem 0.45rem;
    border-radius: 0.35rem;
    font-size: 0.78rem;
    flex-shrink: 0;
  }
  .tag-warning {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    padding: 0.15rem 0.45rem;
    border-radius: 0.35rem;
    font-size: 0.78rem;
    flex-shrink: 0;
  }
  .tag-excessive {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
    padding: 0.15rem 0.45rem;
    border-radius: 0.35rem;
    font-size: 0.78rem;
    flex-shrink: 0;
  }
  .help-field-notes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .field-notes-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .field-notes-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-mid);
    background: var(--bg-2, #f8fafc);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 0.55rem 0.7rem;
  }
  .field-notes-list li .emoji-icon {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.08rem;
  }
  .field-notes-list strong {
    color: var(--text);
  }
  :root[data-theme='dark'] .field-notes-list li {
    background: rgba(148, 163, 184, 0.06);
  }
  .help-tip-note {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius);
    background: var(--blue-l);
    border: 1px solid var(--border-bright);
    color: var(--blue-ink, var(--text));
    font-size: 0.84rem;
    line-height: 1.5;
  }
  .tip-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .help-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg-2);
  }
  .btn-help-gotit {
    width: 100%;
    height: 2.75rem;
    border-radius: 0.65rem;
    border: none;
    background: var(--action-bg, #2563eb);
    color: var(--action-text, #ffffff);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .btn-help-gotit:hover {
    background: var(--blue-d);
  }
  .btn-help-gotit:active {
    transform: scale(0.99);
  }
</style>
