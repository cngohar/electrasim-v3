---
// NecVoltageDropPanels.astro — Interactive panels for the US NEC Voltage Drop Calculator
import { NEC_CONDUCTORS, NEC_VOLTAGE_PRESETS } from '../../lib/tools/nec-voltage-drop';
import { STANDARD_PROFILES } from '../../lib/tools/standards';
import EmojiIcon from '../EmojiIcon.astro';

const profile = STANDARD_PROFILES['us-nec'];

// Group conductor options so the <select> reads naturally and search engines
// see the full AWG/kcmil ↔ mm² mapping in the SSR markup.
const awgConductors = NEC_CONDUCTORS.filter((c) => !c.isKcmil);
const kcmilConductors = NEC_CONDUCTORS.filter((c) => c.isKcmil);
---

<div class="tool-panels-container">
  <!-- Left Inputs Panel -->
  <section class="calc-panel input-panel" aria-label="Circuit Parameters">
    <div class="panel-header">
      <div class="panel-header-title">
        <svg class="panel-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>Circuit Parameters</span>
      </div>
      <div class="quick-presets-row">
        {NEC_VOLTAGE_PRESETS.filter((p) => p.system !== 'dc').map((p) => (
          <button type="button" class="preset-chip" data-preset-volts={p.volts} data-preset-system={p.system}>
            {p.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Regional standard trust banner (NEC-only tool) -->
    <div class="nec-standard-banner">
      <span class="nec-standard-tag">{profile.badge}</span>
      <p class="standard-citation">
        Results calculated per <strong>{profile.label}</strong>. {profile.citation}
      </p>
    </div>

    <div class="tool-validation-notice" id="nec-validation-notice" role="alert" aria-live="polite" hidden>
      <strong>Check these inputs</strong>
      <p id="nec-validation-message"></p>
      <small>Tip: enter a positive value and use the unit shown beside the field.</small>
    </div>

    <form class="calc-form" id="nec-vd-form" novalidate>
      <!-- System & Voltage -->
      <div class="form-row grid-2">
        <div class="form-group">
          <label for="nec-system">System Type</label>
          <select id="nec-system" name="system" class="calc-select">
            <option value="single" selected>Single-Phase (1-Ø)</option>
            <option value="three">Three-Phase (3-Ø balanced)</option>
            <option value="dc">DC (battery / PV)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="nec-voltage">System Voltage (V)</label>
          <input type="number" id="nec-voltage" name="voltage" value="120" min="1" max="1000" step="any" class="calc-input" />
        </div>
      </div>

      <!-- DC presets only make sense for DC system -->
      <div class="dc-presets-row" id="nec-dc-presets" hidden>
        {NEC_VOLTAGE_PRESETS.filter((p) => p.system === 'dc').map((p) => (
          <button type="button" class="preset-chip" data-preset-volts={p.volts} data-preset-system="dc">
            {p.label}
          </button>
        ))}
      </div>

      <!-- Load & Run -->
      <div class="form-row grid-2">
        <div class="form-group">
          <label for="nec-current">Load Current (Amps)</label>
          <input type="number" id="nec-current" name="current" value="15" step="any" min="0" max="1200" class="calc-input" />
        </div>
        <div class="form-group">
          <label for="nec-length">One-Way Run Length (ft)</label>
          <input type="number" id="nec-length" name="length" value="50" min="1" max="10000" class="calc-input" />
        </div>
      </div>

      <!-- Conductor & Material -->
      <div class="form-row grid-2">
        <div class="form-group">
          <label for="nec-awg">Conductor Size (AWG / kcmil)</label>
          <select id="nec-awg" name="awg" class="calc-select">
            <optgroup label="AWG sizes">
              {awgConductors.map((c) => (
                <option value={c.awg} data-cu={c.copperOhmsPerKft75} data-al={c.aluminumOhmsPerKft75 ?? ''} selected={c.awg === '12'}>
                  {c.awg} AWG — {c.mm2} mm²
                </option>
              ))}
            </optgroup>
            <optgroup label="kcmil sizes">
              {kcmilConductors.map((c) => (
                <option value={c.awg} data-cu={c.copperOhmsPerKft75} data-al={c.aluminumOhmsPerKft75 ?? ''}>
                  {c.awg} — {c.mm2} mm²
                </option>
              ))}
            </optgroup>
          </select>
        </div>
        <div class="form-group">
          <label for="nec-material">Conductor Material</label>
          <select id="nec-material" name="material" class="calc-select">
            <option value="copper" selected>Copper (Cu)</option>
            <option value="aluminum">Aluminum (AA-8000)</option>
          </select>
        </div>
      </div>

      <!-- Temperature & AC behaviour -->
      <div class="derating-box">
        <div class="derating-title">Conductor Operating Conditions</div>
        <div class="form-row grid-3">
          <div class="form-group">
            <label for="nec-temp">Conductor Temp (°C)</label>
            <select id="nec-temp" name="temp" class="calc-select">
              <option value="60">60 °C (TW / UF)</option>
              <option value="75" selected>75 °C (THHN / THWN)</option>
              <option value="90">90 °C (THHN-2 / XHHW-2)</option>
              <option value="30">30 °C (ambient, unloaded)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="nec-pf">Power Factor (cos φ)</label>
            <input type="number" id="nec-pf" name="powerFactor" value="1.00" step="0.01" min="0.5" max="1.0" class="calc-input" />
          </div>
          <div class="form-group">
            <label for="nec-reactance" class="checkbox-label">
              <input type="checkbox" id="nec-reactance" name="reactance" class="calc-checkbox" />
              <span>Include AC reactance (NEC Ch. 9 Table 9 ≈0.045 Ω/kft)</span>
            </label>
          </div>
        </div>
      </div>
    </form>
  </section>

  <!-- Right Results Panel -->
  <section class="calc-panel result-panel" aria-label="Voltage Drop Results">
    <div class="panel-header">
      <div class="panel-header-title">
        <svg class="panel-icon text-emerald" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>Drop & Load-End Voltage</span>
      </div>
      <div class="status-badge-pill" id="nec-status-badge">Within NEC Guidance</div>
    </div>

    <!-- Hero Result Card -->
    <div class="hero-size-card" id="nec-hero-card">
      <div class="hero-size-label">VOLTAGE DROP ON RUN</div>
      <div class="hero-size-val">
        <span id="nec-out-drop-v">2.97</span> <span class="unit">V</span>
        <span class="hero-pct">(<span id="nec-out-drop-pct">2.48</span>%)</span>
      </div>
      <div class="hero-cpc-val">
        Voltage at load: <strong id="nec-out-load-v">117.0 V</strong>
      </div>
    </div>

    <!-- Metrics Grid -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-label">Round-Trip Drop</div>
        <div class="metric-value" id="nec-out-pct2">2.48%</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">3% Advisory Limit</div>
        <div class="metric-value" id="nec-out-limit">3.60 V</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Power Lost as Heat</div>
        <div class="metric-value" id="nec-out-loss">44.6 W</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Conductor Ω / 1000 ft</div>
        <div class="metric-value" id="nec-out-ohms-kft">1.98</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">One-Way Resistance</div>
        <div class="metric-value" id="nec-out-res">0.099 Ω</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Metric Equivalent</div>
        <div class="metric-value" id="nec-out-mm2">3.31 mm²</div>
      </div>
    </div>

    <!-- Summary Notice Box -->
    <div class="compliance-summary-box" id="nec-summary-box">
      <div class="summary-text" id="nec-summary-text">
        Within guidance: 2.97 V drop (2.48%) is under the 3% NEC advisory limit for this branch circuit (NEC 210.19(A) Informational Note No. 4).
      </div>
      <p class="standard-result-echo">
        Result verified against <strong>{profile.label}</strong> — {profile.vdrop.basis}. Conductor resistance from NEC Chapter 9, Table 8 (75 °C, stranded).
      </p>
      <button type="button" class="share-calc-btn" id="nec-copy-link">
        <EmojiIcon name="link" /> Copy calculation link — inputs are encoded in the URL, share it with a colleague
      </button>
    </div>
  </section>
</div>

<style>
  .tool-validation-notice {
    margin: 0 0 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid #f59e0b;
    border-radius: 0.7rem;
    background: #fffbeb;
    color: #92400e;
    font-size: 0.78rem;
  }
  .tool-validation-notice p { margin: 0.2rem 0; }
  .tool-validation-notice small { color: #a16207; }
  :root[data-theme='dark'] .tool-validation-notice { background: rgba(120, 53, 15, 0.24); color: #fde68a; }

  /* Shareable calculation link button */
  .share-calc-btn {
    display: block;
    width: 100%;
    margin-top: 0.7rem;
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    border: 1px dashed rgba(37, 99, 235, 0.45);
    background: rgba(37, 99, 235, 0.06);
    color: var(--blue, #2563eb);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .share-calc-btn:hover, .share-calc-btn:focus-visible {
    background: rgba(37, 99, 235, 0.12);
    border-color: var(--blue, #2563eb);
  }
  .share-calc-btn.copied {
    border-style: solid;
    border-color: #10b981;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
  }

  .nec-standard-banner {
    border: 1px solid rgba(37, 99, 235, 0.25);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
    background: rgba(37, 99, 235, 0.05);
    margin-bottom: 1rem;
  }
  .nec-standard-tag {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #2563eb;
    background: rgba(37, 99, 235, 0.12);
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
    margin-bottom: 0.35rem;
  }
  .standard-citation {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.45;
    color: var(--text-mid, #475569);
  }
  .standard-citation strong {
    color: var(--text-high, #0f172a);
  }
  :root[data-theme='dark'] .nec-standard-banner {
    background: rgba(59, 130, 246, 0.08);
    border-color: rgba(59, 130, 246, 0.35);
  }
  :root[data-theme='dark'] .standard-citation {
    color: #94a3b8;
  }
  :root[data-theme='dark'] .standard-citation strong {
    color: #e2e8f0;
  }
  .dc-presets-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: -0.25rem 0 1rem;
  }
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-mid, #64748b);
    cursor: pointer;
    line-height: 1.35;
  }
  .calc-checkbox {
    width: 1rem;
    height: 1rem;
    margin-top: 0.1rem;
    accent-color: #2563eb;
    flex-shrink: 0;
  }
  .hero-pct {
    font-size: 1.6rem;
    font-weight: 700;
    color: #93c5fd;
    margin-left: 0.35rem;
  }
  .standard-result-echo {
    margin: 0.6rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.45;
    color: #475569;
    border-top: 1px dashed rgba(100, 116, 139, 0.35);
    padding-top: 0.55rem;
  }
  .standard-result-echo strong {
    color: #1e293b;
    white-space: nowrap;
  }
  :root[data-theme='dark'] .standard-result-echo {
    color: #94a3b8;
  }
  :root[data-theme='dark'] .standard-result-echo strong {
    color: #e2e8f0;
  }
  .tool-panels-container {
    display: grid;
    /* minmax(0, …) stops a long value or formula from widening the track */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1rem, 2.5vw, 1.5rem);
    max-width: 1240px;
    margin: clamp(1rem, 3vw, 2rem) auto;
    padding: 0 clamp(0.85rem, 3vw, 1.5rem);
  }
  .calc-panel {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 1.25rem;
    padding: 1.75rem;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05);
  }
  :root[data-theme='dark'] .calc-panel {
    background: #0f172a;
    border-color: #1e293b;
  }
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border, #e2e8f0);
    padding-bottom: 1rem;
  }
  :root[data-theme='dark'] .panel-header {
    border-color: #1e293b;
  }
  .panel-header-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }
  .panel-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--blue, #2563eb);
  }
  .panel-icon.text-emerald {
    color: #10b981;
  }
  .quick-presets-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .preset-chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--bg-2, #f8fafc);
    border: 1px solid var(--border, #cbd5e1);
    color: var(--text-mid, #64748b);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .preset-chip:hover {
    background: var(--blue-l, #eff6ff);
    border-color: var(--blue, #2563eb);
    color: var(--blue, #2563eb);
  }
  :root[data-theme='dark'] .preset-chip {
    background: #1e293b;
    border-color: #334155;
    color: #94a3b8;
  }
  .form-row {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .grid-2 {
    /* minmax(0,1fr): a select sizes itself to its longest option, and `1fr`
       floors at that min-content width — which is how the Max Zs and NEC forms
       ran off a phone screen and got clipped by the page. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .form-group {
    min-width: 0;
  }
  .calc-input,
  .calc-select {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }
  .calc-select {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .grid-3 {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-group label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-mid, #64748b);
  }
  .calc-input,
  .calc-select {
    padding: 0.65rem 0.85rem;
    border-radius: 0.65rem;
    border: 1px solid var(--border, #cbd5e1);
    background: var(--bg, #ffffff);
    color: var(--text, #0f172a);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 600;
    transition: border-color 0.15s ease;
  }
  .calc-input:focus,
  .calc-select:focus {
    outline: none;
    border-color: var(--blue, #2563eb);
  }
  :root[data-theme='dark'] .calc-input,
  :root[data-theme='dark'] .calc-select {
    background: #090e17;
    border-color: #334155;
    color: #f1f5f9;
  }
  .derating-box {
    background: var(--bg-2, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 0.85rem;
    padding: 1rem;
    margin-top: 1rem;
  }
  :root[data-theme='dark'] .derating-box {
    background: #090e17;
    border-color: #1e293b;
  }
  .derating-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-mid, #64748b);
    margin-bottom: 0.75rem;
  }
  .hero-size-card {
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    color: #ffffff;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.25rem;
    box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.3);
  }
  .hero-size-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #bfdbfe;
    margin-bottom: 0.25rem;
  }
  .hero-size-val {
    font-family: var(--font-display);
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1;
  }
  .hero-size-val .unit {
    font-size: 1.5rem;
    font-weight: 600;
    color: #93c5fd;
  }
  .hero-cpc-val {
    font-size: 0.85rem;
    color: #dbeafe;
    margin-top: 0.5rem;
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .metric-card {
    background: var(--bg-2, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 0.75rem;
    padding: 0.75rem;
    text-align: center;
  }
  :root[data-theme='dark'] .metric-card {
    background: #1e293b;
    border-color: #334155;
  }
  .metric-label {
    font-size: 0.7rem;
    color: var(--text-mid, #64748b);
    margin-bottom: 0.2rem;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text, #0f172a);
  }
  .compliance-summary-box {
    border-radius: 0.85rem;
    padding: 1rem;
    font-size: 0.88rem;
    line-height: 1.5;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #065f46;
  }
  .compliance-summary-box.warning {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.4);
    color: #92400e;
  }
  .compliance-summary-box.excessive {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.35);
    color: #991b1b;
  }
  :root[data-theme='dark'] .compliance-summary-box {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
  }
  :root[data-theme='dark'] .compliance-summary-box.warning {
    background: rgba(245, 158, 11, 0.14);
    color: #fbbf24;
  }
  :root[data-theme='dark'] .compliance-summary-box.excessive {
    background: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
  }
  .status-badge-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: #10b981;
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .tool-panels-container {
      grid-template-columns: minmax(0, 1fr);
    }
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tool-panels-container {
      margin-top: 1rem;
      margin-bottom: 2rem;
    }
    .grid-2 {
      grid-template-columns: minmax(0, 1fr);
    }
    .calc-panel {
      padding: 1.1rem 1rem;
      border-radius: 1rem;
    }
    .metrics-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .calc-panel,
    .metric-card {
      transition: none !important;
    }
  }
</style>
