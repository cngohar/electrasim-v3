  }

  .cs2-rows {
    margin: 0.65rem 0 0;
    display: grid;
    gap: 0.15rem;
  }
  .cs2-rows > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.28rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .cs2-rows dt {
    font-size: 0.74rem;
    color: var(--text-mid);
  }
  .cs2-rows dd {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .cs2-checks {
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.3rem;
  }
  .cs2-checks li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    border-radius: 0.55rem;
    background: var(--bg-2);
    font-size: 0.76rem;
  }
  .cs2-checks strong {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
