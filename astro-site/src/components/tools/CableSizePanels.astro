  /* the message sits under the control that caused it, not only at the top */
  .cs2-field-error {
    display: flex;
    align-items: flex-start;
    gap: 0.28rem;
    margin: 0.28rem 0 0;
    color: #a4361c;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .cs2-field-error::before {
    content: '!';
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    margin-top: 0.02rem;
    border-radius: 50%;
    background: #a4361c;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 0.95rem;
    text-align: center;
  }
  .cs2-field-error[hidden] {
    display: none;
  }
  :root[data-theme='dark'] .cs2-field-error {
    color: #ffb4a2;
  }
  .ts-input[aria-invalid='true'] {
    border-color: #d8593c;
    box-shadow: 0 0 0 3px rgb(216 89 60 / 0.16);
  }

  /* the two sentences that make the form feel alive */
  .cs2-system-note,
  .cs2-load-summary {
    margin: 0.4rem 0 0;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--ink-4, #5b6472);
  }
  .cs2-load-summary {
    padding: 0.34rem 0.5rem;
    border-radius: 0.5rem;
    border: 1px dashed #b9c3d3;
    background: #f4f7fc;
    font-variant-numeric: tabular-nums;
  }
  :root[data-theme='dark'] .cs2-load-summary {
    border-color: #46506a;
    background: rgb(255 255 255 / 0.04);
  }
  .cs2-select {
    appearance: none;
    cursor: pointer;
    padding-right: 1.6rem;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-4, #5b6472) 50%),
      linear-gradient(135deg, var(--ink-4, #5b6472) 50%, transparent 50%);
    background-position: calc(100% - 0.95rem) 0.72rem, calc(100% - 0.6rem) 0.72rem;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
  }
  .ts-field--disabled {
    opacity: 0.5;
  }

  /* ── results ───────────────────────────────────────────────────────── */
  .cs2-hero {
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius, 0.75rem);
    border: 1px solid var(--border);
    background: var(--bg-2);
    text-align: center;
  }
  .cs2-hero-eyebrow {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--text-mid);
  }
  .cs2-hero-size {
    margin: 0.15rem 0 0;
    font-family: var(--font-display, sans-serif);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.05;
    color: var(--text);
  }
  .cs2-hero-material {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-mid);
  }
  .cs2-badge-icon--bad {
    display: none;
  }
  .cs2-badge[data-status='fail'] .cs2-badge-icon--ok {
    display: none;
  }
  .cs2-badge[data-status='fail'] .cs2-badge-icon--bad {
    display: inline-block;
  }
  .cs2-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0.5rem 0 0;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    border: 1px solid currentColor;
    color: #15803d;
  }
  .cs2-badge[data-status='near-limit'] {
    color: #a16207;
  }
  .cs2-badge[data-status='fail'] {
    color: #b91c1c;
  }
  .cs2-selected-line {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: var(--text-mid);
  }
  .cs2-selected-line strong {
