  .cs2-why {
    margin: 0.8rem 0 0;
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius, 0.75rem);
    border: 1px solid var(--border);
    background: var(--blue-l, #eff6ff);
  }
  .cs2-why h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-display, sans-serif);
    font-size: 0.9rem;
    color: var(--text);
  }
  .cs2-why p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-mid);
  }
  /*
   * The scope line is a safety boundary, not a footnote: it is the only place
   * the reader is told that a drop-only answer can be undersized. Give it a
   * rule and a tint so it reads as part of the result rather than small print.
   */
  .cs2-scope {
    margin: 0.6rem 0 0;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--border);
    border-left: 3px solid #d98b1f;
    border-radius: 0 0.5rem 0.5rem 0;
    background: rgb(217 139 31 / 0.07);
    font-size: 0.7rem;
    line-height: 1.45;
    color: var(--text-mid);
  }
  .cs2-scope strong {
    color: var(--text);
  }
  #cs2-scope-current {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  :root[data-theme='dark'] .cs2-scope {
    background: rgb(217 139 31 / 0.12);
  }

  /*
   * A rejected input leaves the last good run on screen, which is useful
   * context but must not be mistaken for an answer to the value now in the
   * field. Dim it and say so.
   */
  #cs2-results-container[data-stale='true'] .cs2-hero-size,
  #cs2-results-container[data-stale='true'] .cs2-rows,
  #cs2-results-container[data-stale='true'] .cs2-checks,
  #cs2-results-container[data-stale='true'] .cs2-why {
    opacity: 0.45;
  }
  .cs2-stale-note {
    margin: 0.4rem 0 0;
    font-size: 0.7rem;
    font-weight: 600;
    color: #a4361c;
  }
  .cs2-stale-note[hidden] {
    display: none;
  }
  :root[data-theme='dark'] .cs2-stale-note {
    color: #ffb4a2;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── comparison strip (§20) ────────────────────────────────────────── */
  .cs2-strip {
    position: absolute;
    left: 50%;
    bottom: var(--ts-gutter, 1.25rem);
    transform: translateX(-50%);
    width: min(860px, calc(100% - 2 * var(--ts-panel-w, 336px) - 5rem));
    min-width: min(420px, 60%);
    padding: 0.6rem 0.8rem 0.7rem;
    border-radius: var(--radius-lg, 1rem);
    border: 1px solid var(--border);
    background: var(--surface-glass, rgba(255, 255, 255, 0.96));
    box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.25);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    z-index: 22;
  }
  .cs2-strip-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.45rem;
  }
  .cs2-strip-head h2 {
    margin: 0;
    font-family: var(--font-display, sans-serif);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .cs2-strip-note {
    margin: 0;
    font-size: 0.7rem;
    color: var(--text-mid);
  }
  .cs2-strip-note strong {
    color: var(--blue, #2563eb);
  }
  .cs2-strip-row {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    scrollbar-width: thin;
  }
  .cs2-candidate {
    flex: 1 1 0;
    min-width: 74px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.4rem 0.3rem;
    border-radius: 0.7rem;
    border: 1px solid var(--border);
    background: var(--bg-2);
    color: var(--text-mid);
    font-family: inherit;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .cs2-candidate:hover {
    border-color: var(--border-bright, #94a3b8);
    transform: translateY(-1px);
  }
  .cs2-candidate:focus-visible {
    outline: 2px solid var(--blue, #2563eb);
    outline-offset: 2px;
  }
  .cs2-candidate-size {
    font-family: var(--font-display, sans-serif);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text);
    white-space: nowrap;
  }
  .cs2-candidate-unit {
    margin-left: 0.1rem;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--text-mid);
  }
  .cs2-candidate-status {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #15803d;
  }
  .cs2-candidate[data-status='near-limit'] .cs2-candidate-status {
    color: #a16207;
  }
  .cs2-candidate[data-status='fail'] .cs2-candidate-status {
    color: #b91c1c;
  }
  .cs2-candidate-volts,
  .cs2-candidate-pct {
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }
  .cs2-candidate-pct {
    color: var(--text-mid);
  }
  .cs2-candidate-flag {
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--blue, #2563eb);
    min-height: 0.8rem;
  }
  /* selected = the cable being inspected; recommended = the answer */
  .cs2-candidate[aria-pressed='true'] {
    border-color: var(--blue, #2563eb);
    background: var(--blue-l, #eff6ff);
  }
  .cs2-candidate[data-status='fail'] {
    background: color-mix(in srgb, #b91c1c 8%, var(--bg-2, #f1f5f9));
  }

  /* ── responsive: the strip joins the flow when the panels stack (§26) ─
     the band matches the stacked layout's (scene-stage.js WIDE_STACK) */
  /*
   * Out of the floating layout the strip is page content: static in the stacked
   * grid, static in the drawer's column. `:not([data-layout="float"])` rather
   * than a width query, because the cable stage floats at every laptop size
   * now — it only stacks on paper, as the no-JS fallback.
   */
  @media (max-width: 1500px), (max-height: 780px) {
    :global(.ts-stage:not([data-layout="float"])) .cs2-strip {
      position: static;
      transform: none;
      width: 100%;
      min-width: 0;
      grid-column: 1 / -1;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  /*
   * Floating, the strip has to *fit between the docks*. Centred with a
   * `min-width` of 420px it used to slide under a panel on a 1024px window,
   * where the first candidate was unclickable — the panel's own legend took the
   * click. Spanning the free band makes that impossible by construction.
   */
  :global(.ts-stage[data-layout="float"]) .cs2-strip {
    left: calc(var(--ts-panel-w, 336px) + var(--ts-gutter, 1.25rem) * 1.5);
    right: calc(var(--ts-panel-w, 336px) + var(--ts-gutter, 1.25rem) * 1.5);
    width: auto;
    min-width: 0;
    transform: none;
  }
  /*
   * A folded dock hands its width to the strip, exactly as it does the scene —
   * and the dock that stayed open grows into the space, so the strip has to
   * clear `--ts-panel-w-open` rather than the base tier. (Both are the same
   * variable the dock itself is given, so the two cannot drift apart.)
   */
  :global(.ts-stage[data-layout="float"][data-docks="inputs"]) .cs2-strip {
    left: calc(var(--ts-panel-w-open, min(430px, 46vw)) + var(--ts-gutter, 1.25rem) * 1.5);
  }
  :global(.ts-stage[data-layout="float"][data-docks="results"]) .cs2-strip {
    right: calc(var(--ts-panel-w-open, min(430px, 46vw)) + var(--ts-gutter, 1.25rem) * 1.5);
  }
  :global(.ts-stage[data-layout="float"][data-docks="inputs"]) .cs2-strip,
  :global(.ts-stage[data-layout="float"][data-docks="none"]) .cs2-strip {
    right: calc(3rem + var(--ts-gutter, 1.25rem) * 1.5);
  }
  :global(.ts-stage[data-layout="float"][data-docks="results"]) .cs2-strip,
  :global(.ts-stage[data-layout="float"][data-docks="none"]) .cs2-strip {
    left: calc(3rem + var(--ts-gutter, 1.25rem) * 1.5);
  }
  @media (max-width: 768px) {
    .cs2-strip {
      padding: 0.55rem 0.6rem 0.6rem;
    }
    .cs2-candidate {
      min-width: 68px;
    }
    /*
     * Two chips per row, not one: six single-column cards push the cable and
     * limit fields a full screen down inside the sheet. The name and the
     * rating ("2.2 kW") still fit at half a phone's width.
     */
    .cs2-load-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs2-candidate {
      transition: none;
    }
  }
</style>
