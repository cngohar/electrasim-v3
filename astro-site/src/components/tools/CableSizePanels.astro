  .cs2-validation[hidden] {
    display: none;
  }
  .cs2-validation p {
    margin: 0.2rem 0 0;
  }
  :root[data-theme='dark'] .cs2-validation {
    background: #3a1a12;
    border-color: #7d3a26;
