          <rect x="-15" y="-145" width="190" height="200" rx="8" fill="url(#doorGrad)" stroke="#4a5059" stroke-width="2" />

          <!-- Hazard warning triangle — electrical risk pictogram (vector, no emoji font) -->
          <g transform="translate(80, -50)">
            <polygon points="0,-42 -36,24 36,24" fill="#facc15" stroke="#1e293b" stroke-width="3.5" stroke-linejoin="round" />
            <path d="M2 -30 L-14 -2 L-2 -2 L-6 16 L12 -8 L0 -8 Z" fill="#0f172a" />
          </g>

          <!-- Status Indicator LED -->
          <g id="source-status-led" transform="translate(5, -125)">
            <circle cx="0" cy="0" r="9" fill="#1e293b" />
            <circle cx="0" cy="0" r="6" fill="#22c55e" id="source-led-bulb" class="led-blink" filter="url(#glowGreen)" />
          </g>

          <!-- Main Isolator Handle -->
          <rect x="135" y="-60" width="18" height="42" rx="4" fill="#1e293b" />
          <rect x="138" y="-45" width="12" height="18" rx="2" fill="#ef4444" />

          <!-- High-Voltage Output Weatherhead / Gland (Right Wall: Canvas X 510, Y 395) -->
          <!-- x=190, y=-85 relative to transform(320, 480) -> global (510, 395) -->
          <g id="source-cable-gland" transform="translate(190, -85)">
