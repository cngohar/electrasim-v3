          </g>

          <!-- Front Door: reveal, leaf, panels, a knob, and a step -->
          <rect x="134" y="184" width="72" height="140" rx="4" fill="#25313f" opacity="0.9" />
          <rect x="140" y="190" width="60" height="130" rx="3" fill="url(#doorFace)" stroke="#2a1a0d" stroke-width="1.5" />
          <g class="door-panels" opacity="0.5">
