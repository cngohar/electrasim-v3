---
/**
 * VoltageDropScene.astro - Pure SVG Interactive Physics Scenery
 *
 * One light source, one horizon, and everything sits in the ground: the sun is
 * upper-left, so faces are lit on the left and shaded on the right, contact
 * shadows fall to the right and back, and the lawn is mown in stripes that
 * converge on the horizon. That consistency is most of what reads as "real"
 * rather than "clip-art" — the rest is soft edges (no uniform black outlines)
 * and a vignette so the frame has depth.
 */
type Pt = { x: number; y: number };

/** The vanishing point the ground converges toward (sun-side horizon). */
const HORIZON_Y = 552;
const VANISH: Pt = { x: 700, y: HORIZON_Y };

/** Mown stripes: bands from the near edge to the horizon, narrowing with depth. */
function mownStripes(): Array<{ d: string; o: number }> {
  const out: Array<{ d: string; o: number }> = [];
  const nearY = 812;
  const count = 11;
  for (let i = 0; i < count; i += 1) {
    // spread the fan wider at the bottom than at the horizon
    const t0 = i / count;
    const t1 = (i + 0.55) / count;
    const nearSpan = 2600;
    const farSpan = 1180;
    const x0n = -1080 + t0 * nearSpan;
    const x1n = -1080 + t1 * nearSpan;
    const x0f = VANISH.x - farSpan / 2 + t0 * farSpan;
    const x1f = VANISH.x - farSpan / 2 + t1 * farSpan;
    // the near edge follows the ground curve, so fade the stripes in with depth
    const yNear = nearY;
    const yFar = HORIZON_Y + 6;
    out.push({
      d: `M${x0n.toFixed(0)} ${yNear} L${x0f.toFixed(0)} ${yFar} L${x1f.toFixed(0)} ${yFar} L${x1n.toFixed(0)} ${yNear} Z`,
      o: (0.1 - Math.abs(t0 - 0.45) * 0.06).toFixed(3) as unknown as number,
    });
  }
  return out.map((r) => ({ ...r, o: Number(r.o) }));
}

/** Grass tufts, deterministic (no Math.random in a render). */
function tufts(): Array<{ x: number; y: number; s: number; o: number }> {
  const out: Array<{ x: number; y: number; s: number; o: number }> = [];
  let seed = 20260828;
  const rnd = () => {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 2147483648;
  };
  for (let i = 0; i < 46; i += 1) {
    const depth = rnd();
    const y = 566 + depth * 232;
    const x = -900 + rnd() * 2600;
    out.push({
      x: Math.round(x),
      y: Math.round(y),
      s: Number((0.5 + depth * 1.15).toFixed(2)),
      o: Number((0.18 + depth * 0.3).toFixed(2)),
    });
  }
  return out;
}
const STRIPES = mownStripes();
const TUFTS = tufts();
---

<div id="scene-container" class="scene-container">
  <div id="scene-scaler" class="scene-scaler">
    <div id="scene-perspective-wrapper" class="scene-perspective-wrapper">
      <!--
        The artwork is authored on a 1440x810 canvas. `syncSceneViewBox()` in
        voltage-drop-tool.js rewrites `viewBox` live so the drawing always
        covers the full stage: the composition stays fully visible and any spare
        area is filled with more sky, hills and grass instead of the flat page
        background (that letterboxing was visible on wide/ultrawide monitors).
        The static attribute below is the no-JS fallback.
      -->
      <svg
        id="voltage-drop-svg"
        viewBox="0 0 1440 810"
        preserveAspectRatio="xMidYMid meet"
        width="100%"
        height="100%"
        class="scene-svg"
        role="img"
        aria-label="Interactive electrical scenery illustrating voltage drop from source to load across a cable"
      >
        <defs>
          <!-- Sky Gradients -->
          <linearGradient id="skyGrad" gradientUnits="userSpaceOnUse" x1="0" y1="-120" x2="0" y2="560">
            <stop offset="0%" stop-color="#55b5f0" class="sky-stop-0" />
            <stop offset="52%" stop-color="#a8dcf8" class="sky-stop-52" />
            <stop offset="100%" stop-color="#eefaff" class="sky-stop-100" />
          </linearGradient>

          <radialGradient id="sunAura" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fff7cf" stop-opacity="0.7" class="sun-stop-0" />
            <stop offset="50%" stop-color="#fff1a8" stop-opacity="0.22" class="sun-stop-50" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>

          <linearGradient id="horizonGlow" gradientUnits="userSpaceOnUse" x1="0" y1="258" x2="0" y2="512">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.62" class="horizon-stop" />
          </linearGradient>

          <!-- Mountain & Hill Gradients -->
          <linearGradient id="mountainFar" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#88afc6" class="mt-far-0" />
            <stop offset="100%" stop-color="#b8d2d4" class="mt-far-100" />
          </linearGradient>

          <linearGradient id="mountainNear" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#7da9a5" class="mt-near-0" />
            <stop offset="100%" stop-color="#a7c7af" class="mt-near-100" />
          </linearGradient>

          <linearGradient id="farHillGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#b4d5b9" />
            <stop offset="100%" stop-color="#82ad82" />
          </linearGradient>

          <linearGradient id="midHillGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#92c97b" />
            <stop offset="100%" stop-color="#67a45a" />
          </linearGradient>

          <linearGradient id="grassGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#78bb5e" />
            <stop offset="55%" stop-color="#559a45" />
            <stop offset="100%" stop-color="#347a36" />
          </linearGradient>

          <linearGradient id="pathGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#e9d9aa" />
            <stop offset="100%" stop-color="#cbb27b" />
          </linearGradient>

          <linearGradient id="cloudFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="100%" stop-color="#e5f1f8" />
          </linearGradient>

          <linearGradient id="poleGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#8a929c" />
            <stop offset="50%" stop-color="#6b737e" />
            <stop offset="100%" stop-color="#525a64" />
          </linearGradient>

          <linearGradient id="boxGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#b3b9c1" />
            <stop offset="100%" stop-color="#7b838e" />
          </linearGradient>

          <linearGradient id="doorGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#9aa1ab" />
            <stop offset="100%" stop-color="#818994" />
          </linearGradient>

          <!-- Filters -->
          <filter id="cloudBlur" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="7" />
          </filter>
          <filter id="cloudSoft" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="2.5" />
          </filter>
          <filter id="glowGreen" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter id="glowThermal" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>

          <!-- ══ material shading (single light source: sun at upper-left) ══ -->
          <linearGradient id="wallShade" x1="0" y1="0" x2="1" y2="0.25">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.35" />
            <stop offset="42%" stop-color="#ffffff" stop-opacity="0" />
            <stop offset="100%" stop-color="#0b1a2b" stop-opacity="0.3" />
          </linearGradient>
          <linearGradient id="wallAO" gradientUnits="userSpaceOnUse" x1="0" y1="300" x2="0" y2="430">
            <stop offset="0%" stop-color="#0b1a2b" stop-opacity="0" />
            <stop offset="100%" stop-color="#0b1a2b" stop-opacity="0.34" />
          </linearGradient>
          <linearGradient id="roofGrad" x1="0" y1="0" x2="0.85" y2="1">
            <stop offset="0%" stop-color="#48586e" />
            <stop offset="48%" stop-color="#2a3648" />
            <stop offset="100%" stop-color="#141d2b" />
          </linearGradient>
          <linearGradient id="slateEdge" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#8ea3bd" stop-opacity="0.75" />
            <stop offset="55%" stop-color="#8ea3bd" stop-opacity="0" />
            <stop offset="100%" stop-color="#0b1220" stop-opacity="0.4" />
          </linearGradient>
          <linearGradient id="glassGrad" x1="0.1" y1="0" x2="0.9" y2="1">
            <stop offset="0%" stop-color="#fff9d9" />
            <stop offset="55%" stop-color="#ffe085" />
            <stop offset="100%" stop-color="#f5b93f" />
          </linearGradient>
          <linearGradient id="frameGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#f7fafc" />
            <stop offset="100%" stop-color="#9fb0c4" />
          </linearGradient>
          <linearGradient id="doorFace" x1="0" y1="0" x2="1" y2="0.6">
            <stop offset="0%" stop-color="#7c4a24" />
            <stop offset="55%" stop-color="#5b3418" />
            <stop offset="100%" stop-color="#3d220f" />
          </linearGradient>
          <linearGradient id="cabinetFace" x1="0" y1="0" x2="1" y2="0.4">
            <stop offset="0%" stop-color="#e9eef5" />
            <stop offset="52%" stop-color="#c3cedb" />
            <stop offset="100%" stop-color="#8e9cab" />
          </linearGradient>
          <radialGradient id="lightSpill" cx="50%" cy="18%" r="62%">
            <stop offset="0%" stop-color="#ffd76b" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#ffd76b" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="softShadow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#0c2415" stop-opacity="0.5" />
            <stop offset="62%" stop-color="#0c2415" stop-opacity="0.24" />
            <stop offset="100%" stop-color="#0c2415" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="sceneVignette" cx="50%" cy="44%" r="76%">
            <stop offset="58%" stop-color="#0b1a2b" stop-opacity="0" />
            <stop offset="100%" stop-color="#071322" stop-opacity="0.3" />
          </radialGradient>
          <filter id="softBlur" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="5" />
          </filter>
        </defs>

        <!-- SKY BACKGROUND — oversized so any viewBox the stage needs is covered -->
        <rect x="-4000" y="-4000" width="8000" height="8000" fill="url(#skyGrad)" />
        <rect x="-4000" y="836" width="8000" height="8000" class="ground-deep" />

        <!-- NIGHT STARS (Active when dark mode) -->
        <g class="stars-group" aria-hidden="true">
          <circle cx="120" cy="80" r="1.2" fill="#ffffff" class="star" style="animation-delay: 0.2s;" />
          <circle cx="280" cy="140" r="1.5" fill="#ffffff" class="star" style="animation-delay: 1.1s;" />
          <circle cx="450" cy="65" r="1" fill="#ffffff" class="star" style="animation-delay: 0.7s;" />
          <circle cx="620" cy="110" r="1.8" fill="#ffffff" class="star" style="animation-delay: 1.8s;" />
          <circle cx="780" cy="70" r="1.2" fill="#ffffff" class="star" style="animation-delay: 0.5s;" />
          <circle cx="950" cy="130" r="1.5" fill="#ffffff" class="star" style="animation-delay: 2.2s;" />
          <circle cx="1120" cy="85" r="1.1" fill="#ffffff" class="star" style="animation-delay: 1.4s;" />
          <circle cx="1300" cy="105" r="1.6" fill="#ffffff" class="star" style="animation-delay: 0.9s;" />
          <circle cx="-520" cy="120" r="1.4" fill="#ffffff" class="star" style="animation-delay: 1.9s;" />
          <circle cx="-190" cy="60" r="1" fill="#ffffff" class="star" style="animation-delay: 0.35s;" />
          <circle cx="20" cy="170" r="1.3" fill="#ffffff" class="star" style="animation-delay: 2.4s;" />
          <circle cx="2100" cy="95" r="1.5" fill="#ffffff" class="star" style="animation-delay: 1.15s;" />
          <circle cx="2380" cy="150" r="1.1" fill="#ffffff" class="star" style="animation-delay: 0.55s;" />
          <circle cx="1620" cy="55" r="1.7" fill="#ffffff" class="star" style="animation-delay: 2.05s;" />
        </g>

        <!-- SUN / MOON AURA -->
        <circle cx="460" cy="170" r="220" fill="url(#sunAura)" aria-hidden="true" />
        <rect x="-4000" y="260" width="8000" height="252" fill="url(#horizonGlow)" aria-hidden="true" />

        <!-- CLOUDS -->
        <g class="clouds-group" aria-hidden="true">
          <!-- Cloud 1 -->
          <g class="cloud" style="animation-duration: 48s; animation-delay: 0s;">
            <g transform="translate(0, 80) scale(0.95)" opacity="0.95">
              <ellipse cx="4" cy="15" rx="91" ry="19" fill="#477da4" opacity="0.13" filter="url(#cloudBlur)" />
              <g filter="url(#cloudSoft)" fill="url(#cloudFill)">
                <ellipse cx="0" cy="0" rx="70" ry="26" />
                <ellipse cx="45" cy="-14" rx="52" ry="22" />
                <ellipse cx="-48" cy="-8" rx="44" ry="18" />
                <ellipse cx="12" cy="-26" rx="40" ry="20" />
              </g>
              <ellipse cx="2" cy="-14" rx="56" ry="21" fill="#ffffff" opacity="0.2" />
            </g>
          </g>
          <!-- Cloud 2 -->
          <g class="cloud" style="animation-duration: 62s; animation-delay: -18s;">
            <g transform="translate(0, 140) scale(1.1)" opacity="0.9">
              <ellipse cx="4" cy="15" rx="91" ry="19" fill="#477da4" opacity="0.13" filter="url(#cloudBlur)" />
              <g filter="url(#cloudSoft)" fill="url(#cloudFill)">
                <ellipse cx="0" cy="0" rx="70" ry="26" />
                <ellipse cx="45" cy="-14" rx="52" ry="22" />
                <ellipse cx="-48" cy="-8" rx="44" ry="18" />
                <ellipse cx="12" cy="-26" rx="40" ry="20" />
              </g>
            </g>
          </g>
          <!-- Cloud 3 -->
          <g class="cloud" style="animation-duration: 54s; animation-delay: -32s;">
            <g transform="translate(0, 95) scale(0.75)" opacity="0.85">
              <g filter="url(#cloudSoft)" fill="url(#cloudFill)">
                <ellipse cx="0" cy="0" rx="70" ry="26" />
                <ellipse cx="45" cy="-14" rx="52" ry="22" />
                <ellipse cx="-48" cy="-8" rx="44" ry="18" />
              </g>
            </g>
          </g>
        </g>

        <!-- BIRDS -->
        <g class="birds-group" aria-hidden="true">
          <g transform="translate(540, 160) scale(0.9)" opacity="0.45">
            <g class="bird" style="animation-delay: 0.2s;">
              <path d="M-18 2 Q-10 -7 0 1 Q10 -7 18 2" fill="none" stroke="#35566f" stroke-width="2.4" stroke-linecap="round" />
            </g>
          </g>
          <g transform="translate(580, 145) scale(0.75)" opacity="0.4">
            <g class="bird" style="animation-delay: 0.8s;">
              <path d="M-18 2 Q-10 -7 0 1 Q10 -7 18 2" fill="none" stroke="#35566f" stroke-width="2.4" stroke-linecap="round" />
            </g>
          </g>
          <g transform="translate(615, 170) scale(0.65)" opacity="0.35">
            <g class="bird" style="animation-delay: 1.4s;">
              <path d="M-18 2 Q-10 -7 0 1 Q10 -7 18 2" fill="none" stroke="#35566f" stroke-width="2.4" stroke-linecap="round" />
            </g>
          </g>
        </g>

        <!-- DISTANT MOUNTAINS -->
        <path d="M-1400 505 L-1220 360 L-1040 430 L-860 335 L-660 420 L-420 340 L-40 430 L110 320 L280 390 L460 300 L620 375 L820 285 L990 380 L1160 310 L1340 370 L1480 305 L1680 385 L1900 315 L2120 395 L2340 330 L2560 400 L2840 345 L3100 505 Z" fill="url(#mountainFar)" />
        <path d="M-1400 555 L-1240 420 L-1020 480 L-820 405 L-600 470 L-360 400 L-40 450 L160 360 L350 420 L530 350 L710 415 L910 340 L1080 405 L1270 345 L1480 410 L1700 470 L1940 395 L2180 465 L2420 400 L2660 470 L2840 430 L3100 555 Z" fill="url(#mountainNear)" opacity="0.9" />

        <!-- ROLLING HILLS -->
        <path d="M-1400 560 Q-1150 470 -900 510 T-400 495 T-60 480 Q220 380 520 440 T1100 430 T1500 460 T1950 480 T2400 455 T2840 505 L3100 680 L-1400 680 Z" fill="url(#farHillGrad)" />
        <path d="M-1400 600 Q-1100 520 -800 555 T-300 540 T-60 520 Q300 440 680 490 T1500 480 T2200 515 T2840 550 L3100 750 L-1400 750 Z" fill="url(#midHillGrad)" />

        <!-- BACKGROUND TREES (Grounded & Swaying at base) -->
        <g transform="translate(180, 480) scale(0.65)" class="tree-bg" aria-hidden="true">
          <ellipse cx="0" cy="2" rx="28" ry="6" fill="#1f5d32" opacity="0.16" />
          <g class="tree" style="animation-duration: 5.5s; animation-delay: 0.4s;">
            <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#4a7a46" />
            <circle cx="0" cy="-42" r="24" fill="#4f8a4b" />
            <circle cx="-16" cy="-32" r="16" fill="#467d45" />
            <circle cx="15" cy="-33" r="15" fill="#467d45" />
          </g>
        </g>
        <g transform="translate(340, 500) scale(0.75)" class="tree-bg" aria-hidden="true">
          <ellipse cx="0" cy="2" rx="28" ry="6" fill="#1f5d32" opacity="0.16" />
          <g class="tree" style="animation-duration: 6s; animation-delay: 1.2s;">
            <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#4a7a46" />
            <circle cx="0" cy="-42" r="24" fill="#4f8a4b" />
            <circle cx="-16" cy="-32" r="16" fill="#467d45" />
            <circle cx="15" cy="-33" r="15" fill="#467d45" />
          </g>
        </g>

        <!-- DISTANT HEDGEROWS & EDGE TREES (fill the extended wide-screen area) -->
        <g class="edge-scenery" aria-hidden="true">
          <path d="M-1400 596 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 v40 h-720 z" fill="#3f8048" opacity="0.75" />
          <path d="M1700 600 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 q60 -34 120 0 v40 h-840 z" fill="#3f8048" opacity="0.75" />
          <g transform="translate(-560, 590) scale(0.9)">
            <ellipse cx="0" cy="2" rx="26" ry="6" fill="#1f5d32" opacity="0.2" />
            <g class="tree" style="animation-duration: 6.4s; animation-delay: 0.9s;">
              <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#4a7a46" />
              <circle cx="0" cy="-44" r="23" fill="#467d45" />
              <circle cx="-15" cy="-33" r="15" fill="#3f7a3f" />
              <circle cx="14" cy="-34" r="14" fill="#3f7a3f" />
            </g>
          </g>
          <g transform="translate(1880, 604) scale(0.82)">
            <ellipse cx="0" cy="2" rx="26" ry="6" fill="#1f5d32" opacity="0.2" />
            <g class="tree" style="animation-duration: 5.9s; animation-delay: 1.7s;">
              <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#4a7a46" />
              <circle cx="0" cy="-44" r="23" fill="#467d45" />
              <circle cx="-15" cy="-33" r="15" fill="#3f7a3f" />
              <circle cx="14" cy="-34" r="14" fill="#3f7a3f" />
            </g>
          </g>
        </g>

        <!-- FOREGROUND GRASS & WINDING PATHWAY -->
        <path d="M-1400 640 Q-1100 570 -800 600 T-300 585 T-60 560 Q260 500 640 550 T1500 540 T2100 570 T2840 605 L3100 850 L-1400 850 Z" fill="url(#grassGrad)" />
        <path d="M520 810 C620 730, 680 660, 720 620 C760 580, 840 560, 960 550 C1060 542, 1070 545, 1080 548 L1040 560 C930 570, 840 600, 780 650 C710 710, 640 760, 580 810 Z" fill="url(#pathGrad)" opacity="0.95" />

        <!-- MOWN STRIPES: a fan that converges on the horizon, fading in with
             depth. Flat colour reads as a drawing; a cut lawn reads as a place. -->
        <g class="lawn-detail" aria-hidden="true">
          {STRIPES.map((stripe) => <path d={stripe.d} fill="#ffffff" opacity={stripe.o} />)}
          {STRIPES.map((stripe) => <path d={stripe.d} fill="#0f3a20" opacity={stripe.o * 0.55} transform="translate(26 0)" />)}
          {TUFTS.map((t) => (
            <g transform={`translate(${t.x} ${t.y}) scale(${t.s})`} opacity={t.o}>
              <path d="M0 0 C-2 -6 -5 -9 -6 -12 M0 0 C0 -8 0 -11 1 -14 M0 0 C3 -6 5 -8 7 -11" stroke="#1f4d2b" stroke-width="1.6" fill="none" stroke-linecap="round" />
            </g>
          ))}
        </g>

        <!-- FOREGROUND TREES (LEFT - Grounded & Swaying at trunk base) -->
        <g transform="translate(120, 610) scale(1.15)" aria-hidden="true">
          <ellipse cx="0" cy="2" rx="28" ry="6" fill="#1f5d32" opacity="0.25" />
          <g class="tree" style="animation-duration: 4.8s; animation-delay: 0.1s;">
            <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#6d4f37" />
            <path d="M0 -27 L-11 -40 M0 -34 L12 -45" stroke="#65462f" stroke-width="3" stroke-linecap="round" />
            <circle cx="0" cy="-42" r="24" fill="#3f8a3f" />
            <circle cx="-16" cy="-32" r="16" fill="#37803a" />
            <circle cx="15" cy="-33" r="15" fill="#37803a" />
            <circle cx="-6" cy="-49" r="12" fill="#57a54e" opacity="0.88" />
          </g>
        </g>

        <!-- SOURCE ELECTRICAL CABINET (LEFT) -->
        <!-- Placed at x=320, y=480. Cabinet spans x=290 to x=510, y=320 to y=550 -->
        <g id="source-structure" transform="translate(320, 480)">
          <!-- Ground Shadow -->
          <ellipse cx="96" cy="182" rx="104" ry="20" fill="url(#softShadow)" />

          <!-- Concrete Pillar / Mounting Post -->
          <rect x="55" y="60" width="46" height="120" rx="4" fill="url(#poleGrad)" stroke="#434a52" stroke-width="2" />
          <rect x="42" y="170" width="72" height="16" rx="3" fill="#606872" stroke="#373d44" stroke-width="2" />

          <!-- Main Enclosure (Width 220, from x=-30 to x=190 -> Canvas X 290 to 510) -->
          <rect x="-30" y="-160" width="220" height="230" rx="14" fill="url(#cabinetFace)" stroke="#535a63" stroke-width="2.5" />
          <rect x="-30" y="-160" width="220" height="230" rx="14" fill="url(#wallShade)" opacity="0.5" />
          <!-- weathered capping with a lit top edge, so it is an object in the light -->
