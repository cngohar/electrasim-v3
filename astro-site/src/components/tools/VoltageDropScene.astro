</div>

<style>
  .scene-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #e0f2fe;
    transition: background 0.4s ease;
  }
  :global(:root[data-theme="dark"]) .scene-container {
    background: #0b1526;
  }
  /* Ground below the authored canvas — keeps tall/short viewports on-scenery */
  .ground-deep {
    fill: #2f6f31;
  }
  :global(:root[data-theme="dark"]) .ground-deep {
    fill: #10241f;
  }
  .scene-scaler {
    /* Fills the stage; the SVG's live viewBox handles fit & zoom */
    position: absolute;
    inset: 0;
    display: block;
  }
  .scene-perspective-wrapper {
    width: 100%;
    height: 100%;
    transition: transform 0.25s ease-out;
    transform-style: preserve-3d;
  }
  .scene-svg {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
  }

  /* SVG Scenery Animations */
  @keyframes cloudDrift {
    0% {
      transform: translateX(-1500px);
    }
    100% {
      transform: translateX(2900px);
    }
  }
  .cloud {
    animation: cloudDrift linear infinite;
  }

  @keyframes birdGlide {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(60px, -15px);
    }
    100% {
      transform: translate(120px, 0);
    }
  }
  .bird {
    animation: birdGlide 4.5s ease-in-out infinite;
  }

  /* 
   * TREE SWAY - ANCHORED BASE
   * transform-box: fill-box and transform-origin: 50% 100% guarantees
   * trees rotate strictly around their rooted trunk base, NEVER jumping off ground!
   */
  @keyframes treeSway {
    0%, 100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.8deg);
    }
  }
  .tree {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: treeSway 5.5s ease-in-out infinite;
  }

  @keyframes smokeRise {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.6);
    }
    40% {
      opacity: 0.35;
    }
    100% {
      opacity: 0;
      transform: translate(18px, -55px) scale(1.8);
    }
  }
  .smoke {
    animation: smokeRise 3.5s ease-out infinite;
  }

  @keyframes ledBlink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .led-blink {
    animation: ledBlink 1.4s ease-in-out infinite;
  }

  @keyframes winFlicker {
    0%, 100% {
      opacity: 0.95;
    }
    45% {
      opacity: 0.75;
    }
    75% {
      opacity: 0.9;
    }
  }
  .lawn-detail,
  .scene-vignette,
  .house-shade,
  .house-ao,
  .roof-courses,
  .win-reflection {
    pointer-events: none;
  }
  .win-spill {
    transition: opacity 0.45s ease;
  }
  /* dark mode keeps its shading: the sun is gone, the shape must still read */
  :root[data-theme='dark'] .house-shade {
    opacity: 0.85;
  }
  :root[data-theme='dark'] .lawn-detail {
    opacity: 0.35;
  }
  :root[data-theme='dark'] .win-reflection {
    opacity: 0.3;
  }
  .win-flicker {
    animation: winFlicker 6s ease-in-out infinite;
  }

  @keyframes starTwinkle {
    0%, 100% {
      opacity: 0.3;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }
  .star {
    transform-box: fill-box;
    transform-origin: center;
    animation: starTwinkle 3s ease-in-out infinite;
  }

  /* Thermal Glow Animation */
  @keyframes thermalPulse {
    0%, 100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.9;
    }
  }
