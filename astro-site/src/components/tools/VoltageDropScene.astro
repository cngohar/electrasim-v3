            <rect x="149" y="250" width="42" height="42" rx="2" fill="none" stroke="#2a1a0d" stroke-width="2" />
          </g>
          <path d="M140 190 L146 190 L146 320 L140 320 Z" fill="#ffffff" opacity="0.16" />
          <circle cx="152" cy="258" r="3.6" fill="#fbbf24" stroke="#7c5310" stroke-width="0.8" />
          <rect x="130" y="318" width="80" height="8" rx="2" fill="#5b6a7d" />
          <rect x="130" y="318" width="80" height="2.5" rx="1" fill="#a7b6c9" opacity="0.7" />

          <!-- Windows: the light in them is the readout, so it is drawn as light —
               glass with a warm gradient, a reflection, and a spill down the wall -->
          <g class="window-group">
            <ellipse cx="262" cy="300" rx="66" ry="34" fill="url(#lightSpill)" class="win-spill" />
            <rect x="219" y="174" width="87" height="102" rx="4" fill="#25313f" />
            <rect x="225" y="180" width="75" height="90" rx="3" fill="url(#frameGrad)" />
            <rect x="230" y="185" width="30" height="38" fill="#fde047" class="win-glass win-flicker" />
