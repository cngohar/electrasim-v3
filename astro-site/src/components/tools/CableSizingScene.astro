---
/**
 * CableSizingScene.astro — the live run for the Cable Size Calculator.
 *
 * Cable sizing is a story with two ends, and a drawing that only shows a cable
 * cannot tell it. So the scene shows where the power *leaves* and where it
 * *arrives*:
 *
 *   consumer unit ── cable run ──► appliance (bulb · socket · shower · hob · EV · motor)
 *
 * Everything in between is the calculator's answer, drawn rather than stated:
 *
 *   size (mm²)     → the conductor thickens, and the specimen disc under the run
 *                    grows with it (area, so the radius follows √mm²)
 *   method A–E     → the run takes a different *route*: into the loft, in conduit,
 *                    clipped direct, in a trench, or on tray between supports
 *   length         → how far it hangs between fixings, and the dimension line
 *   ambient · Ci · → heat that cannot get out: the insulation band, the trapped
 *   grouping          arrows bouncing, the glow under the run
 *   volt drop      → the appliance is *starved*: the lamp dims, the motor slows,
 *                    the shower loses its steam — by exactly the computed %
 *   Ib vs Iz       → the MCB in the board warms, then trips
 *   which gate     → the two lamps above the run: heat decides, or volts do
 *
 * Composition rule (learned from a screenshot of a small window): everything
 * informative lives in the band x ∈ [300, 988] of the 1280-unit canvas, because
 * the floating panels cover roughly a third of the stage on each side. Wall,
 * floor and sky are free to run underneath them.
 *
 * State plumbing (shared contract, src/lib/tools/stage-spec.ts): the artwork
 * reads ONLY CSS custom properties, `d` strings and data attributes that
 * `cable-size-tool.js` writes from the calculator result, so the picture can
 * never disagree with the numbers. With JavaScript off, the server-rendered
 * default scenario is already drawn correctly.
 */
import { calculateCableSizing } from '../../lib/tools/cable-sizing/calculation';
import type { CableSizingInputs } from '../../lib/tools/cable-sizing/types';
import { CABLE_RUN, cableRoutePath } from '../../lib/tools/stage-spec';
import CableSizingScene3d from './CableSizingScene3d.astro';

/** Authored canvas; `public/js/scene-stage.js` fits the viewBox to the frame. */
const BASE_W = 1280;
const BASE_H = 760;

/** Mirrors the shipped defaults in CableSizingPanels.astro. */
const DEFAULT_INPUTS: CableSizingInputs = {
  systemType: 'single-phase',
  voltageVolts: 230,
  powerWatts: 7200,
  powerFactor: 1.0,
  runLengthMeters: 18,
  circuitFunction: 'power',
  installationMethod: 'C',
  conductorMaterial: 'copper',
  ambientTempC: 30,
  groupingCircuits: 1,
  thermalInsulationMm: 0,
  fuseTypeCc: false,
};
const r = calculateCableSizing(DEFAULT_INPUTS);

/** Conductor scale: area, so square root — 1.0 mm² → 0, 95 mm² → 1. */
const SIZES = [1.0, 1.5, 2.5, 4, 6, 10, 16, 25, 35, 50, 70, 95] as const as readonly number[];
function sizeFraction(mm2: number): number {
  const min = Math.sqrt(SIZES[0]);
  const max = Math.sqrt(SIZES[SIZES.length - 1]);
  return Number(Math.max(0, Math.min(1, (Math.sqrt(mm2) - min) / (max - min))).toFixed(3));
}
const SIZE_T = sizeFraction(r.selectedCableMm2);
/** The conductor inside the sheath, as a fraction of the sheath itself. */
const CORE_T = Number((0.34 + SIZE_T * 0.42).toFixed(3));
const SAG_T = Number(
  Math.max(0, Math.min(1, (DEFAULT_INPUTS.runLengthMeters - 1) / 140)).toFixed(3),
);

/** The run, drawn once for the server; the client re-writes `d` from the result. */
const ROUTE_D = cableRoutePath(DEFAULT_INPUTS.installationMethod, DEFAULT_INPUTS.runLengthMeters);

const SPEC = { x: 649, y: 624, rad: 37 };
const FLOW_DOTS = 9;
const NEIGHBOURS = 6;

const delivered = Number(Math.max(0.55, 1 - r.voltageDropPercent / 100).toFixed(3));
const utilisation = Number(
  Math.max(0, Math.min(1.4, r.requiredAmpacityIt / r.cableAmpacityIz)).toFixed(3),
);
const dropRatio = Number(
  Math.max(
    0,
    Math.min(1.6, r.voltageDropPercent / Math.max(0.5, r.maxPermissibleVdropPercent)),
  ).toFixed(3),
);
const styleVars = `--size:${SIZE_T}; --core:${CORE_T}; --drop:${dropRatio}; --util:${utilisation}; --sag:${SAG_T}; --delivered:${delivered}; --heat:0.36; --cool:0.92; --insul:0; --explode:0.42; --flow:1.60s;`;
---

<div
  id="cs-scene-root"
  class:list={['cs-scene', 'ts-scene-scaler', 'active']}
  data-method={DEFAULT_INPUTS.installationMethod}
  data-status={r.status}
  data-constraint={r.limitingConstraint}
  data-material={DEFAULT_INPUTS.conductorMaterial}
  data-neighbours={Math.min(DEFAULT_INPUTS.groupingCircuits - 1, NEIGHBOURS)}
  data-insulation={DEFAULT_INPUTS.thermalInsulationMm}
  data-ambient="mild"
  data-selected={r.selectedCableMm2}
  data-load={DEFAULT_INPUTS.circuitFunction === 'lighting' ? 'lighting' : 'socket'}
  data-near={dropRatio > 0.97 ? 'over' : dropRatio > 0.8 ? 'tight' : 'ok'}
  data-length={DEFAULT_INPUTS.runLengthMeters}
  style={styleVars}
>
  <div id="cs-scene-tilt" class="ts-scene-tilt">
    <svg
      id="cs-cutaway-svg"
      class="ts-scene-svg"
      viewBox={`0 0 ${BASE_W} ${BASE_H}`}
      preserveAspectRatio="xMidYMid slice"
      role="img"
      aria-label="A cable run from a consumer unit on the left to an appliance on the right: the run's thickness, route, temperature and the voltage the appliance actually receives are all drawn from the calculator's answer"
    >
      <defs>
        {/* ── the run, defined once; every stroke and every flow dot follows it ── */}
        <path id="cs-run-path" d={ROUTE_D} fill="none" />

        <linearGradient id="cs-room" gradientUnits="userSpaceOnUse" x1="0" y1="120" x2="0" y2="760">
          <stop offset="0%" stop-color="#f4f8fd" class="cs-room-0" />
          <stop offset="58%" stop-color="#eaf0f8" class="cs-room-1" />
          <stop offset="100%" stop-color="#dfe7f1" class="cs-room-2" />
        </linearGradient>
        <linearGradient id="cs-wall" gradientUnits="userSpaceOnUse" x1="0" y1="200" x2="0" y2="560">
          <stop offset="0%" stop-color="#f8fafc" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#e3ebf5" stop-opacity="0.72" />
        </linearGradient>
        <linearGradient id="cs-ground" gradientUnits="userSpaceOnUse" x1="0" y1="556" x2="0" y2="760">
          <stop offset="0%" stop-color="#c8ab84" stop-opacity="0.62" />
          <stop offset="100%" stop-color="#8d7149" stop-opacity="0.78" />
        </linearGradient>
        <linearGradient id="cs-copper" gradientUnits="userSpaceOnUse" x1="420" y1="0" x2="880" y2="0">
          <stop offset="0%" stop-color="#f0a369" />
          <stop offset="50%" stop-color="#c86a2e" />
          <stop offset="100%" stop-color="#e08a4d" />
        </linearGradient>
        <linearGradient id="cs-alu" gradientUnits="userSpaceOnUse" x1="420" y1="0" x2="880" y2="0">
          <stop offset="0%" stop-color="#e7eef5" />
          <stop offset="50%" stop-color="#aebccb" />
          <stop offset="100%" stop-color="#d3dde7" />
        </linearGradient>
        <linearGradient id="cs-sheen" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#414f68" />
          <stop offset="46%" stop-color="#232d3f" />
          <stop offset="100%" stop-color="#0f1521" />
        </linearGradient>
        <linearGradient id="cs-insul-band" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fdf3d2" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#e9cf94" stop-opacity="0.85" />
        </linearGradient>
        <linearGradient id="cs-metal" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#f1f5f9" />
          <stop offset="55%" stop-color="#cbd5e1" />
          <stop offset="100%" stop-color="#94a3b8" />
        </linearGradient>
        <radialGradient id="cs-lamp" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fff8d6" stop-opacity="0.98" />
          <stop offset="46%" stop-color="#ffd66b" stop-opacity="0.72" />
          <stop offset="100%" stop-color="#ffb020" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="cs-heat" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ff8a3d" stop-opacity="0.8" />
          <stop offset="55%" stop-color="#ff4d4d" stop-opacity="0.3" />
          <stop offset="100%" stop-color="#ff4d4d" stop-opacity="0" />
        </radialGradient>
        <pattern id="cs-grid" width="64" height="64" patternUnits="userSpaceOnUse">
          <path d="M64 0H0v64" fill="none" stroke="rgba(37, 99, 235, 0.06)" stroke-width="1" />
        </pattern>
        <pattern id="cs-brick" width="46" height="24" patternUnits="userSpaceOnUse">
          <path d="M0 23h46M23 0v23" fill="none" stroke="rgba(120, 96, 66, 0.3)" stroke-width="1.2" />
        </pattern>
        <marker id="cs-arrow-flow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M0 1 L8 5 L0 9 z" class="cs-arrow-head" />
        </marker>
        <filter id="cs-soft" x="-45%" y="-45%" width="190%" height="190%">
          <feGaussianBlur stdDeviation="9" />
        </filter>
        <filter id="cs-glow" x="-70%" y="-70%" width="240%" height="240%">
          <feGaussianBlur stdDeviation="5" result="b" />
          <feMerge>
            <feMergeNode in="b" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <clipPath id="cs-section-clip">
          <rect x="272" y="120" width="742" height="560" rx="18" />
        </clipPath>
      </defs>

      {/* ══ the room: cut away so the run, the board and the appliance are visible ══
           Painted far beyond any viewBox the fit can choose (capped at 2.6× the
           canvas), so a gap between backdrop and panel edge cannot exist. */}
      <g class="cs-world">
        <rect x="-4000" y="-4000" width="8000" height="8000" fill="url(#cs-room)" class="cs-bg" />
        <rect x="-4000" y="-4000" width="8000" height="8000" fill="url(#cs-grid)" class="cs-grid" />
        <rect x="-4000" y="120" width="8000" height="440" fill="url(#cs-wall)" class="cs-wall" />
        <path d="M-4000 560 H4000" class="cs-floor-line" />
        <rect x="-4000" y="560" width="8000" height="240" fill="url(#cs-ground)" class="cs-ground" />
        <rect x="-4000" y="560" width="8000" height="240" fill="url(#cs-brick)" class="cs-ground-texture" />
        {/* ceiling line + the loft void above it (method A lives here) */}
        <path d="M-4000 208 H4000" class="cs-ceiling-line" />
        <rect x="-4000" y="120" width="8000" height="88" class="cs-loft" />
      </g>

      <g clip-path="url(#cs-section-clip)">
        {/* ══ the loft insulation, thickening with Ci ══ */}
        <g class="cs-env cs-env--loft">
          <rect x="280" y="126" width="726" class="cs-insul-band" height={20} rx="6" />
          <path d="M292 146 h702" class="cs-insul-fleck" />
          <path d="M292 136 h702" class="cs-insul-fleck cs-insul-fleck--faint" />
          <text class="cs-env-label" x="298" y="172">loft · in insulation (method A)</text>
        </g>

        {/* ══ conduit along the wall (method B) ══ */}
        <g class="cs-env cs-env--conduit">
          <rect x="430" y="356" width="440" height="30" rx="15" class="cs-conduit" />
          <rect x="430" y="356" width="440" height="10" rx="5" class="cs-conduit-hi" />
          <text class="cs-env-label" x="436" y="332">in conduit on the wall (method B)</text>
        </g>

        {/* ══ clips, direct to the surface (method C) ══
              The clips are the run itself with a dashed stroke: they grip the
              cable wherever it happens to hang, instead of sitting in a row that
              only matches one length. */}
        <g class="cs-env cs-env--clips">
          <use href="#cs-run-path" class="cs-clip-marks" />
          <text class="cs-env-label" x="470" y="504">clipped direct (method C)</text>
        </g>

        {/* ══ the trench (method D) ══ */}
        <g class="cs-env cs-env--soil">
          <path d="M436 560 h440 v96 h-440 z" class="cs-trench" />
          <path d="M436 560 h440" class="cs-trench-lip" />
          <text class="cs-env-label" x="446" y="648">buried in ground (method D)</text>
        </g>

        {/* ══ the tray (method E), with its spacers ══ */}
        <g class="cs-env cs-env--tray">
          <path d="M432 300 h452" class="cs-tray-rail" />
          <path d="M432 318 h452" class="cs-tray-rail" />
          {
            [0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
              <path class="cs-tray-rung" d={`M${452 + i * 58} 298 v22`} />
            ))
          }
          <text class="cs-env-label" x="436" y="280">on tray in free air (method E)</text>
        </g>

        {/* ══ neighbour circuits sharing the same containment ══
              Each one is the run's own path, pushed down a few units: circuits in
              a conduit, tray or bundle follow the same route, and the row of
              separate curves I had here only lined up with one method. */}
        <g class="cs-neighbours" aria-hidden="true">
          {
            Array.from({ length: NEIGHBOURS }, (_, i) => (
              <use
                href="#cs-run-path"
                class:list={['cs-neighbour', `cs-neighbour--${i + 1}`]}
                style={`--n:${i + 1}`}
              />
            ))
          }
        </g>

        {/* ══ heat: how hard it is trying to get out, and whether it can ══ */}
        <g class="cs-heat" aria-hidden="true">
          <!-- the warm body hugs the path (a wide blurred stroke of the same `d`),
               so it stays welded to the run however the route bends -->
          <use href="#cs-run-path" class="cs-run-heat" />
          <use href="#cs-run-path" class="cs-run-rise" />
          {/* placement on the wrapper, animation on the marks: a CSS transform
              replaces the `transform` attribute, so they must not share an
              element or every arrow snaps to the canvas origin */}
          <g class="cs-arrows">
            {
              [0, 1, 2, 3, 4, 5, 6].map((i) => (
                <g transform={`translate(${482 + i * 52} 424)`}>
                  <path class="cs-arrow" style={`--i:${i}`} d="M0 9 L8 1 L16 9" />
                  <path class="cs-arrow cs-arrow-tail" style={`--i:${i}`} d="M0 17 L8 9 L16 17" />
                </g>
              ))
            }
            {
              [0, 1, 2].map((i) => (
                <g transform={`translate(${548 + i * 96} 398)`}>
                  <path class="cs-bounce" style={`--i:${i}`} d="M0 0 L8 8 L16 0" />
                </g>
              ))
            }
          </g>
        </g>

        {/* ══ the run itself: sheath, conductor, then current ══ */}
        <g class="cs-run">
          <use href="#cs-run-path" class="cs-run-shadow" />
          <use href="#cs-run-path" class="cs-run-sheen" />
          <use href="#cs-run-path" class="cs-run-core" />
          <use href="#cs-run-path" class="cs-run-hot" />
        </g>

        {/* direction of power, spelled out */}
        <g class="cs-flow" aria-hidden="true">
          {
            Array.from({ length: FLOW_DOTS }, (_, i) => (
              <circle class="cs-flow-dot" r="3.1">
                <animateMotion
                  dur="1.6s"
                  begin={`${(-i * 1.6) / FLOW_DOTS}s`}
                  repeatCount="indefinite"
                  path={ROUTE_D}
                  keyPoints="0;1"
                  keyTimes="0;1"
                  calcMode="linear"
                />
              </circle>
            ))
          }
        </g>
        <path class="cs-flow-dir" d="M640 508 h58" marker-end="url(#cs-arrow-flow)" />
      </g>

      {/* ══ the source: where the power comes from ══ */}
      <g class="cs-source">
        {/* incoming service tail from off-canvas left */}
        <path class="cs-service" d="M292 222 q62 6 82 26" marker-end="url(#cs-arrow-flow)" />
        <text class="cs-service-label" x="296" y="212">service intake</text>

        {/* meter */}
        <g class="cs-meter">
          <rect x="322" y="252" width="96" height="64" rx="9" class="cs-box" />
          <rect x="336" y="266" width="46" height="22" rx="4" class="cs-meter-screen" />
          <circle cx="404" cy="284" r="7" class="cs-meter-led" />
<text class="cs-box-tag" x="370" y="308" text-anchor="middle">meter</text>
        </g>

        {/* consumer unit with the protective device visible */}
        <g class="cs-board">
          <rect x="316" y="366" width="138" height="132" rx="10" class="cs-box cs-box--board" />
          <rect x="326" y="378" width="118" height="14" rx="4" class="cs-rail" />
          {
            [0, 1, 2, 3].map((i) => (
              <g class:list={['cs-device', { 'cs-device--live': i === 0 }]} transform={`translate(${330 + (i % 2) * 60} ${398 + Math.floor(i / 2) * 34})`}>
                <rect width="48" height="24" rx="4" class="cs-device-body" />
                <rect x="8" y="8" width="14" height="8" rx="2" class="cs-device-toggle" />
              </g>
            ))
          }
          <g class="cs-mcb" transform="translate(330 462)">
            <rect width="118" height="26" rx="5" class="cs-mcb-body" />
            <rect x="10" y="7" width="20" height="12" rx="3" class="cs-mcb-toggle" />
            <text class="cs-mcb-label" x="108" y="18" text-anchor="end" id="cs-tag-device">
              40 A MCB
            </text>
          </g>
          <!-- Two short stacked lines rather than one long one: the caption is
               anchored at the left edge of the safe band, and a single wide line
               ran under the floating inputs panel at some window sizes. -->
          <text class="cs-cluster-label" x="316" y="340">SOURCE</text>
          <text class="cs-cluster-value" x="316" y="360" id="cs-tag-source">230 V 1-Φ</text>
        </g>
      </g>

      {/* ══ the load: where the power goes — and what it actually gets ══ */}
      <g class="cs-load">
        <text class="cs-cluster-label" x="990" y="340" text-anchor="end">LOAD</text>
        <text class="cs-cluster-value cs-load-volt" x="990" y="360" text-anchor="end" id="cs-tag-load">
          223.7 V · 2.75%
        </text>

        {/* a lighting run: the lamp is the volt-drop meter */}
        <g class="cs-load--lighting">
          <path d="M858 388 h104" class="cs-fit-rail" />
          <path d="M905 388 v26" class="cs-fit-flex" />
          <g class="cs-lamp">
            <circle class="cs-lamp-glow" cx="905" cy="440" r="54" fill="url(#cs-lamp)" />
            <path d="M893 414 h24 v10 h-24 z" class="cs-lamp-cap" />
            <path d="M888 424 q0 -6 17 -6 q17 0 17 6 q0 26 -17 26 q-17 0 -17 -26 z" class="cs-lamp-glass" />
            <path d="M898 440 q7 -10 14 0" class="cs-lamp-filament" />
          </g>
          <text class="cs-load-note" x="915" y="526" text-anchor="middle">dimming = spent volt drop</text>
        </g>

        {/* a 13 A socket radial */}
        <g class="cs-load--socket">
          <rect x="864" y="404" width="102" height="102" rx="12" class="cs-plate" />
          <rect x="884" y="428" width="62" height="54" rx="8" class="cs-socket-face" />
          <g class="cs-pins">
            <rect x="898" y="440" width="9" height="16" rx="2" />
            <rect x="923" y="440" width="9" height="16" rx="2" />
            <rect x="910" y="462" width="10" height="14" rx="2" />
          </g>
          <circle class="cs-load-led" cx="950" cy="418" r="4.4" />
          <text class="cs-load-note" x="915" y="526" text-anchor="middle">13 A socket · 5% ceiling</text>
        </g>

        {/* a shower: heat that you can see */}
        <g class="cs-load--shower">
          <path d="M866 396 h70 q26 0 26 26" class="cs-pipe" />
          <path d="M954 422 l-22 22 h44 z" class="cs-head" />
          {
            [0, 1, 2, 3, 4, 5].map((i) => (
              <path class:list={['cs-spray', `cs-spray--${i + 1}`]} d={`M${934 - 14 + i * 6} 450 q0 22 -4 34`} style={`--i:${i}`} />
            ))
          }
          <g class="cs-steam">
            <path d="M890 470 q10 -12 0 -24 q-10 -12 0 -24" />
            <path d="M872 476 q10 -12 0 -24" />
          </g>
          <text class="cs-load-note" x="915" y="526" text-anchor="middle">shower: heat is the gate</text>
        </g>

        {/* an induction hob: two zones, both on */}
        <g class="cs-load--hob">
          <rect x="858" y="430" width="118" height="66" rx="10" class="cs-hob-top" />
          <g class="cs-hob-zone cs-hob-zone--1">
            <circle cx="894" cy="462" r="21" class="cs-hob-ring" />
            <circle cx="894" cy="462" r="12" class="cs-hob-hot" />
          </g>
          <g class="cs-hob-zone cs-hob-zone--2">
            <circle cx="944" cy="462" r="17" class="cs-hob-ring" />
            <circle cx="944" cy="462" r="9" class="cs-hob-hot" />
          </g>
          <text class="cs-load-note" x="915" y="526" text-anchor="middle">all zones on: no diversity</text>
        </g>

        {/* an EV wallbox: the charge state is the load profile */}
        <g class="cs-load--ev">
          <rect x="862" y="396" width="70" height="84" rx="10" class="cs-wallbox" />
          <rect x="872" y="408" width="50" height="26" rx="5" class="cs-wallbox-screen" />
          <path d="M896 448 l-8 14 h10 l-6 12" class="cs-bolt" />
          <path d="M932 452 q34 6 40 34" class="cs-charge-cord" />
          <g class="cs-car">
            <path d="M948 486 q10 -20 34 -20 h18 q16 0 20 14 l0 16 h-72 z" class="cs-car-body" />
            <circle cx="972" cy="500" r="8" class="cs-wheel" />
            <circle cx="1010" cy="500" r="8" class="cs-wheel" />
          </g>
          <g class="cs-battery">
            <rect x="866" y="490" width="62" height="16" rx="4" class="cs-battery-shell" />
            <rect x="869" y="493" width="14" height="10" rx="2" class="cs-battery-cell" />
            <rect x="886" y="493" width="14" height="10" rx="2" class="cs-battery-cell" />
            <rect x="903" y="493" width="14" height="10" rx="2" class="cs-battery-cell cs-battery-cell--next" />
            <rect x="920" y="493" width="5" height="10" rx="2" class="cs-battery-nub" />
          </g>
          <text class="cs-load-note" x="915" y="526" text-anchor="middle">hours at full load, every night</text>
        </g>

        {/* a motor: heavy inductive load, and the clearest volt-drop victim */}
        <g class="cs-load--motor">
          <rect x="862" y="396" width="104" height="86" rx="14" class="cs-motor-body" />
          {
            [0, 1, 2, 3, 4, 5].map((i) => <path class="cs-motor-fin" d={`M${872 + i * 17} 402 v74`} />)
          }
          <rect x="966" y="430" width="18" height="18" rx="3" class="cs-motor-shaft-collar" />
          <path d="M984 439 h14" class="cs-motor-shaft" />
          <g class="cs-fan" transform="translate(1014 439)">
            <circle r="14" class="cs-fan-hub" />
            {
              [0, 1, 2, 3].map((i) => (
                <path class="cs-fan-blade" d="M0 0 q10 -4 13 6 q-8 2 -13 -6 z" transform={`rotate(${i * 90})`} />
              ))
            }
          </g>
          <text class="cs-load-note" x="915" y="526" text-anchor="middle">fan speed tracks delivered volts</text>
          <text class="cs-load-note cs-load-start" x="915" y="546" text-anchor="middle">6× Ib for a second on start</text>
        </g>
      </g>

      {/* ══ the two gates: which one actually set the size ══ */}
      <!-- shifted down so the lamps keep breathing room below the frame's top
           edge when the layout is a short banner -->
      <g class="cs-gates" role="presentation" transform="translate(0 44)">
        <g class="cs-gate cs-gate--thermal" transform="translate(478 152)">
          <rect width="170" height="34" rx="17" class="cs-gate-body" />
          <circle cx="20" cy="17" r="6" class="cs-gate-lamp" />
          <text class="cs-gate-text" x="34" y="15">heat · Iz ≥ It</text>
          <text class="cs-gate-sub" x="34" y="28" id="cs-tag-iz">Iz 46 A ≥ It 40.0 A</text>
        </g>
        <g class="cs-gate cs-gate--drop" transform="translate(664 152)">
          <rect width="170" height="34" rx="17" class="cs-gate-body" />
          <circle cx="20" cy="17" r="6" class="cs-gate-lamp" />
          <text class="cs-gate-text" x="34" y="15">volts · ≤ {r.maxPermissibleVdropPercent}%</text>
          <text class="cs-gate-sub" x="34" y="28" id="cs-tag-gate-drop">{r.voltageDropPercent.toFixed(2)}% of the ceiling</text>
        </g>
        <text class="cs-gate-verdict" x="649" y="206" text-anchor="middle" id="cs-tag-gate">
          heat decides
        </text>
      </g>

      {/* ══ the specimen: the same cable, magnified ══ */}
      <g class="cs-specimen" aria-label="Magnified cross-section of the cable that was chosen">
        <!-- each shell peels away from the conductor as the Explode slider opens -->
        <g class="cs-peel cs-peel--sheath" style="--i:2">
          <circle cx={SPEC.x} cy={SPEC.y} r={SPEC.rad + 11} class="cs-disc-outer" />
        </g>
        <g class="cs-peel cs-peel--insulation" style="--i:1">
          <circle cx={SPEC.x} cy={SPEC.y} r={SPEC.rad} class="cs-disc" />
          <circle cx={SPEC.x} cy={SPEC.y} r={SPEC.rad * 0.8} class="cs-disc-insul" />
        </g>
        <g class="cs-peel cs-peel--conductor" style="--i:0">
          <circle cx={SPEC.x} cy={SPEC.y} class="cs-spec-conductor" r={9 + SIZE_T * 10} />
        </g>
        <g class="cs-peel cs-peel--cpc" style="--i:-1">
          <circle
            cx={SPEC.x - SPEC.rad * 0.58}
            cy={SPEC.y + SPEC.rad * 0.52}
            r={4 + sizeFraction(r.cpcCableMm2) * 6}
            class="cs-spec-cpc-core"
          />
        </g>
        <text class="cs-spec-caption" x={SPEC.x} y={SPEC.y - SPEC.rad - 18} text-anchor="middle" id="cs-tag-cable">
          {r.selectedCableMm2.toFixed(1)} mm² copper · {DEFAULT_INPUTS.runLengthMeters} m
        </text>
      </g>

      {/* dimension line under the run: the length the drop is computed over */}
      <g class="cs-dim" aria-hidden="true">
        <path d={`M${CABLE_RUN.source.x} 694 H${CABLE_RUN.load.x}`} class="cs-dim-line" />
        <path d={`M${CABLE_RUN.source.x} 688 v12M${CABLE_RUN.load.x} 688 v12`} class="cs-dim-tick" />
        <text class="cs-dim-label" x="330" y="688" id="cs-tag-dim">
          {DEFAULT_INPUTS.runLengthMeters} m one-way
        </text>
      </g>
    </svg>

    <!-- the opt-in WebGL orbit view lives beside the SVG, not inside it -->
    <CableSizingScene3d />
  </div>
</div>

<style>
  /* ── world ─────────────────────────────────────────────────────────────── */
  .cs-scene {
    --line: rgba(71, 85, 105, 0.5);
    --ink: #1f2937;
    --ink-soft: rgba(31, 41, 55, 0.72);
    --panel: rgba(255, 255, 255, 0.72);
  }
  :global(:root[data-theme='dark']) .cs-scene {
    --line: rgba(148, 163, 184, 0.42);
    --ink: #e6edf7;
    --ink-soft: rgba(226, 232, 240, 0.66);
    --panel: rgba(15, 23 42, 0.5);
    --panel: rgba(15, 23, 42, 0.5);
  }
  .cs-bg,
  .cs-grid {
    opacity: 0.98;
  }
  :global(:root[data-theme='dark']) .cs-room-0 {
    stop-color: #101a2c;
  }
  :global(:root[data-theme='dark']) .cs-room-1 {
    stop-color: #0d1626;
  }
  :global(:root[data-theme='dark']) .cs-room-2 {
    stop-color: #0a1220;
  }
  .cs-wall {
    stroke: none;
  }
  :global(:root[data-theme='dark']) .cs-wall {
    opacity: 0.5;
  }
  .cs-floor-line,
  .cs-ceiling-line {
    stroke: var(--line);
    stroke-width: 2;
    fill: none;
  }
  .cs-loft {
    fill: rgba(203, 213, 225, 0.28);
  }
  :global(:root[data-theme='dark']) .cs-loft {
    fill: rgba(30, 41, 59, 0.5);
  }
  .cs-ground {
    opacity: 0.85;
  }
  .cs-ground-texture {
    opacity: 0.35;
  }
  :global(:root[data-theme='dark']) .cs-ground {
    opacity: 0.55;
  }

  /* ── typography on the artwork ─────────────────────────────────────────── */
  text {
    font-family: var(--font-sans, system-ui, sans-serif);
    fill: var(--ink);
  }
  .cs-env-label,
  .cs-service-label,
  .cs-load-note,
  .cs-box-tag,
  .cs-mcb-label,
  .cs-gate-sub,
  .cs-dim-label {
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--ink-soft);
  }
  .cs-cluster-label {
    font-family: var(--font-display, sans-serif);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    fill: #2563eb;
  }
  .cs-cluster-value {
    font-family: var(--font-display, sans-serif);
    font-size: 17px;
    font-weight: 800;
    fill: var(--ink);
    white-space: nowrap;
  }
  .cs-spec-caption {
    font-family: var(--font-display, sans-serif);
    font-size: 13px;
    font-weight: 800;
    fill: var(--ink);
  }

  /* ── the run: one path, four strokes, all driven by --size ─────────────── */
  .cs-run-shadow,
  .cs-run-sheen,
  .cs-run-core,
  .cs-run-hot {
    fill: none;
    stroke-linecap: round;
    transition: stroke-width 0.28s ease;
  }
  .cs-run-shadow {
    stroke: rgba(15, 23, 42, 0.2);
    stroke-width: calc(11px + var(--size) * 15px);
    transform: translateY(5px);
  }
  .cs-run-sheen {
    stroke: url(#cs-sheen);
    stroke-width: calc(10px + var(--size) * 15px);
  }
  .cs-run-core {
    stroke: url(#cs-copper);
    stroke-width: calc(2px + var(--size) * 8px);
    stroke-dasharray: 2 9;
    opacity: 0.95;
  }
  .cs-scene[data-material='aluminum'] .cs-run-core {
    stroke: url(#cs-alu);
  }
  /* the heat the conductor cannot shed, drawn on the cable itself */
  .cs-run-hot {
    stroke: #ff5a2b;
    stroke-width: calc(4px + var(--size) * 12px);
    opacity: calc(var(--util, 0.3) * var(--util, 0.3) * 0.9);
    filter: url(#cs-soft);
  }
  .cs-flow-dir {
    stroke: #2563eb;
    stroke-width: 2.6;
    fill: none;
    opacity: 0.75;
  }
  .cs-arrow-head {
    fill: #2563eb;
  }
  .cs-flow-dot {
    fill: #ffd66b;
    opacity: 0.92;
  }
  .cs-scene[data-material='aluminum'] .cs-flow-dot {
    fill: #cbd5e1;
  }
  .cs-scene[data-status='fail'] .cs-flow-dot {
    fill: #ef4444;
  }
  /* the device has opened: nothing downstream is alive any more */
  .cs-scene[data-status='fail'] .cs-load-led,
  .cs-scene[data-status='fail'] .cs-meter-led {
    fill: #dc2626;
    animation-duration: 0.7s;
  }
  .cs-scene[data-status='fail'] .cs-lamp-glow,
  .cs-scene[data-status='fail'] .cs-hob-hot {
    opacity: 0.08;
  }

  /* ── environments: only the method in play is drawn ───────────────────── */
  .cs-env {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cs-scene[data-method='A'] .cs-env--loft,
  .cs-scene[data-method='B'] .cs-env--conduit,
  .cs-scene[data-method='C'] .cs-env--clips,
  .cs-scene[data-method='D'] .cs-env--soil,
  .cs-scene[data-method='E'] .cs-env--tray {
    opacity: 1;
  }
  .cs-insul-band {
    fill: url(#cs-insul-band);
    /* the loft band thickens with Ci: 0 mm → 20 mm, 200 mm → 92 px */
    transform: scaleY(calc(0.22 + var(--insul) * 3.4));
    transform-origin: 0 126px;
    transform-box: fill-box;
  }
  .cs-insul-fleck {
    stroke: rgba(180, 140, 70, 0.55);
    stroke-width: 2;
    stroke-dasharray: 12 16;
    fill: none;
  }
  .cs-insul-fleck--faint {
    opacity: 0.6;
  }
  .cs-conduit {
    fill: rgba(148, 163, 184, 0.4);
    stroke: var(--line);
    stroke-width: 1.6;
  }
  .cs-conduit-hi {
    fill: rgba(255, 255, 255, 0.55);
  }
  .cs-clip {
    stroke: #475569;
    stroke-width: 2.4;
    fill: none;
    opacity: 0.8;
  }
  .cs-trench {
    fill: rgba(120, 92, 56, 0.22);
    stroke: rgba(120, 92, 56, 0.5);
    stroke-width: 2;
    stroke-dasharray: 7 6;
  }
  .cs-trench-lip {
    stroke: #4d7c4f;
    stroke-width: 4;
    fill: none;
  }
  .cs-tray-rail {
    stroke: #64748b;
    stroke-width: 3;
    fill: none;
  }
  .cs-tray-rung {
    stroke: #94a3b8;
    stroke-width: 2;
    fill: none;
    opacity: 0.8;
  }

  /* grouped neighbours appear one at a time as the count grows */
  .cs-neighbour {
    fill: none;
    stroke: url(#cs-sheen);
    stroke-width: calc(6px + var(--size) * 6px);
    opacity: 0;
    transform: translateY(calc(var(--n) * 9px));
    transition: opacity 0.3s ease;
  }
  .cs-scene[data-neighbours='1'] .cs-neighbour--1,
  .cs-scene[data-neighbours='2'] .cs-neighbour--1,
  .cs-scene[data-neighbours='2'] .cs-neighbour--2,
  .cs-scene[data-neighbours='3'] .cs-neighbour--1,
  .cs-scene[data-neighbours='3'] .cs-neighbour--2,
  .cs-scene[data-neighbours='3'] .cs-neighbour--3,
  .cs-scene[data-neighbours='4'] .cs-neighbour--1,
  .cs-scene[data-neighbours='4'] .cs-neighbour--2,
  .cs-scene[data-neighbours='4'] .cs-neighbour--3,
  .cs-scene[data-neighbours='4'] .cs-neighbour--4,
  .cs-scene[data-neighbours='5'] .cs-neighbour--1,
  .cs-scene[data-neighbours='5'] .cs-neighbour--2,
  .cs-scene[data-neighbours='5'] .cs-neighbour--3,
  .cs-scene[data-neighbours='5'] .cs-neighbour--4,
  .cs-scene[data-neighbours='5'] .cs-neighbour--5,
  .cs-scene[data-neighbours='6'] .cs-neighbour {
    opacity: 0.72;
  }

  /* ── heat: rising when it can, trapped when it cannot ───────────────────
     The warm body is a wide blurred stroke of the run's own path, so it stays
     welded to the cable however the route bends. */
  .cs-run-heat {
    fill: none;
    stroke: #ff5a2b;
    stroke-width: calc(24px + var(--size) * 34px);
    stroke-linecap: round;
    opacity: calc(var(--heat) * 0.4 * (1.35 - var(--cool, 1) * 0.5));
    filter: url(#cs-soft);
  }
  .cs-scene[data-status='fail'] .cs-run-heat {
    animation: csAlarm 1.9s ease-in-out infinite;
  }
  @keyframes csAlarm {
    0%,
    100% {
      opacity: calc(var(--heat) * 0.55);
    }
    50% {
      opacity: calc(var(--heat) * 0.95);
    }
  }
  /* a shimmer marching along the run: heat travelling down the cable */
  .cs-run-rise {
    fill: none;
    stroke: rgba(251, 113, 133, 0.6);
    stroke-width: calc(15px + var(--size) * 16px);
    stroke-dasharray: 5px 46px;
    opacity: calc(0.1 + (1 - var(--cool, 1)) * 0.55);
    animation: csShimmer 3.2s linear infinite;
  }
  @keyframes csShimmer {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -51px;
    }
  }
  .cs-arrow,
  .cs-bounce {
    fill: none;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cs-arrow {
    stroke: #fb7185;
    opacity: calc(0.18 + var(--cool) * 0.62);
    animation: csRise 2.9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.34s);
  }
  .cs-arrow-tail {
    stroke: rgba(251, 113, 133, 0.45);
  }
  .cs-bounce {
    stroke: #f59e0b;
    opacity: calc(0.26 + (1 - var(--cool)) * 0.62);
    animation: csTrapped 1.7s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.5s);
  }
  .cs-arrows {
    transition: transform 0.28s ease;
  }
  /* the arrows stand where the enclosure is, per method */
  .cs-scene[data-method='A'] .cs-arrows {
    transform: translateY(-184px);
  }
  .cs-scene[data-method='B'] .cs-arrows {
    transform: translateY(-56px);
  }
  .cs-scene[data-method='C'] .cs-arrows {
    transform: translateY(28px);
  }
  .cs-scene[data-method='D'] .cs-arrows {
    transform: translateY(188px);
  }
  .cs-scene[data-method='E'] .cs-arrows {
    transform: translateY(-118px);
  }
  @keyframes csRise {
    0% {
      transform: translateY(6px);
      opacity: 0;
    }
    35% {
      opacity: calc(0.24 + var(--cool) * 0.6);
    }
    100% {
      transform: translateY(-46px);
      opacity: 0;
    }
  }
  @keyframes csTrapped {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(9px);
    }
  }
  .cs-scene[data-ambient='hot'] .cs-run-heat {
    opacity: calc(var(--heat) * 0.68);
  }
  /* buried in 200 mm of insulation: there is nowhere for the heat to rise to */
  .cs-scene[data-insulation='200'] .cs-arrow {
    opacity: 0.1;
  }

  /* ── the source board ──────────────────────────────────────────────────── */
  .cs-service {
    stroke: #334155;
    stroke-width: 6;
    fill: none;
    stroke-linecap: round;
  }
  .cs-box {
    fill: url(#cs-metal);
    stroke: var(--line);
    stroke-width: 2;
  }
  .cs-box--board {
    fill: #f8fafc;
  }
  :global(:root[data-theme='dark']) .cs-box--board {
    fill: #16213a;
  }
  .cs-meter-screen {
    fill: #0f172a;
    opacity: 0.85;
  }
  .cs-meter-led {
    fill: #22c55e;
    animation: csBlink 3.4s steps(1, end) infinite;
  }
  @keyframes csBlink {
    0%,
    84% {
      opacity: 1;
    }
    85%,
    100% {
      opacity: 0.25;
    }
  }
  .cs-rail {
    fill: #cbd5e1;
    opacity: 0.7;
  }
  .cs-device-body {
    fill: #e2e8f0;
    stroke: #94a3b8;
    stroke-width: 1.2;
  }
  .cs-device-toggle {
    fill: #475569;
  }
  .cs-mcb-body {
    fill: #eef2f7;
    stroke: #94a3b8;
    stroke-width: 1.4;
  }
  .cs-mcb-toggle {
    fill: #2563eb;
  }
  .cs-mcb-label {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 12.5px;
    fill: var(--ink);
  }
  /* the device reacting to how close the cable is to its limit */
  .cs-mcb {
    transition: filter 0.3s ease;
  }
  .cs-scene[data-near='tight'] .cs-mcb-body {
    stroke: #d97706;
    stroke-width: 2.4;
  }
  .cs-scene[data-near='tight'] .cs-mcb-toggle {
    fill: #d97706;
  }
  .cs-scene[data-near='over'] .cs-mcb-body {
    stroke: #dc2626;
    stroke-width: 3;
    animation: csTrip 1.1s ease-in-out infinite;
  }
  .cs-scene[data-near='over'] .cs-mcb-toggle {
    fill: #dc2626;
    transform: translateY(4px) rotate(-14deg);
    transform-origin: 12px 12px;
  }
  @keyframes csTrip {
    0%,
    100% {
      filter: none;
    }
    50% {
      filter: drop-shadow(0 0 6px rgba(220, 38, 38, 0.85));
    }
  }

  /* ── the load: what the appliance does with what it is given ───────────── */
  .cs-load > g {
    display: none;
  }
  .cs-scene[data-load='lighting'] .cs-load--lighting,
  .cs-scene[data-load='socket'] .cs-load--socket,
  .cs-scene[data-load='shower'] .cs-load--shower,
  .cs-scene[data-load='hob'] .cs-load--hob,
  .cs-scene[data-load='ev'] .cs-load--ev,
  .cs-scene[data-load='motor'] .cs-load--motor {
    display: block;
  }
  .cs-load-volt {
    fill: #16a34a;
  }
  .cs-scene[data-near='tight'] .cs-load-volt {
    fill: #d97706;
  }
  .cs-scene[data-near='over'] .cs-load-volt {
    fill: #dc2626;
  }
  .cs-fit-rail {
    stroke: #94a3b8;
    stroke-width: 3;
  }
  .cs-fit-flex {
    stroke: #334155;
    stroke-width: 4;
    fill: none;
  }
  /* brightness is the delivered fraction of nominal — the volt drop, seen */
  .cs-lamp-glow {
    opacity: calc((var(--delivered) - 0.5) * 2);
    transform: scale(calc(0.72 + var(--delivered) * 0.5));
    transform-origin: 905px 440px;
    transform-box: view-box;
  }
  .cs-lamp-glass {
    fill: rgba(255, 244, 200, calc(0.25 + var(--delivered) * 0.6));
    stroke: #cbd5e1;
    stroke-width: 1.4;
  }
  .cs-lamp-filament {
    stroke: #f59e0b;
    stroke-width: 2.2;
    fill: none;
    opacity: calc(var(--delivered) * 1.05);
  }
  .cs-lamp-cap {
    fill: url(#cs-metal);
  }
  .cs-plate,
  .cs-socket-face {
    fill: #f8fafc;
    stroke: var(--line);
    stroke-width: 2;
  }
  .cs-socket-face {
    fill: #eef2f7;
  }
  :global(:root[data-theme='dark']) .cs-plate,
  :global(:root[data-theme='dark']) .cs-socket-face,
  :global(:root[data-theme='dark']) .cs-wallbox {
    fill: #1b2740;
  }
  .cs-pins rect {
    fill: #334155;
  }
  .cs-load-led {
    fill: #22c55e;
    animation: csBlink 2.6s steps(1, end) infinite;
  }
  .cs-pipe {
    stroke: url(#cs-metal);
    stroke-width: 7;
    fill: none;
    stroke-linecap: round;
  }
  .cs-head {
    fill: url(#cs-metal);
    stroke: var(--line);
    stroke-width: 1.4;
  }
  .cs-spray {
    stroke: #60a5fa;
    stroke-width: 2.4;
    fill: none;
    opacity: calc(0.25 + var(--delivered) * 0.7);
    animation: csFall 1.1s linear infinite;
    animation-delay: calc(var(--i) * 0.16s);
  }
  @keyframes csFall {
    0% {
      transform: translateY(-6px);
      opacity: 0;
    }
    30% {
      opacity: calc(0.3 + var(--delivered) * 0.6);
    }
    100% {
      transform: translateY(14px);
      opacity: 0;
    }
  }
  .cs-steam path {
    stroke: #cbd5e1;
    stroke-width: 3;
    fill: none;
    opacity: calc(var(--util) * 0.7);
    animation: csSteam 3.6s ease-in-out infinite;
  }
  @keyframes csSteam {
    0% {
      transform: translateY(6px);
      opacity: 0;
    }
    40% {
      opacity: calc(var(--util) * 0.6);
    }
    100% {
      transform: translateY(-22px);
      opacity: 0;
    }
  }
  .cs-hob-top {
    fill: #0f172a;
    opacity: 0.9;
    stroke: var(--line);
    stroke-width: 1.6;
  }
  .cs-hob-ring {
    fill: none;
    stroke: #64748b;
    stroke-width: 2;
  }
  .cs-hob-hot {
    fill: #ff5a2b;
    opacity: calc(0.16 + var(--util) * 0.84);
    animation: csPulse 2.4s ease-in-out infinite;
  }
  .cs-hob-zone--2 .cs-hob-hot {
    animation-delay: 1.1s;
  }
  @keyframes csPulse {
    0%,
    100% {
      opacity: calc(0.2 + var(--util) * 0.7);
    }
    50% {
