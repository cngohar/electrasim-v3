---
import { calculateCableSizing } from '../../lib/tools/cable-sizing/calculation';
import type { CableSizingInputs } from '../../lib/tools/cable-sizing/types';
import { cableRoutePath } from '../../lib/tools/stage-spec';
import CableSizingScene3d from './CableSizingScene3d.astro';

const BASE_W = 1280;
const BASE_H = 760;
const DEFAULT_INPUTS: CableSizingInputs = {
  systemType: 'single-phase', voltageVolts: 230, powerWatts: 7200, powerFactor: 1,
  runLengthMeters: 18, circuitFunction: 'power', installationMethod: 'C',
  conductorMaterial: 'copper', ambientTempC: 30, groupingCircuits: 1,
  thermalInsulationMm: 0, fuseTypeCc: false,
};
const result = calculateCableSizing(DEFAULT_INPUTS);
const sizes = [1, 1.5, 2.5, 4, 6, 10, 16, 25, 35, 50, 70, 95];
const sizeT = Math.min(1, Math.max(0, (Math.sqrt(result.selectedCableMm2) - 1) / (Math.sqrt(95) - 1)));
const route = cableRoutePath('C', 18);
const dropRatio = Math.min(1.6, result.voltageDropPercent / result.maxPermissibleVdropPercent);
const style = `--core:${(0.34 + sizeT * .32).toFixed(3)};--drop:${dropRatio.toFixed(3)};--heat:.35;--cool:.92;--insul:0;--explode:.42;--flow:1.6s;`;
---

<div id="cs-scene-root" class="cs-scene ts-scene-scaler active" data-method="C" data-status={result.status} data-constraint={result.limitingConstraint} data-material="copper" data-neighbours="0" data-insulation="0" data-ambient="mild" data-selected={result.selectedCableMm2} data-load="socket" data-near="ok" data-length="18" style={style}>
  <div id="cs-scene-tilt" class="ts-scene-tilt">
    <svg id="cs-cutaway-svg" class="ts-scene-svg" viewBox={`0 0 ${BASE_W} ${BASE_H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label="Interactive cable sizing workbench showing a consumer unit, a layered cable run, and a load. The cable layers separate to explain how installation conditions affect capacity.">
      <defs>
        <linearGradient id="cs-bg" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#101b32"/><stop offset=".56" stop-color="#162944"/><stop offset="1" stop-color="#0b1324"/></linearGradient>
        <linearGradient id="cs-bench" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#223a55"/><stop offset="1" stop-color="#0d192c"/></linearGradient>
        <linearGradient id="cs-copper" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#ffd09b"/><stop offset=".32" stop-color="#e07a35"/><stop offset=".7" stop-color="#a9451e"/><stop offset="1" stop-color="#f3a15e"/></linearGradient>
        <linearGradient id="cs-aluminium" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#f8fafc"/><stop offset=".45" stop-color="#93a4b8"/><stop offset=".8" stop-color="#dbe5ef"/><stop offset="1" stop-color="#728399"/></linearGradient>
        <linearGradient id="cs-jacket" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#43617f"/><stop offset=".45" stop-color="#213751"/><stop offset="1" stop-color="#122339"/></linearGradient>
        <linearGradient id="cs-orange" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#ffb15c"/><stop offset="1" stop-color="#ef5c35"/></linearGradient>
        <radialGradient id="cs-heat"><stop stop-color="#ff673d" stop-opacity=".65"/><stop offset="1" stop-color="#ff673d" stop-opacity="0"/></radialGradient>
        <pattern id="cs-grid" width="48" height="48" patternUnits="userSpaceOnUse"><path d="M48 0H0v48" fill="none" stroke="#80a9d0" stroke-opacity=".11"/></pattern>
        <pattern id="cs-dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#9bc4e8" fill-opacity=".22"/></pattern>
        <filter id="cs-glow"><feGaussianBlur stdDeviation="8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="cs-shadow"><feGaussianBlur in="SourceAlpha" stdDeviation="10"/><feOffset dy="8"/><feComponentTransfer><feFuncA type="linear" slope=".4"/></feComponentTransfer><feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <marker id="cs-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 10 5 0 10z" fill="#8bd5ff"/></marker>
        <path id="cs-run-path" d={route} fill="none"/>
      </defs>

      <rect class="cs-bg" x="-100" y="-100" width="1480" height="960" fill="url(#cs-bg)"/>
      <rect x="0" y="0" width="1280" height="520" fill="url(#cs-grid)"/>
      <path d="M0 520H1280V760H0z" fill="url(#cs-bench)"/>
      <path d="M0 520H1280" stroke="#6ea6cf" stroke-opacity=".35"/>
      <path d="M0 580H1280M0 640H1280M0 700H1280" stroke="#8db6d8" stroke-opacity=".08"/>
      <text x="54" y="64" class="cs-kicker">CABLE SIZING / LIVE INSTALLATION MODEL</text>
      <text x="54" y="94" class="cs-title">From source to load — every layer has a job</text>
      <text x="54" y="122" class="cs-subtitle">Change the inputs to see capacity, heat and voltage travel through the run.</text>

      <!-- left: source instrument -->
      <g class="cs-source" filter="url(#cs-shadow)">
        <rect x="70" y="226" width="210" height="246" rx="18" fill="#e7eef7" stroke="#8bb0cf" stroke-width="2"/>
        <rect x="86" y="244" width="178" height="42" rx="9" fill="#172b45"/>
        <text x="104" y="270" class="cs-device-label">CONSUMER UNIT</text>
        <rect x="102" y="310" width="56" height="112" rx="8" fill="#c8d5e3" stroke="#8299af"/>
        <rect x="174" y="310" width="56" height="112" rx="8" fill="#c8d5e3" stroke="#8299af"/>
        <rect x="112" y="325" width="36" height="48" rx="4" fill="#18273a"/><rect x="184" y="325" width="36" height="48" rx="4" fill="#18273a"/>
        <circle cx="130" cy="348" r="8" class="cs-led"/><circle cx="202" cy="348" r="8" class="cs-led cs-led--warm"/>
        <path d="M130 392v20M202 392v20" stroke="#4c6380" stroke-width="6"/>
        <text x="130" y="452" text-anchor="middle" class="cs-micro">In</text><text x="202" y="452" text-anchor="middle" class="cs-micro">MCB</text>
      </g>
      <g class="cs-pill"><rect x="76" y="492" width="198" height="32" rx="16"/><text x="175" y="513" text-anchor="middle" id="cs-tag-source">230 V 1-Φ</text></g>

      <!-- middle: the measurable run -->
      <g class="cs-run-zone">
        <path d={route} stroke="#08111f" stroke-width="56" stroke-linecap="round" opacity=".7"/>
        <path d={route} stroke="#5c7691" stroke-width="48" stroke-linecap="round" stroke-dasharray="3 16" opacity=".8"/>
        <path d={route} class="cs-run-jacket" stroke="url(#cs-jacket)" stroke-width="38" stroke-linecap="round"/>
        <path d={route} class="cs-run-sheen" stroke="#8eb2d2" stroke-opacity=".25" stroke-width="4" stroke-linecap="round"/>
        <path d={route} class="cs-run-heat" stroke="url(#cs-heat)" stroke-width="72" opacity=".6" filter="url(#cs-glow)"/>
        <path d={route} class="cs-run-core" stroke="url(#cs-copper)" stroke-width="calc(6px + var(--core) * 18px)" stroke-linecap="round"/>
        <g class="cs-flow" aria-hidden="true"><circle r="5" class="cs-flow-dot"><animateMotion dur="var(--flow)" repeatCount="indefinite"><mpath href="#cs-run-path"/></animateMotion></circle><circle r="5" class="cs-flow-dot"><animateMotion dur="var(--flow)" begin="-.8s" repeatCount="indefinite"><mpath href="#cs-run-path"/></animateMotion></circle><circle r="5" class="cs-flow-dot"><animateMotion dur="var(--flow)" begin="-1.6s" repeatCount="indefinite"><mpath href="#cs-run-path"/></animateMotion></circle></g>
      </g>

      <!-- callouts: physical meaning, not decoration -->
      <g class="cs-callout"><path d="M430 350V270h-92"/><circle cx="430" cy="350" r="4"/><rect x="316" y="218" width="178" height="52" rx="10"/><text x="332" y="239" class="cs-callout-head">CONTAINMENT</text><text x="332" y="257" class="cs-callout-copy">route + cooling method</text></g>
      <g class="cs-callout"><path d="M628 430v100h-92"/><circle cx="628" cy="430" r="4"/><rect x="438" y="532" width="206" height="54" rx="10"/><text x="454" y="553" class="cs-callout-head">THERMAL WINDOW</text><text x="454" y="571" class="cs-callout-copy">Iz ≥ It after derating</text></g>
      <g class="cs-callout"><path d="M850 350V270h-62"/><circle cx="850" cy="350" r="4"/><rect x="714" y="218" width="198" height="52" rx="10"/><text x="730" y="239" class="cs-callout-head">DELIVERED VOLTAGE</text><text x="730" y="257" class="cs-callout-copy" id="cs-tag-load">— V · —%</text></g>
      <g class="cs-pill"><rect x="476" y="374" width="352" height="48" rx="24"/><text x="652" y="394" text-anchor="middle" id="cs-tag-cable">7.2 mm² copper · 18 m</text><text x="652" y="410" text-anchor="middle" class="cs-pill-sub" id="cs-tag-dim">18 m one-way</text></g>
      <g class="cs-pill cs-pill--dark"><rect x="520" y="612" width="264" height="34" rx="17"/><text x="652" y="634" text-anchor="middle" id="cs-tag-gate">heat decides</text></g>
      <g class="cs-pill cs-method-badge"><rect x="492" y="456" width="320" height="30" rx="15"/><text x="652" y="476" text-anchor="middle" id="cs-tag-method">METHOD C · CLIPPED DIRECT</text></g>

      <!-- right: load and result -->
      <g class="cs-load" filter="url(#cs-shadow)">
        <rect x="1000" y="230" width="210" height="242" rx="18" fill="#10253d" stroke="#6e9fc5" stroke-width="2"/>
        <text x="1024" y="264" class="cs-device-label cs-device-label--light">LOAD END</text>
        <circle cx="1105" cy="340" r="63" fill="#172f4a" stroke="#8fc9ee" stroke-width="3"/>
        <circle cx="1105" cy="340" r="46" class="cs-lamp-glow" fill="url(#cs-heat)"/><path d="M1081 335q24-34 48 0l-7 24h-34z" fill="#ffe7a4" stroke="#ffc45b"/><path d="M1090 365h30M1095 374h20" stroke="#ffb34d" stroke-width="5" stroke-linecap="round"/>
        <text x="1105" y="431" text-anchor="middle" class="cs-micro cs-micro--light" id="cs-tag-iz">Iz — ≥ It —</text>
        <text x="1105" y="454" text-anchor="middle" class="cs-micro cs-micro--light" id="cs-tag-device">MCB — A</text>
      </g>

      <!-- bottom workbench: cross-section specimen -->
      <g class="cs-specimen" transform="translate(105 575)">
        <text x="0" y="0" class="cs-section-title">CUTAWAY / SELECTED CONDUCTOR</text>
        <g transform="translate(52 45)"><circle r="56" fill="#0b1526" stroke="#80a7c7" stroke-width="2"/><circle r="46" fill="#263e58" stroke="#91b4d0" stroke-width="2"/><circle r="35" fill="#142840" stroke="#4d779d" stroke-width="2"/><circle r="24" fill="url(#cs-copper)" class="cs-spec-conductor"/><circle r="12" fill="#ffd49d" opacity=".8"/></g>
        <path d="M108 575v-36M122 575v-24M136 575v-13" stroke="#9bd8ff" stroke-width="2" marker-end="url(#cs-arrow)" transform="translate(0 -485)" opacity=".6"/>
        <text x="130" y="72" class="cs-micro">JACKET</text><text x="130" y="88" class="cs-micro">INSULATION</text><text x="130" y="104" class="cs-micro">COPPER CORE</text>
      </g>
      <g class="cs-readout" transform="translate(930 590)"><rect width="280" height="86" rx="14" fill="#0c1b2e" stroke="#4f789c"/><text x="18" y="25" class="cs-callout-head">SIZING GATES</text><text x="18" y="48" class="cs-micro cs-micro--light" id="cs-tag-gate-drop">—% of —% ceiling</text><text x="18" y="68" class="cs-micro cs-micro--light" id="cs-tag-iz-readout">Iz ≥ It</text></g>
    </svg>
  </div>
  <CableSizingScene3d />
</div>

<style>
  .cs-scene{width:100%;height:100%;color:#d9efff;font-family:var(--font-mono,monospace);background:#101b32;overflow:hidden}
  .cs-scene .cs-bg{transition:fill .3s ease}.cs-run-zone{transform-box:fill-box;transform-origin:center;transform:perspective(900px) rotateX(4deg) translateZ(4px)}.cs-source,.cs-load{transform-box:fill-box;transform-origin:center;transition:transform .3s ease}.cs-source{transform:perspective(900px) rotateY(2deg) translateZ(5px)}.cs-load{transform:perspective(900px) rotateY(-2deg) translateZ(8px)}.cs-title{font:800 25px var(--font-display,sans-serif);fill:#ecf7ff;letter-spacing:-.02em}.cs-kicker,.cs-callout-head,.cs-section-title{font:800 10px var(--font-mono,monospace);letter-spacing:.14em;fill:#8bd5ff}.cs-subtitle,.cs-callout-copy{font:500 12px var(--font-mono,monospace);fill:#94b2ca}.cs-device-label{font:800 11px var(--font-mono,monospace);letter-spacing:.12em;fill:#17314e}.cs-device-label--light,.cs-micro--light{fill:#d8edff}.cs-micro{font:700 10px var(--font-mono,monospace);fill:#5d7690}.cs-led{fill:#45e5a0;filter:url(#cs-glow)}.cs-led--warm{fill:#ffbd63}.cs-run-core{transition:stroke-width .35s ease}.cs-run-heat{opacity:calc(.15 + var(--heat) * .7);transition:opacity .3s}.cs-flow-dot{fill:#9de3ff;filter:url(#cs-glow)}.cs-callout path{fill:none;stroke:#78b9db;stroke-opacity:.7;stroke-dasharray:3 4}.cs-callout circle{fill:#9de3ff}.cs-callout rect,.cs-pill rect{fill:#142943;fill-opacity:.94;stroke:#4c7799;stroke-opacity:.8}.cs-pill text{font:800 11px var(--font-mono,monospace);letter-spacing:.04em;fill:#dff4ff}.cs-pill-sub{font-size:9px!important;fill:#83b3d2!important}.cs-pill--dark rect{fill:#0b192c}.cs-lamp-glow{opacity:calc(.2 + var(--delivered, .95) * .7);transition:opacity .35s}.cs-spec-conductor{stroke-width:calc(1px + var(--core) * 4px)}.cs-readout rect{fill-opacity:.94}.cs-scene[data-status=fail] .cs-run-core{stroke:#ff704d}.cs-scene[data-status=fail] .cs-led--warm{fill:#ff4d4d}.cs-scene[data-status=warning] .cs-led--warm{fill:#ffd166}@media(prefers-reduced-motion:reduce){.cs-flow-dot{display:none}.cs-scene *{transition:none!important}}
</style>
