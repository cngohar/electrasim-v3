---
// MaxZsPanels.astro — Interactive panels for Max Zs Disconnection Time Calculator
import StandardSelector from './StandardSelector.astro';
---

<div class="tool-panels-container">
  <!-- Left Inputs Panel -->
  <section class="calc-panel input-panel" aria-label="Circuit Parameters">
    <div class="panel-header">
      <div class="panel-header-title">
        <svg class="panel-icon text-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>Protective Device & Circuit Path</span>
      </div>
      <div class="quick-presets-row">
        <button type="button" class="preset-chip" data-preset="b32">32A Type B (Sockets)</button>
        <button type="button" class="preset-chip" data-preset="b6">6A Type B (Lighting)</button>
        <button type="button" class="preset-chip" data-preset="c16">16A Type C (Motor)</button>
        <button type="button" class="preset-chip" data-preset="b40">40A Type B (Shower)</button>
      </div>
    </div>

    <form class="calc-form" id="max-zs-form" novalidate>
      <!-- Regional wiring standard (BS 7671 / IEC 60364) -->
      <StandardSelector inputId="zs-standard" noteId="zs-standard-note" />

      <!-- Protective Device Type & Rating -->
      <div class="form-row grid-2">
        <div class="form-group">
          <label for="zs-device-type">Protective Device</label>
          <select id="zs-device-type" name="deviceType" class="calc-select">
            <option value="mcb-b" selected>Type B MCB / RCBO (BS EN 60898)</option>
            <option value="mcb-c">Type C MCB / RCBO (10× In)</option>
            <option value="mcb-d">Type D MCB / RCBO (20× In)</option>
            <option value="bs88">BS 88-2 / BS 88-6 Cartridge Fuse</option>
            <option value="bs1361">BS 1361 Domestic Cartridge Fuse</option>
            <option value="rcd-30ma">30mA RCD / RCBO Residual Earth Protection</option>
          </select>
        </div>
        <div class="form-group">
          <label for="zs-rating">Device Rating In (Amps)</label>
          <select id="zs-rating" name="ratingAmps" class="calc-select">
            <option value="6">6 A</option>
            <option value="10">10 A</option>
            <option value="16">16 A</option>
            <option value="20">20 A</option>
            <option value="25">25 A</option>
            <option value="32" selected>32 A</option>
            <option value="40">40 A</option>
            <option value="50">50 A</option>
            <option value="63">63 A</option>
          </select>
        </div>
      </div>

      <!-- Earthing System & Ze -->
      <div class="form-row grid-2">
        <div class="form-group">
          <label for="zs-earthing">Earthing Arrangement</label>
          <select id="zs-earthing" name="earthing" class="calc-select">
            <option value="TN-C-S" selected>TN-C-S / PME (Typical Ze = 0.35 Ω)</option>
            <option value="TN-S">TN-S (Typical Ze = 0.80 Ω)</option>
            <option value="TT">TT Earth Electrode (21 Ω / RCD required)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="zs-ze">External Impedance Ze (Ω)</label>
          <input type="number" id="zs-ze" name="ze" value="0.35" step="0.01" min="0.01" max="100" class="calc-input" />
        </div>
      </div>

      <!-- Cable Conductor Cross-Sections -->
      <div class="form-row grid-2">
        <div class="form-group">
          <label for="zs-line-size">Line Conductor Size (mm²)</label>
          <select id="zs-line-size" name="lineSize" class="calc-select">
            <option value="1.0">1.0 mm²</option>
            <option value="1.5">1.5 mm²</option>
            <option value="2.5" selected>2.5 mm²</option>
            <option value="4.0">4.0 mm²</option>
            <option value="6.0">6.0 mm²</option>
            <option value="10.0">10.0 mm²</option>
            <option value="16.0">16.0 mm²</option>
            <option value="25.0">25.0 mm²</option>
          </select>
        </div>
        <div class="form-group">
          <label for="zs-cpc-size">Protective Conductor CPC (mm²)</label>
          <select id="zs-cpc-size" name="cpcSize" class="calc-select">
            <option value="1.0">1.0 mm²</option>
            <option value="1.5" selected>1.5 mm² (Standard for 2.5 T&E)</option>
            <option value="2.5">2.5 mm²</option>
            <option value="4.0">4.0 mm²</option>
            <option value="6.0">6.0 mm²</option>
            <option value="10.0">10.0 mm²</option>
            <option value="16.0">16.0 mm²</option>
          </select>
        </div>
      </div>

      <!-- Run Length & Temp Check -->
      <div class="form-row grid-2">
        <div class="form-group">
          <label for="zs-length">One-Way Cable Run Length (m)</label>
          <input type="number" id="zs-length" name="length" value="22" min="1" max="500" class="calc-input" />
        </div>
        <div class="form-group checkbox-group">
          <label class="checkbox-label" for="zs-temp-adj">
            <input type="checkbox" id="zs-temp-adj" name="tempAdjusted" checked class="calc-checkbox" />
            <span>Apply 70°C Operating Temperature Multiplier (1.20×)</span>
          </label>
        </div>
      </div>
    </form>
  </section>

  <!-- Right Results Panel -->
  <section class="calc-panel result-panel" aria-label="Disconnection Results">
    <div class="panel-header">
      <div class="panel-header-title">
        <svg class="panel-icon text-emerald" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 14 14"></polyline>
        </svg>
        <span>Loop Impedance & Disconnection Verification</span>
      </div>
      <div class="status-badge-pill" id="zs-status-badge">Compliant</div>
    </div>

    <!-- Main Zs Hero Card -->
    <div class="hero-zs-card" id="zs-hero-card">
      <div class="hero-zs-label">CALCULATED LOOP IMPEDANCE (Zs = Ze + R1 + R2)</div>
      <div class="hero-zs-val">
        <span id="zs-out-zs">0.87</span> <span class="unit">Ω</span>
      </div>
      <div class="hero-sub-val">
        Statutory Maximum Limit (0.4s): <strong id="zs-out-max">1.37 Ω</strong>
      </div>
    </div>

    <!-- Metrics Grid -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-label" id="zs-label-cold">Cold 80% Rule Limit (GN3)</div>
        <div class="metric-value" id="zs-out-cold">1.10 Ω</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Supply External Ze</div>
        <div class="metric-value" id="zs-out-ze">0.35 Ω</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Conductor R1 + R2</div>
        <div class="metric-value" id="zs-out-r1r2">0.52 Ω</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Disconnection Time</div>
        <div class="metric-value" id="zs-out-time">≤ 0.4 s</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Required Trip Current (Ia)</div>
        <div class="metric-value" id="zs-out-ia">160 A</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Prospective Fault (PFC)</div>
        <div class="metric-value" id="zs-out-pfc">251 A</div>
      </div>
    </div>

    <!-- Loop Impedance Bar Graphic -->
    <div class="zs-bar-container">
      <div class="zs-bar-header">
        <span>Compliance Margin Indicator</span>
        <span id="zs-margin-text">36% Margin to Ceiling</span>
      </div>
      <div class="zs-bar-track">
        <div class="zs-bar-fill" id="zs-bar-fill" style="width: 63%;"></div>
        <div class="zs-bar-marker cold-marker" id="zs-cold-marker" title="80% Cold Testing Threshold" style="left: 80%;"></div>
        <div class="zs-bar-marker limit-marker" title="100% Maximum Zs Limit" style="left: 100%;"></div>
      </div>
      <div class="zs-bar-labels">
        <span>0 Ω</span>
        <span id="zs-bar-cold-label">80% Cold Limit</span>
        <span>Max Zs (100%)</span>
      </div>
    </div>

    <!-- Summary Notice Box -->
    <div class="compliance-summary-box" id="zs-summary-box">
      <div class="summary-text" id="zs-summary-text">
        Compliant: Zs of 0.87 Ω is well below the statutory maximum 1.37 Ω limit. Circuit will safely disconnect within 0.4s during an earth fault.
      </div>
      <p class="standard-result-echo" id="zs-standard-echo">
        Result verified against <strong>BS 7671:2018+A4:2026 (UK)</strong> — Tables 41.2–41.4 with the IET GN3 80% ambient-test rule.
      </p>
    </div>
  </section>
</div>

<style>
  .standard-result-echo {
    margin: 0.6rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.45;
    color: #475569;
    border-top: 1px dashed rgba(100, 116, 139, 0.35);
    padding-top: 0.55rem;
  }
  .standard-result-echo strong {
    color: #1e293b;
    white-space: nowrap;
  }
  :root[data-theme='dark'] .standard-result-echo {
    color: #94a3b8;
  }
  :root[data-theme='dark'] .standard-result-echo strong {
    color: #e2e8f0;
  }
  .tool-panels-container {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.5rem;
    max-width: 1240px;
    margin: 2rem auto;
    padding: 0 1.5rem;
  }
  .calc-panel {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 1.25rem;
    padding: 1.75rem;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05);
  }
  :root[data-theme="dark"] .calc-panel {
    background: #0f172a;
    border-color: #1e293b;
  }
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border, #e2e8f0);
    padding-bottom: 1rem;
  }
  :root[data-theme="dark"] .panel-header {
    border-color: #1e293b;
  }
  .panel-header-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }
  .panel-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
  .panel-icon.text-shield {
    color: var(--blue, #2563eb);
  }
  .panel-icon.text-emerald {
    color: #10b981;
  }
  .quick-presets-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .preset-chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--bg-2, #f8fafc);
    border: 1px solid var(--border, #cbd5e1);
    color: var(--text-mid, #64748b);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .preset-chip:hover {
    background: var(--blue-l, #eff6ff);
    border-color: var(--blue, #2563eb);
    color: var(--blue, #2563eb);
  }
  :root[data-theme="dark"] .preset-chip {
    background: #1e293b;
    border-color: #334155;
    color: #94a3b8;
  }
  .form-row {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .grid-2 {
    grid-template-columns: 1fr 1fr;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-group.checkbox-group {
    justify-content: center;
  }
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
  }
  .calc-checkbox {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--blue, #2563eb);
  }
  .form-group label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-mid, #64748b);
  }
  .calc-input, .calc-select {
    padding: 0.65rem 0.85rem;
    border-radius: 0.65rem;
    border: 1px solid var(--border, #cbd5e1);
    background: var(--bg, #ffffff);
    color: var(--text, #0f172a);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 600;
  }
  :root[data-theme="dark"] .calc-input,
  :root[data-theme="dark"] .calc-select {
    background: #090e17;
    border-color: #334155;
    color: #f1f5f9;
  }
  /* Hero Zs Card */
  .hero-zs-card {
    background: linear-gradient(135deg, #065f46 0%, #10b981 100%);
    color: #ffffff;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.25rem;
    box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.3);
  }
  .hero-zs-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #a7f3d0;
    margin-bottom: 0.25rem;
  }
  .hero-zs-val {
    font-family: var(--font-display);
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1;
  }
  .hero-zs-val .unit {
    font-size: 1.5rem;
    font-weight: 600;
    color: #d1fae5;
  }
  .hero-sub-val {
    font-size: 0.85rem;
    color: #ecfdf5;
    margin-top: 0.5rem;
  }
  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .metric-card {
    background: var(--bg-2, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 0.75rem;
    padding: 0.75rem;
    text-align: center;
  }
  :root[data-theme="dark"] .metric-card {
    background: #1e293b;
    border-color: #334155;
  }
  .metric-label {
    font-size: 0.7rem;
    color: var(--text-mid, #64748b);
    margin-bottom: 0.2rem;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text, #0f172a);
  }
  /* Bar Graphic */
  .zs-bar-container {
    background: var(--bg-2, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 0.85rem;
    padding: 1rem;
    margin-bottom: 1.25rem;
  }
  :root[data-theme="dark"] .zs-bar-container {
    background: #1e293b;
    border-color: #334155;
  }
  .zs-bar-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-mid);
    margin-bottom: 0.4rem;
  }
  .zs-bar-track {
    position: relative;
    height: 0.75rem;
    background: var(--border, #cbd5e1);
    border-radius: 999px;
    overflow: visible;
  }
  :root[data-theme="dark"] .zs-bar-track {
    background: #334155;
  }
  .zs-bar-fill {
    height: 100%;
    background: #10b981;
    border-radius: 999px;
    transition: width 0.25s ease;
  }
  .zs-bar-marker {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background: #f59e0b;
  }
  .zs-bar-marker.limit-marker {
    background: #ef4444;
  }
  .zs-bar-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--text-dim, #94a3b8);
    margin-top: 0.35rem;
  }
  /* Compliance Summary Box */
  .compliance-summary-box {
    border-radius: 0.85rem;
    padding: 1rem;
    font-size: 0.88rem;
    line-height: 1.5;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #065f46;
  }
  :root[data-theme="dark"] .compliance-summary-box {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
  }
  .status-badge-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: #10b981;
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .tool-panels-container {
      grid-template-columns: 1fr;
    }
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
