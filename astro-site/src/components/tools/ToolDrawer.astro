---
import type { ToolEntry } from '../../lib/tools/registry';
import { TOOLBOX_REGISTRY } from '../../lib/tools/registry';
import EmojiIcon from '../EmojiIcon.astro';

interface Props {
  currentTool: ToolEntry;
}

const { currentTool } = Astro.props;
---

<div id="tool-drawer-backdrop" class="tool-drawer-backdrop" hidden></div>

<aside
  id="tool-drawer-menu"
  class="tool-drawer-aside"
  role="dialog"
  aria-label="Electrical Toolbox Navigation"
  aria-modal="true"
  hidden
>
  <div class="drawer-header">
    <div class="drawer-brand">
      <span class="drawer-logo-icon"><EmojiIcon name="bolt" /></span>
      <div>
        <div class="drawer-title">Electrical Toolbox</div>
        <div class="drawer-sub">ElectraSim Suite</div>
      </div>
    </div>
    <button type="button" id="tool-drawer-close" class="btn-drawer-close" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <div class="drawer-search-wrap">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drawer-search-icon">
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input
      type="text"
      id="tool-drawer-search"
      class="drawer-search-input"
      placeholder="Search tools & commands..."
      aria-label="Search tools"
    />
  </div>

  <div class="drawer-scroll-body nice-scroll">
    <div class="drawer-section-title">CALCULATORS</div>
    <div class="drawer-items-list" id="drawer-tools-list">
      {TOOLBOX_REGISTRY.map((tool) => (
        <a
          href={tool.status === 'available' ? tool.route : '/tools/'}
          class={`drawer-item ${tool.id === currentTool.id ? 'active' : ''} ${tool.status !== 'available' ? 'disabled' : ''}`}
          data-tool-id={tool.id}
          data-tool-name={tool.name.toLowerCase()}
        >
          <div class="drawer-item-content">
            <span class="drawer-item-status" aria-hidden="true">
              {tool.id === currentTool.id ? '✓' : '•'}
            </span>
            <div>
              <div class="drawer-item-title">{tool.name}</div>
              <div class="drawer-item-desc">{tool.shortName}</div>
            </div>
          </div>
          {tool.status !== 'available' && <span class="drawer-tag">Coming Soon</span>}
        </a>
      ))}
    </div>

    <div class="drawer-section-title">COMMANDS</div>
    <div class="drawer-items-list" id="drawer-commands-list">
      <a href="/tools/" class="drawer-item cmd-item" data-cmd="home">
        <div class="drawer-item-content">
          <span class="drawer-item-icon"><EmojiIcon name="home" /></span>
          <div class="drawer-item-title">Toolbox Home</div>
        </div>
      </a>
      <a href="/app/" class="drawer-item cmd-item" data-cmd="app">
        <div class="drawer-item-content">
          <span class="drawer-item-icon"><EmojiIcon name="bolt" /></span>
          <div class="drawer-item-title">Launch Interactive Wiring Lab</div>
        </div>
      </a>
      <button type="button" class="drawer-item cmd-item drawer-btn-item" id="drawer-cmd-reset" data-cmd="reset">
        <div class="drawer-item-content">
          <span class="drawer-item-icon">↺</span>
          <div class="drawer-item-title">Reset Current Tool</div>
        </div>
      </button>
      <button type="button" class="drawer-item cmd-item drawer-btn-item" id="drawer-cmd-help" data-cmd="help">
        <div class="drawer-item-content">
          <span class="drawer-item-icon"><EmojiIcon name="question" /></span>
          <div class="drawer-item-title">{`How ${currentTool.shortName} Works`}</div>
        </div>
      </button>
      <button type="button" class="drawer-item cmd-item drawer-btn-item" id="drawer-cmd-theme" data-cmd="theme">
        <div class="drawer-item-content">
          <span class="drawer-item-icon"><EmojiIcon name="contrast" /></span>
          <div class="drawer-item-title">Toggle Appearance</div>
        </div>
      </button>
    </div>

    <div class="drawer-section-title">SITE</div>
    <div class="drawer-items-list" id="drawer-site-list">
      <a href="/updates/" class="drawer-item cmd-item" data-cmd="updates">
        <div class="drawer-item-content">
          <span class="drawer-item-icon"><EmojiIcon name="box" /></span>
          <div class="drawer-item-title">Product Updates &amp; Release Notes</div>
        </div>
      </a>
      <a href="/blog/" class="drawer-item cmd-item" data-cmd="blog">
        <div class="drawer-item-content">
          <span class="drawer-item-icon"><EmojiIcon name="book" /></span>
          <div class="drawer-item-title">Learning Library (Blog)</div>
        </div>
      </a>
      <a href="/guide/" class="drawer-item cmd-item" data-cmd="guide">
        <div class="drawer-item-content">
          <span class="drawer-item-icon"><EmojiIcon name="ruler" /></span>
          <div class="drawer-item-title">Guided Circuit Tutorials</div>
        </div>
      </a>
    </div>
  </div>

  <div class="drawer-footer">
    <div class="drawer-shortcut-hint">
      <span>Command Palette</span>
      <kbd class="kbd-hint">⇧ Space</kbd>
    </div>
  </div>
</aside>

<style>
  .tool-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 60;
    transition: opacity 0.2s ease;
  }
  .tool-drawer-backdrop[hidden] {
    display: none;
  }
  .tool-drawer-aside {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 320px;
    max-width: 85vw;
    background: var(--surface-glass, #ffffff);
    border-right: 1px solid var(--border);
    box-shadow: 12px 0 36px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    z-index: 70;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: drawerSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .tool-drawer-aside[hidden] {
    display: none;
  }
  @keyframes drawerSlide {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .drawer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .drawer-logo-icon {
    font-size: 1.25rem;
    color: var(--blue);
  }
  .drawer-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
  }
  .drawer-sub {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
  }
  .btn-drawer-close {
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    border: none;
    background: transparent;
    color: var(--text-mid);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .btn-drawer-close:hover {
    background: var(--bg-2);
    color: var(--text);
  }
  .drawer-search-wrap {
    position: relative;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .drawer-search-icon {
    position: absolute;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    pointer-events: none;
  }
  .drawer-search-input {
    width: 100%;
    height: 2.35rem;
    padding-left: 2.25rem;
    padding-right: 0.75rem;
    border-radius: 0.55rem;
    border: 1px solid var(--border);
    background: var(--bg-2);
    color: var(--text);
    font-size: 0.85rem;
    outline: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .drawer-search-input:focus {
    border-color: var(--blue);
    background: var(--bg-card);
  }
  .drawer-scroll-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0.75rem;
  }
  .drawer-section-title {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    padding: 0.5rem 0.75rem 0.35rem;
  }
  .drawer-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }
  .drawer-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.75rem;
    border-radius: 0.55rem;
    text-decoration: none;
    color: var(--text);
    transition: background 0.12s ease;
  }
  .drawer-item:hover {
    background: var(--bg-2);
  }
  .drawer-item.active {
    background: var(--blue-l);
    color: var(--blue);
    font-weight: 700;
  }
  .drawer-item.disabled {
    opacity: 0.65;
  }
  .drawer-btn-item {
    width: 100%;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
  }
  .drawer-item-content {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .drawer-item-status {
    width: 1rem;
    font-weight: 800;
    color: var(--blue);
  }
  .drawer-item-icon {
    font-size: 1.05rem;
    width: 1.25rem;
    text-align: center;
  }
  .drawer-item-title {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .drawer-item-desc {
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .drawer-tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--bg-3);
    color: var(--text-dim);
  }
  .drawer-footer {
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--bg-2);
  }
  .drawer-shortcut-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--text-mid);
    font-weight: 600;
  }
</style>
