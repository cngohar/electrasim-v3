# ─── App shell — allow service worker and web worker ─────────────────────────
/app/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Content-hashed build assets are immutable. HTML and the service worker must revalidate.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/app/workbox-*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ─── Generated per-post OG cards — content-hash versioned via ?v=─────────────
# URLs carry ?v=<sha256-prefix> (see astro-site/src/og-manifest.ts), so HTML
# always references the newest card while the CDN/browser can cache forever.
/og/blog/*
  Cache-Control: public, max-age=31536000, immutable

# Site-wide default social card (versionless shared file)
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Self-hosted font files (stable, small set)
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

# Versionless marketing assets revalidate regularly while remaining fast on repeat visits.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/app/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/app/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# ─── Admin panel — relaxed for Sveltia CMS (unpkg CDN + GitHub API) ──────────
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://api.github.com https://github.com data: blob:; img-src 'self' https: data: blob:; connect-src 'self' https://api.github.com https://github.com https://unpkg.com https://cdn.jsdelivr.net; frame-src https://github.com; font-src 'self' https: data:

# ─── Admin config — prevent caching + correct MIME type ──────────────────────
/admin/config.yml
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: text/yaml; charset=utf-8
