{
  "name": "electrasim",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["astro-site", "packages/domain", "packages/access"],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --strictPort --host=0.0.0.0",
    "dev:marketing": "bun run --cwd astro-site dev",
    "dev:worker": "wrangler dev --local --port 8791 --ip 127.0.0.1 --persist-to .wrangler/state",
    "build": "vite build && bun run build:astro && bun scripts/postbuild.mjs",
    "build:astro": "bun run --cwd astro-site build",
    "build:stats": "BUILD_STATS=1 vite build && bun run build:astro && bun scripts/postbuild.mjs",
    "benchmark:simulation": "bun scripts/benchmark-simulation.ts",
    "benchmark:mna": "bun scripts/benchmark-mna.ts",
    "stress:generator": "bun scripts/stress-challenge-generator.ts",
    "stress:diagnosis": "bun scripts/stress-diagnosis.ts",
    "stress:ohmageddon": "bun scripts/stress-ohmageddon.ts",
    "benchmark:browser": "PERF=1 bun x playwright test e2e/performance.spec.ts --project=chromium",
    "check:perf": "bun scripts/check-performance.mjs",
    "check:links": "bun scripts/check-internal-links.mjs",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state",
    "verify": "bun run check && bun run build && bun run check:perf && bun run check:links && bun run check:seo && bun run check:csp && bun run benchmark:simulation && bun run benchmark:browser && bun run e2e && bun run e2e:production && bun run test:membership",
    "deploy": "bun scripts/deployment-disabled.mjs",
    "seed:standards": "bun scripts/seed-standards.ts",
    "clean": "rm -rf dist coverage playwright-report test-results .wrangler",
    "typecheck": "bun scripts/check-domain-boundaries.ts && bun x tsc --noEmit -p packages/domain/tsconfig.json && bun x tsc --noEmit -p packages/domain/tsconfig.core.json && bun x tsc --noEmit -p packages/access/tsconfig.json && bun x tsc --noEmit && bun x tsc --noEmit -p tsconfig.e2e.json && bun x tsc --noEmit -p astro-site/tsconfig.json && bun x tsc --noEmit -p tsconfig.membership-tests.json",
    "lint": "bun x biome lint .",
    "lint:fix": "bun x biome check --write .",
    "format": "bun x biome format --write .",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "test:coverage": "bun x vitest run --coverage",
    "test:ui": "bun x vitest --ui",
    "e2e": "bun x playwright test",
    "e2e:production": "bun x playwright test --config=playwright.production.config.ts",
    "e2e:install": "bun x playwright install --with-deps",
    "e2e:ui": "bun x playwright test --ui",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepare": "bun x lefthook install || echo '(skipped: no .git yet — run \"git init && bun run prepare\" later)'",
    "check:seo": "bun scripts/check-seo.mjs",
    "check:csp": "bun scripts/check-csp.mjs",
    "bootstrap:super-admin": "bun scripts/bootstrap-super-admin.ts",
    "test:membership": "bun scripts/test-membership.ts",
    "test:simulator": "SIMULATOR_ONLY=1 bun scripts/test-membership.ts",
    "verify:phase-1.5a": "bun scripts/verify-phase15a.mjs",
    "verify:phase-1.5b": "bun scripts/verify-phase15b.mjs",
    "verify:phase-1.5c0": "bun scripts/verify-phase15c0.mjs",
    "verify:phase-1.5c1": "bun scripts/verify-phase15c1.mjs",
    "verify:phase-1.5c2": "bun scripts/verify-phase15c2.mjs",
    "verify:phase-1.5c3": "bun scripts/verify-phase15c3.mjs",
    "verify:phase-1.5c4": "bun scripts/verify-phase15c4.mjs",
    "verify:phase-1.5c5": "bun scripts/verify-phase15c5.mjs",
    "verify:phase-1.5d0": "bun scripts/verify-phase15d0.mjs",
    "verify:phase-1.5d1": "bun scripts/verify-phase15d1.mjs",
    "verify:phase-1.5d2": "bun scripts/verify-phase15d2.mjs",
    "test:domain-local": "bun scripts/test-domain-local.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "better-auth": "^1.7.6",
    "comlink": "^4.4.2",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "idb-keyval": "^6.2.2",
    "immer": "^11.1.18",
    "lucide-react": "^0.546.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-window": "^7.4.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12",
    "@electrasim/domain": "workspace:*",
    "@electrasim/access": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^25.0.1",
    "lefthook": "^1.7.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  }
}
