{
  "name": "electrasim",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "workspaces": ["astro-site"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --strictPort --host=0.0.0.0",
    "dev:marketing": "npm run dev --workspace astro-site",
    "build": "vite build && npm run build:astro && node scripts/postbuild.mjs",
    "build:astro": "npm run build --workspace astro-site",
    "build:stats": "BUILD_STATS=1 vite build && npm run build:astro && node scripts/postbuild.mjs",
    "benchmark:simulation": "node --import tsx scripts/benchmark-simulation.ts",
    "stress:generator": "node --import tsx scripts/stress-challenge-generator.ts",
    "stress:diagnosis": "node --import tsx scripts/stress-diagnosis.ts",
    "stress:ohmageddon": "node --import tsx scripts/stress-ohmageddon.ts",
    "benchmark:browser": "PERF=1 playwright test e2e/performance.spec.ts --project=chromium",
    "check:perf": "node scripts/check-performance.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "preview": "wrangler pages dev dist --ip 127.0.0.1 --port 8788 --no-bundle",
    "verify": "npm run check && npm run build && npm run check:perf && npm run check:links && npm run benchmark:simulation && npm run benchmark:browser && npm run e2e && npm run e2e:production",
    "deploy": "npm run verify && wrangler pages deploy dist/ --project-name=electrasim",
    "clean": "rm -rf dist coverage playwright-report test-results",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json && npm run typecheck --workspace astro-site",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:production": "playwright test --config=playwright.production.config.ts",
    "e2e:install": "playwright install --with-deps",
    "e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "lefthook install || echo '(skipped: no .git yet — run \"git init && npm run prepare\" later)'"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "comlink": "^4.4.2",
    "idb-keyval": "^6.2.2",
    "immer": "^11.1.4",
    "lucide-react": "^0.546.0",
    "motion": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "workbox-window": "^7.4.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^25.0.1",
    "lefthook": "^1.7.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.112.0"
  }
}
