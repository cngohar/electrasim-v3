{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "electrasim-platform-browser-local",
  "main": "scripts/platform-admin-test.worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "platform-browser-test",
      "database_id": "local-platform-browser-test",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENV": "local"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/u/*"]
  }
}
