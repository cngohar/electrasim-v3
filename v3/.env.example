NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_VERSION=0.0.0-dev
TRUSTED_PROXY_HOPS=1

# Local development uses private disk storage. Production requires mode=s3 and an
# S3-compatible managed provider; Cloudflare R2 is not assumed by the architecture.
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_LOCAL_PATH=.data/objects
# S3_ENDPOINT=https://objects.example.com
# S3_BUCKET=electrasim-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Identity is disabled when all settings below are absent. Production must use
# distinct least-privilege role URLs even when they point to one PostgreSQL service.
AUTH_DATABASE_URL=postgres://electrasim_auth:change-me@localhost:5432/electrasim
APPLICATION_DATABASE_URL=postgres://electrasim_app:change-me@localhost:5432/electrasim
WORKER_DATABASE_URL=postgres://electrasim_worker:change-me@localhost:5432/electrasim
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SAFETY_TERMS_VERSION=2026-09
# Use capture locally to expose messages at /api/dev/emails. Production requires resend.
EMAIL_DELIVERY_MODE=capture
EMAIL_FROM=ElectraSim <account@example.com>
# RESEND_API_KEY=re_replace-me

# Optional launch social providers; each ID/secret pair is all-or-nothing.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
