{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "electrasim-component-access-test-local",
  "main": "scripts/component-access-test.worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "component-access-test",
      "database_id": "local-component-access-test",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "ENV": "local" }
}
