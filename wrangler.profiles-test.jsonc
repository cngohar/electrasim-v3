{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "electrasim-profiles-test-local",
  "main": "scripts/profiles-test.worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "profiles-test",
      "database_id": "local-profiles-test",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "profiles-test-avatars", "remote": false }],
  "vars": { "ENV": "local" }
}
